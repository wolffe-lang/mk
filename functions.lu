//! functions.lu — gmake's text functions: $(name arg1,arg2,…).
//!
//! A function reference's first word is the name; the rest, after the
//! whitespace that follows the name, is the argument text. Arguments are
//! split on commas at parenthesis/brace depth zero, into at most `max`
//! pieces: the last piece keeps any further commas (gmake's rule for
//! fixed-arity functions).

use std.env
use std.fs

/// The functions whose arguments are expanded only when needed (P2.3):
/// the raw inside's first word, when it is one of them and whitespace
/// follows; "" otherwise.
fn lazy_function_name(inside: str) -> str {
    var i = 0
    while i < inside.len && inside[i..i + 1] != " " && inside[i..i + 1] != "\t" {
        i = i + 1
    }
    if i == inside.len {
        return ""
    }
    let name = inside[0..i]
    if name == "if" || name == "or" || name == "and" {
        return name
    }
    ""
}

/// The text functions implemented so far (P2.1b).
fn is_text_function(name: str) -> bool {
    if name == "subst" || name == "strip" || name == "findstring" {
        return true
    }
    if name == "words" || name == "firstword" || name == "lastword" {
        return true
    }
    if name == "dir" || name == "notdir" || name == "suffix" || name == "basename" {
        return true
    }
    if name == "addsuffix" || name == "addprefix" || name == "join" || name == "abspath" {
        return true
    }
    if name == "wildcard" || name == "realpath" {
        return true
    }
    if name == "patsubst" ||
        name == "filter" ||
        name == "filter-out" ||
        name == "sort" ||
        name == "word" ||
        name == "wordlist" {
        return true
    }
    false
}

/// The argument text of a function reference: everything after the name
/// and the whitespace that follows it.
fn function_args(inside: str) -> str {
    var i = 0
    while i < inside.len && inside[i..i + 1] != " " && inside[i..i + 1] != "\t" {
        i = i + 1
    }
    while i < inside.len && (inside[i..i + 1] == " " || inside[i..i + 1] == "\t") {
        i = i + 1
    }
    inside[i..]
}

/// Split `args` on commas at depth zero into at most `max` pieces.
fn split_args(args: str, max: int) -> List[str] {
    var pieces = List[str]()
    var depth = 0
    var start = 0
    var i = 0
    while i < args.len {
        let c = args[i..i + 1]
        if c == "(" || c == "{{" {
            depth = depth + 1
        } else if c == ")" || c == "}}" {
            depth = depth - 1
        } else if c == "," && depth == 0 && pieces.len < max - 1 {
            (mut pieces).push(args[start..i])
            start = i + 1
        }
        i = i + 1
    }
    (mut pieces).push(args[start..])
    pieces
}

/// The piece at `n`, or "" when there are fewer pieces.
fn arg_at(pieces: List[str], n: int) -> str {
    if n < pieces.len {
        return pieces[n]
    }
    ""
}

/// Replace every occurrence of `from` in `text` with `to` (gmake's subst).
fn replace_all(text: str, from: str, to: str) -> str {
    if from.len == 0 {
        return text
    }
    var result = ""
    var i = 0
    while i < text.len {
        if i + from.len <= text.len && text[i..i + from.len] == from {
            result = result + to
            i = i + from.len
        } else {
            result = result + text[i..i + 1]
            i = i + 1
        }
    }
    result
}

/// Join words with single spaces (gmake's strip).
fn join_words(words: List[str]) -> str {
    var result = ""
    var i = 0
    while i < words.len {
        if i > 0 {
            result = result + " "
        }
        result = result + words[i]
        i = i + 1
    }
    result
}

/// Evaluate a text function. `inside` is the whole expanded reference text
/// (name and arguments); `name` is its first word.
fn call_function(v: Vars, name: str, inside: str, visiting: str, line: int) -> str ! {
    Unterminated(int),
    Cycle(int, str),
    Refuse(int, str),
} {
    let args = function_args(inside)
    if name == "subst" {
        let p = split_args(args, 3)
        return replace_all(arg_at(p, 2), arg_at(p, 0), arg_at(p, 1))
    }
    if name == "strip" {
        return join_words(split_words(args))
    }
    if name == "findstring" {
        let p = split_args(args, 2)
        if arg_at(p, 1).contains(arg_at(p, 0)) {
            return arg_at(p, 0)
        }
        return ""
    }
    let words = split_words(args)
    if name == "words" {
        let n = words.len
        return "{n}"
    }
    if name == "firstword" {
        if words.len > 0 {
            return words[0]
        }
        return ""
    }
    if name == "lastword" {
        if words.len > 0 {
            return words[words.len - 1]
        }
        return ""
    }
    if name == "patsubst" {
        let p = split_args(args, 3)
        return apply_pattern_sub(arg_at(p, 2), arg_at(p, 0), arg_at(p, 1))
    }
    if name == "filter" || name == "filter-out" {
        let p = split_args(args, 2)
        return filter_words(split_words(arg_at(p, 0)), split_words(arg_at(p, 1)), name == "filter")
    }
    if name == "sort" {
        return join_words(sort_unique(split_words(args)))
    }
    if name == "word" {
        let p = split_args(args, 2)
        let n = word_index(arg_at(p, 0), "word", "first", line) else |e| match e {
            Refuse(l, m) => return Refuse(l, m),
        }
        let ws = split_words(arg_at(p, 1))
        if n <= ws.len {
            return ws[n - 1]
        }
        return ""
    }
    if name == "wordlist" {
        let p = split_args(args, 3)
        let s = word_index(arg_at(p, 0), "wordlist", "first", line) else |e| match e {
            Refuse(l, m) => return Refuse(l, m),
        }
        let e2 = word_index(arg_at(p, 1), "wordlist", "second", line) else |e| match e {
            Refuse(l, m) => return Refuse(l, m),
        }
        let ws = split_words(arg_at(p, 2))
        var out = List[str]()
        var k = s
        while k <= e2 && k <= ws.len {
            (mut out).push(ws[k - 1])
            k = k + 1
        }
        return join_words(out)
    }
    if name == "dir" || name == "notdir" || name == "suffix" || name == "basename" {
        return file_name_function(name, words)
    }
    if name == "addsuffix" || name == "addprefix" {
        let p = split_args(args, 2)
        return affix_words(name == "addsuffix", arg_at(p, 0), split_words(arg_at(p, 1)))
    }
    if name == "join" {
        let p = split_args(args, 2)
        return join_pairs(split_words(arg_at(p, 0)), split_words(arg_at(p, 1)))
    }
    if name == "wildcard" {
        return join_words(wildcard_words(words))
    }
    if name == "realpath" {
        let cwd = env.cwd() else ""
        var out = List[str]()
        for w in words {
            if fs.exists(w) {
                (mut out).push(absolute_path(cwd, w))
            }
        }
        return join_words(out)
    }
    if name == "abspath" {
        let cwd = env.cwd() else ""
        var out = List[str]()
        for w in words {
            (mut out).push(absolute_path(cwd, w))
        }
        return join_words(out)
    }
    Refuse(line, "functions are not supported")
}

/// One pattern against one word: `%` matches any text (possibly empty);
/// a pattern without `%` matches the word exactly (gmake's filter rule).
fn pattern_matches(word: str, pattern: str) -> bool {
    let pct = pattern.find("%") else -1
    if pct < 0 {
        return word == pattern
    }
    let prefix = pattern[0..pct]
    let suffix = pattern[pct + 1..]
    if word.len < prefix.len + suffix.len {
        return false
    }
    word.starts_with(prefix) && word.ends_with(suffix)
}

/// The words matching any pattern (keep = true) or matching none (filter-out).
fn filter_words(patterns: List[str], words: List[str], keep: bool) -> str {
    var kept = List[str]()
    for w in words {
        var hit = false
        for p in patterns {
            if pattern_matches(w, p) {
                hit = true
            }
        }
        if hit == keep {
            (mut kept).push(w)
        }
    }
    join_words(kept)
}

/// Sorted bytewise, duplicates removed (gmake's sort).
fn sort_unique(words: List[str]) -> List[str] {
    var out = List[str]()
    for w in words {
        var i = 0
        while i < out.len && out[i] < w {
            i = i + 1
        }
        if i < out.len && out[i] == w {
            continue
        }
        (mut out).insert(i, w)
    }
    out
}

/// A refusal whose message starts with "*** " is a gmake fatal line:
/// `FILE:LINE: *** MESSAGE.  Stop.` with no `mk:` prefix. Every other
/// refusal keeps mk's own shape, `PREFIXFILE:LINE: MESSAGE`.
fn refusal_text(prefix: str, file: str, line: int, msg: str) -> str {
    if msg.starts_with("*** ") {
        return "{file}:{line}: {msg}.  Stop."
    }
    "{prefix}{file}:{line}: {msg}"
}

/// A word index argument: the digits of `text` (whitespace trimmed) as a
/// number, or gmake's fatal message naming the argument as written.
fn word_index(text: str, fname: str, which: str, line: int) -> int ! {Refuse(int, str)} {
    let t = text.trim()
    if t.len == 0 {
        return Refuse(line, "*** invalid {which} argument to '{fname}' function: empty value")
    }
    var i = 0
    while i < t.len {
        let c = t[i..i + 1]
        if c < "0" || c > "9" {
            return Refuse(line, "*** invalid {which} argument to '{fname}' function: '{text}'")
        }
        i = i + 1
    }
    let n = t.to_int() else 0
    if n == 0 && fname == "word" {
        return Refuse(line, "*** first argument to 'word' function must be greater than 0")
    }
    if n == 0 {
        return Refuse(line, "*** invalid {which} argument to '{fname}' function: '{text}'")
    }
    n
}

/// The file-name functions, one word at a time (gmake's rules): `dir` is
/// everything through the last slash (`./` when there is none); `notdir`
/// is what follows the last slash (an empty piece stays, so gmake prints
/// `[ b]` for `$(notdir src/ b)`); `suffix` is the last `.`-suffix of the
/// last component and a word without one is dropped; `basename` is the
/// word without that suffix.
fn file_name_function(name: str, words: List[str]) -> str {
    var out = List[str]()
    for w in words {
        let slash = w.rfind("/") else -1
        let last = if slash >= 0 then w[slash + 1..] else w
        let dot = last.rfind(".") else -1
        if name == "dir" {
            (mut out).push(if slash >= 0 then w[0..slash + 1] else "./")
        } else if name == "notdir" {
            (mut out).push(last)
        } else if name == "suffix" {
            if dot >= 0 {
                (mut out).push(last[dot..])
            }
        } else if dot >= 0 {
            (mut out).push(w[0..w.len - (last.len - dot)])
        } else {
            (mut out).push(w)
        }
    }
    join_words(out)
}

/// `addsuffix`/`addprefix`: the affix on each word.
fn affix_words(suffix: bool, affix: str, words: List[str]) -> str {
    var out = List[str]()
    for w in words {
        (mut out).push(if suffix then w + affix else affix + w)
    }
    join_words(out)
}

/// `join`: the words of both lists concatenated pairwise; the longer
/// list's tail passes through (`$(join a b,c)` is `ac b`).
fn join_pairs(a: List[str], b: List[str]) -> str {
    var out = List[str]()
    var i = 0
    while i < a.len || i < b.len {
        let x = if i < a.len then a[i] else ""
        let y = if i < b.len then b[i] else ""
        (mut out).push(x + y)
        i = i + 1
    }
    join_words(out)
}

/// `abspath`: the word made absolute against the current directory, `.`
/// and empty components dropped, `..` taken (clamped at the root), no
/// trailing slash; the file need not exist (gmake's rule).
fn absolute_path(cwd: str, w: str) -> str {
    let full = if w.starts_with("/") then w else cwd + "/" + w
    var parts = List[str]()
    for piece in full.split("/") {
        if piece == "" || piece == "." {
            continue
        }
        if piece == ".." {
            if parts.len > 0 {
                let n = parts.len - 1
                (mut parts).truncate(n)
            }
            continue
        }
        (mut parts).push(piece)
    }
    if parts.len == 0 {
        return "/"
    }
    var s = ""
    for p in parts {
        s = s + "/" + p
    }
    s
}

/// `wildcard`: each pattern's matches in sorted order, each written with
/// the pattern's own directory prefix (`./*.c` gives `./a.c`, `*.c` gives
/// `a.c`); a pattern without `*` or `?` is kept only if it exists.
fn wildcard_words(patterns: List[str]) -> List[str] {
    var out = List[str]()
    for pat in patterns {
        let slash = pat.rfind("/") else -1
        let prefix = if slash >= 0 then pat[0..slash + 1] else ""
        if pat.contains("*") || pat.contains("?") {
            for m in glob(pat) {
                let cut = m.rfind("/") else -1
                (mut out).push(prefix + m[cut + 1..])
            }
        } else if fs.exists(pat) {
            (mut out).push(pat)
        }
    }
    out
}

/// `if`, `or`, `and` over the RAW argument text: `if` expands its
/// condition (non-empty after whitespace is stripped) and then only the
/// chosen branch; `or` expands its arguments in order and answers the
/// first non-empty one; `and` answers the last if none is empty, else "".
fn call_lazy_function(v: Vars, name: str, inside: str, visiting: str, line: int) -> str ! {
    Unterminated(int),
    Cycle(int, str),
    Refuse(int, str),
} {
    let args = function_args(inside)
    if name == "if" {
        let p = split_args(args, 3)
        let cond = expand_inner(v, arg_at(p, 0), visiting, line)?
        let branch = if join_words(split_words(cond)).len > 0 then arg_at(p, 1) else arg_at(p, 2)
        return expand_inner(v, branch, visiting, line)?
    }
    let p = split_args(args, 64)
    var last = ""
    for piece in p {
        let value = expand_inner(v, piece, visiting, line)?
        if name == "or" {
            if value.len > 0 {
                return value
            }
        } else if value.len == 0 {
            return ""
        }
        last = value
    }
    if name == "or" {
        return ""
    }
    last
}
