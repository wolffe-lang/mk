//! vars.lu — variable table, setters, automatic variables.
//!
//! Variables: NAME = value (recursive), NAME := value (immediate),
//! NAME ?= value (set if unset), NAME += value (append).
//! Expansion is handled by expand.lu (recursive-descent expander).
//! Automatic variables: $@ $< $^ $?.
//!
//! **Expansion timing:** `:=` expands its right-hand side IMMEDIATELY when
//! the assignment is encountered. `=` defers expansion until the variable is
//! used (recursive expansion). `?=` and `+=` follow the same rule as their
//! base flavour: `X ?= val` stores `val` unexpanded if `X` is unset;
//! `X += val` appends ` val` to the existing value, expanding if the existing
//! value was `:=`-style.
//!
//! **`+=` behaviour:** Appends ` value` to the existing value. The resulting
//! flavour is `=` (recursive) regardless of the original flavour, matching
//! GNU make's behaviour.

use std.str
use std.env
use std.map

/// A variable with its value, flavour, and the line it was defined on.
struct Var {
    value: str,
    flavour: str,
    line: int,
    exported: bool,
}

/// The variable table.
struct Vars {
    table: Map[str, Var],
    // Whether bare `export` was seen (export all variables)
    export_all: bool,
    // Names that were explicitly unexported
    unexported: List[str],
}

/// Create a new empty variable table.
fn new_vars() -> Vars {
    Vars {
        table: Map[str, Var](),
        export_all: false,
        unexported: List[str](),
    }
}

/// Set a variable with a given flavour.
/// If `skip_if_set` is true and the name is already in the table, the assignment is a no-op.
/// This is used for command-line overrides: a Makefile assignment to a command-line name
/// is ignored, so the command-line value wins even for `:=` assignments.
fn set_var_impl(mut v: Vars, name: str, value: str, flavour: str, line: int, skip_if_set: bool) {
    if skip_if_set && map.has(v.table, name) {
        // This name was set from the command line; ignore the Makefile assignment
        return
    }
    if flavour == "?=" {
        if !map.has(v.table, name) {
            map.set(mut v.
                table, name, Var { value: value, flavour: flavour, line: line, exported: false })
        }
    } else if flavour == "+=" {
        if map.has(v.table, name) {
            let existing = var_value(v, name)
            let existing_flavour = var_flavour(v, name)
            let existing_exported = var_exported(v, name)
            // += keeps the flavour: append to := expands the value, append to = stores text
            let new_value = if existing_flavour == ":=" {
                // Append to immediate: expand the new value and append
                let expanded = expand(v, value, line) else |e| match e {
                    unterminated(l) => value,
                    cycle(l, n) => value,
                }
                existing + " " + expanded
            } else {
                // Append to recursive: store the text
                existing + " " + value
            }
            map.set(mut v.table, name, Var {
                value: new_value,
                flavour: existing_flavour,
                line: line,
                exported: existing_exported,
            })
        } else {
            map.set(mut v.
                table, name, Var { value: value, flavour: "=", line: line, exported: false })
        }
    } else if flavour == ":=" {
        // := expands immediately
        let expanded = expand(v, value, line) else |e| match e {
            unterminated(l) => value,
            cycle(l, n) => value,
        }
        map.set(mut v.
            table, name, Var { value: expanded, flavour: flavour, line: line, exported: false })
    } else {
        map.set(mut v.
            table, name, Var { value: value, flavour: flavour, line: line, exported: false })
    }
}

/// Set a variable with a given flavour (skip_if_set = false).
fn set_var(mut v: Vars, name: str, value: str, flavour: str, line: int) {
    set_var_impl(mut v, name, value, flavour, line, false)
}

/// Set a variable with a given flavour, skipping if already set.
fn set_var_skip(mut v: Vars, name: str, value: str, flavour: str, line: int) {
    set_var_impl(mut v, name, value, flavour, line, true)
}

/// Remove a variable (undefine).
fn undefine_var(mut v: Vars, name: str) {
    map.remove(mut v.table, name)
}

/// Get a variable's value, or empty string if not found.
/// Also checks the environment for variables not in the table.
fn var_value(v: Vars, name: str) -> str {
    let val = map.get(v.table, name) else {
        // Check environment
        let env_val = env.get(name) else ""
        return env_val
    }
    return val.value
}

/// Get the line number of a variable, or 0 if not found.
fn var_line_of(v: Vars, name: str) -> int {
    let val = map.get(v.table, name) else {
        return 0
    }
    return val.line
}

/// Get the flavour of a variable, or empty string if not found.
fn var_flavour(v: Vars, name: str) -> str {
    let val = map.get(v.table, name) else {
        return ""
    }
    return val.flavour
}

/// Get the exported flag of a variable, or false if not found.
fn var_exported(v: Vars, name: str) -> bool {
    let val = map.get(v.table, name) else {
        return false
    }
    return val.exported
}

/// Set the exported flag of a variable.
fn set_var_exported(mut v: Vars, name: str, exported: bool) {
    let val = map.get(v.table, name) else {
        // Variable doesn't exist; create it with the exported flag
        map.set(mut v.table, name, Var { value: "", flavour: "=", line: 0, exported: exported })
        return
    }
    map.set(mut v.table, name, Var {
        value: val.value,
        flavour: val.flavour,
        line: val.line,
        exported: exported,
    })
}

/// Expand automatic variables in a string.
fn expand_auto(
    s: str,
    target: str,
    first_prereq: str,
    all_prereqs: str,
    newer_prereqs: str,
) -> str {
    var result = s
    result = result.replace("$@", target)
    result = result.replace("$<", first_prereq)
    result = result.replace("$^", all_prereqs)
    result = result.replace("$?", newer_prereqs)
    return result
}

/// Give recipes the environment GNU make gives them: variables that came
/// from the environment (their current value), the exported ones, and
/// everything when `export` stands alone; an unexported name is removed.
fn export_environment(v: Vars) -> () ! {invalid} {
    // For each variable in the table, in definition order:
    // - if it is unexported by name (`unexport NAME`) → `env_unset(name)`
    // - else if `export` alone was seen, or the variable is marked exported,
    //   or its origin is the environment → `env_set(name, value)`
    for name in map.keys(v.table) {
        // Check if the name is in the unexported list
        var is_unexported = false
        for u in v.unexported {
            if u == name {
                is_unexported = true
                break
            }
        }
        if is_unexported {
            env_unset(name)
            continue
        }
        // Check if the variable should be exported
        let val = map.get(v.table, name) else {
            continue
        }
        // Export if: export_all is true, or the variable is marked exported,
        // or the variable came from the environment
        let in_env = env.get(name) else ""
        let should_export = v.export_all || val.exported || in_env.len > 0
        if should_export {
            // Expand the value (recursive variables expand now)
            let expanded = expand(v, val.value, val.line) else |e| match e {
                unterminated(l) => val.value,
                cycle(l, n) => val.value,
            }
            env_set(name, expanded)
        } else {
            // Unexported Makefile variable: remove from environment
            env_unset(name)
        }
    }
}
