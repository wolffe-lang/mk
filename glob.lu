//! glob.lu — glob pattern matching for include directives.
//!
//! Expands * and ? in a pattern to match files in the directory.
//! Returns a sorted list of matching paths.

use std.fs
use std.str

/// Expand a glob pattern to a list of matching file paths.
/// * matches any run of characters (except /).
/// ? matches any single character (except /).
/// Returns a sorted list of matching paths.
fn glob(pattern: str) -> List[str] {
    // Split the pattern into directory and filename parts
    let last_slash = pattern.rfind("/") else 0
    let (dir, name_pat) = if last_slash > 0 {
        (pattern[0..last_slash], pattern[last_slash + 1..])
    } else {
        (".", pattern)
    }

    // Check if the pattern contains any glob characters
    let has_glob = name_pat.contains("*") || name_pat.contains("?")
    if !has_glob {
        // No glob characters, return the pattern as-is
        var result = List[str]()
        (mut result).push(pattern)
        return result
    }

    // List the directory
    let entries = fs.read_dir(dir) else |e| {
        // Directory doesn't exist or can't be read
        return List[str]()
    }

    // Match each entry against the pattern
    var matches = List[str]()
    for entry in entries {
        if glob_match(name_pat, entry) {
            (mut matches).push(dir + "/" + entry)
        }
    }

    // Sort the matches
    var i = 1
    while i < matches.len {
        let key = matches[i]
        var j = i - 1
        while j >= 0 && matches[j] > key {
            matches[j + 1] = matches[j]
            j -= 1
        }
        matches[j + 1] = key
        i += 1
    }

    return matches
}

/// Match a glob pattern against a filename.
/// * matches any run of characters (except /).
/// ? matches any single character (except /).
fn glob_match(pattern: str, text: str) -> bool {
    var pi = 0
    var ti = 0
    var star_pi = -1
    var star_ti = -1

    while ti < text.len {
        if pi < pattern.len && pattern[pi..pi + 1] != "*" {
            // Non-star character
            if pattern[pi..pi + 1] == "?" {
                // ? matches any single character except /
                if text[ti..ti + 1] == "/" {
                    // ? doesn't match /
                    if star_pi < 0 {
                        return false
                    }
                    star_ti += 1
                    pi = star_pi
                    ti = star_ti
                } else {
                    pi += 1
                    ti += 1
                }
            } else if pattern[pi..pi + 1] == text[ti..ti + 1] {
                // Exact match
                pi += 1
                ti += 1
            } else {
                // Mismatch
                if star_pi < 0 {
                    return false
                }
                star_ti += 1
                pi = star_pi
                ti = star_ti
            }
        } else {
            // Star character
            if pi >= pattern.len {
                // Star at the end of the pattern
                break
            }
            star_pi = pi
            star_ti = ti
            pi += 1
            // If star is the last character, advance ti
            if star_pi >= pattern.len {
                ti += 1
            }
        }
    }

    // Skip any remaining stars in the pattern
    while pi < pattern.len && pattern[pi..pi + 1] == "*" {
        pi += 1
    }

    // Match succeeds if we've consumed the entire pattern
    return pi >= pattern.len
}
