//! mk_test.lu — unit tests for the parser and variable flavours.

fn parse_assignment_ok(line: str, n: int) -> Assignment {
    parse_assignment(line, n) else Assignment { name: "", op: "", value: "", line: 0 }
}

fn parse_rule_ok(line: str, n: int) -> Rule {
    parse_rule(line, n) else Rule {
        targets: List[str](),
        prereqs: List[str](),
        recipe: List[str](),
        first_recipe_line: 0,
        line: 0,
    }
}

fn parse_phony_ok(line: str, n: int) -> Phony {
    parse_phony(line, n) else Phony { names: List[str](), line: 0 }
}

fn parse_makefile_ok(text: str) -> Database {
    var v = new_vars()
    var cli_names = Map[str, int]()
    parse_makefile(text, "Makefile", mut v, cli_names) else Database {
        assignments: List[Assignment](),
        rules: List[Rule](),
        phonies: List[Phony](),
        refusals: List[Refusal](),
    }
}

fn test_join_continuations_basic() {
    let lines = List[str]()
    (mut lines).push("a \\")
    (mut lines).push("b \\")
    (mut lines).push("c")
    let result = join_continuations(lines)
    assert(result.len == 1, "expected 1 line")
    assert(result[0].text == "a b c", "expected joined line")
}

fn test_join_continuations_none() {
    let lines = List[str]()
    (mut lines).push("a")
    (mut lines).push("b")
    (mut lines).push("c")
    let result = join_continuations(lines)
    assert(result.len == 3, "expected 3 lines")
}

fn test_join_continuations_trailing() {
    let lines = List[str]()
    (mut lines).push("a \\")
    (mut lines).push("b")
    let result = join_continuations(lines)
    assert(result.len == 1, "expected 1 line")
    assert(result[0].text == "a b", "expected joined line")
}

fn test_strip_comment_none() {
    assert(strip_comment("hello world") == "hello world", "unchanged")
}

fn test_strip_comment_with() {
    assert(strip_comment("hello # world") == "hello ", "stripped")
}

fn test_strip_comment_start() {
    assert(strip_comment("# comment") == "", "empty")
}

fn test_check_refusal_pattern() {
    assert(check_refusal("%.o: %.c").len > 0, "pattern refused")
}

fn test_check_refusal_include() {
    assert(check_refusal("include other.mk").len > 0, "include refused")
}

fn test_check_refusal_ifeq() {
    assert(check_refusal("ifeq (1,2)").len > 0, "ifeq refused")
}

fn test_check_refusal_define() {
    assert(check_refusal("define FOO").len > 0, "define refused")
}

fn test_check_refusal_suffixes() {
    assert(check_refusal(".SUFFIXES: .c .o").len > 0, "suffixes refused")
}

fn test_check_refusal_order_only() {
    assert(check_refusal("all | clean: prog").len > 0, "order-only refused")
}

fn test_check_refusal_double_colon() {
    assert(check_refusal("prog:: a.o").len > 0, "double-colon refused")
}

fn test_check_refusal_wildcard() {
    assert(check_refusal("SRCS = $(wildcard *.c)").len > 0, "wildcard refused")
}

fn test_check_refusal_allowed() {
    assert(check_refusal("CC := gcc").len == 0, "allowed")
}

fn test_parse_assignment_simple() {
    let r = parse_assignment_ok("CC = gcc", 1)
    assert(r.name == "CC", "name")
    assert(r.op == "=", "op")
    assert(r.value == "gcc", "value")
    assert(r.line == 1, "line")
}

fn test_parse_assignment_colon_eq() {
    let r = parse_assignment_ok("CC := gcc", 1)
    assert(r.op == ":=", "op")
}

fn test_parse_assignment_qmark_eq() {
    let r = parse_assignment_ok("EXTRA ?= -g", 1)
    assert(r.op == "?=", "op")
    assert(r.value == "-g", "value")
}

fn test_parse_assignment_plus_eq() {
    let r = parse_assignment_ok("CFLAGS += -Wall", 1)
    assert(r.op == "+=", "op")
    assert(r.value == "-Wall", "value")
}

fn test_parse_assignment_none() {
    let r = parse_assignment_ok("all: main.o", 1)
    assert(r.name == "", "should be empty")
}

fn test_parse_rule_simple() {
    let r = parse_rule_ok("all: main.o", 1)
    assert(r.targets.len == 1, "1 target")
    assert(r.targets[0] == "all", "all")
    assert(r.prereqs.len == 1, "1 prereq")
    assert(r.prereqs[0] == "main.o", "main.o")
    assert(r.recipe.len == 0, "no recipe")
    assert(r.line == 1, "line")
}

fn test_parse_rule_no_prereqs() {
    let r = parse_rule_ok("clean:", 1)
    assert(r.targets.len == 1, "1 target")
    assert(r.targets[0] == "clean", "clean")
    assert(r.prereqs.len == 0, "no prereqs")
}

fn test_parse_rule_none() {
    let r = parse_rule_ok("CC = gcc", 1)
    assert(r.targets.len == 0, "should be empty")
}

fn test_parse_phony_valid() {
    let r = parse_phony_ok(".PHONY: clean all", 1)
    assert(r.names.len == 2, "2 names")
    assert(r.names[0] == "clean", "clean")
    assert(r.names[1] == "all", "all")
    assert(r.line == 1, "line")
}

fn test_parse_phony_none() {
    let r = parse_phony_ok("CC = gcc", 1)
    assert(r.names.len == 0, "should be empty")
}

fn test_parse_makefile_vars() {
    let text = "CC := gcc\nCFLAGS = -O2\nCFLAGS += -Wall\nEXTRA ?= -g\nLDFLAGS = -lm\nLDFLAGS += -lpthread\n\nall:\n\techo \"done\"\n"
    let db = parse_makefile_ok(text)
    assert(db.assignments.len == 6, "6 assignments")
    assert(db.rules.len == 1, "1 rule")
    assert(db.phonies.len == 0, "no phonies")
    assert(db.refusals.len == 0, "no refusals")
}

fn test_parse_makefile_continuation() {
    let text = "OBJS = a.o \\\n       b.o \\\n       c.o\n\nall: $(OBJS)\n\techo \"built $(OBJS)\"\n"
    let db = parse_makefile_ok(text)
    assert(db.assignments.len == 1, "1 assignment")
    assert(db.rules.len == 1, "1 rule")
}

fn test_parse_makefile_refuse() {
    let text = "%.o: %.c\n\tgcc -c -o $@ $<\n"
    let db = parse_makefile_ok(text)
    assert(db.refusals.len == 1, "1 refusal")
}

fn test_parse_makefile_phony() {
    let text = ".PHONY: clean all\n\nclean:\n\trm -f *.o\n"
    let db = parse_makefile_ok(text)
    assert(db.phonies.len == 1, "1 phony")
    assert(db.phonies[0].names.len == 2, "2 names")
}

fn test_parse_makefile_empty() {
    let db = parse_makefile_ok("")
    assert(db.assignments.len == 0, "no assignments")
    assert(db.rules.len == 0, "no rules")
}

fn test_parse_makefile_comments() {
    let db = parse_makefile_ok("# comment\n")
    assert(db.assignments.len == 0, "no assignments")
    assert(db.rules.len == 0, "no rules")
}

fn test_var_flavour_recursive() {
    let db = parse_makefile_ok("A = hello\nB = $(A) world\n")
    assert(db.assignments.len == 2, "2 assignments")
    assert(db.assignments[0].op == "=", "op1")
    assert(db.assignments[1].op == "=", "op2")
}

fn test_var_flavour_simple() {
    let db = parse_makefile_ok("A := hello\nB := $(A) world\n")
    assert(db.assignments.len == 2, "2 assignments")
    assert(db.assignments[0].op == ":=", "op1")
    assert(db.assignments[1].op == ":=", "op2")
}

fn test_var_flavour_conditional() {
    let db = parse_makefile_ok("A ?= default\n")
    assert(db.assignments.len == 1, "1 assignment")
    assert(db.assignments[0].op == "?=", "op")
    assert(db.assignments[0].value == "default", "value")
}

fn test_var_flavour_append() {
    let db = parse_makefile_ok("A = hello\nA += world\n")
    assert(db.assignments.len == 2, "2 assignments")
    assert(db.assignments[0].op == "=", "op1")
    assert(db.assignments[1].op == "+=", "op2")
}

fn test_vars_recursive() {
    let v = new_vars()
    set_var(mut v, "A", "one", "=", 1)
    set_var(mut v, "B", "$(A) two", "=", 2)
    set_var(mut v, "A", "uno", "=", 3)
    assert((expand(v, "$(B)", 4) else "") == "uno two", "recursive expansion")
}

fn test_vars_immediate() {
    let v = new_vars()
    set_var(mut v, "A", "one", "=", 1)
    set_var(mut v, "B", "$(A) two", ":=", 2)
    set_var(mut v, "A", "uno", "=", 3)
    assert((expand(v, "$(B)", 4) else "") == "one two", "immediate expansion")
}

fn test_vars_conditional() {
    let v = new_vars()
    set_var(mut v, "C", "three", "?=", 1)
    set_var(mut v, "C", "nope", "?=", 2)
    assert((expand(v, "$(C)", 3) else "") == "three", "conditional")
}

fn test_vars_append() {
    let v = new_vars()
    set_var(mut v, "D", "x", "=", 1)
    set_var(mut v, "D", "y", "+=", 2)
    assert((expand(v, "$(D)", 3) else "") == "x y", "append")
}

fn test_vars_dollar_dollar() {
    let v = new_vars()
    // $$ expands to $, and the next character is plain text (never re-scanned)
    set_var(mut v, "E", "$$X", ":=", 1)
    assert((expand(v, "$(E)", 2) else "") == "$X", "dollar dollar immediate")
    set_var(mut v, "F", "$$X", "=", 3)
    assert((expand(v, "$(F)", 4) else "") == "$X", "dollar dollar recursive")
}

fn test_vars_brace_syntax() {
    let v = new_vars()
    set_var(mut v, "A", "hello", "=", 1)
    assert((expand(v, "${{A}}", 2) else "") == "hello", "brace syntax")
}

fn test_vars_append_immediate() {
    let v = new_vars()
    set_var(mut v, "A", "one", ":=", 1)
    set_var(mut v, "A", "two", "+=", 2)
    assert((expand(v, "$(A)", 3) else "") == "one two", "append immediate")
}

fn test_vars_computed_name() {
    let v = new_vars()
    set_var(mut v, "NAME", "A", "=", 1)
    set_var(mut v, "A", "hello", "=", 2)
    assert((expand(v, "$($(NAME))", 3) else "") == "hello", "computed name")
}

fn test_vars_nested_ref() {
    let v = new_vars()
    set_var(mut v, "A", "hello", "=", 1)
    set_var(mut v, "B", "world", "=", 2)
    set_var(mut v, "Aworld", "nested", "=", 3)
    assert((expand(v, "$(A$(B))", 4) else "") == "nested", "nested reference")
}

fn test_vars_substitution() {
    let v = new_vars()
    set_var(mut v, "SRC", "a.c b.c", "=", 1)
    assert((expand(v, "$(SRC:.c=.o)", 2) else "") == "a.o b.o", "substitution reference")
}

fn test_vars_pattern_substitution() {
    let v = new_vars()
    set_var(mut v, "SRC", "a.c b.c", "=", 1)
    assert((expand(v, "$(SRC:%.c=%.o)", 2) else "") == "a.o b.o", "pattern substitution")
}

fn test_vars_cycle() {
    let v = new_vars()
    set_var(mut v, "A", "$(A)", "=", 1)
    assert((expand(v, "$(A)", 2) else "") == "", "cycle detection")
}

fn test_vars_single_char_followed_by_text() {
    let v = new_vars()
    set_var(mut v, "x", "one", "=", 1)
    assert((expand(v, "$xy", 2) else "") == "oney", "$x followed by text")
}
