//! mk_test.lu — unit tests for the parser and variable flavours.

use std.fs

fn parse_assignment_ok(line: str, n: int) -> Assignment {
    parse_assignment(line, n) else Assignment { name: "", op: "", value: "", line: 0 }
}

fn parse_rule_ok(line: str, n: int) -> Rule {
    parse_rule(line, n) else Rule {
        targets: List[str](),
        prereqs: List[str](),
        recipe: List[str](),
        first_recipe_line: 0,
        line: 0,
    }
}

fn parse_phony_ok(line: str, n: int) -> Phony {
    parse_phony(line, n) else Phony { names: List[str](), line: 0 }
}

fn parse_makefile_ok(text: str) -> Database {
    var v = new_vars()
    var cli_names = Map[str, int]()
    var include_dirs = List[str]()
    var env_names = Map[str, int]()
    parse_makefile(
        text,
        "Makefile",
        mut v,
        cli_names,
        include_dirs,
        false,
        env_names,
    ) else Database {
        assignments: List[Assignment](),
        rules: List[Rule](),
        phonies: List[Phony](),
        includes: List[Include](),
        defines: List[Define](),
        refusals: List[Refusal](),
        included_files: List[IncludedFile](),
    }
}

fn test_join_continuations_basic() {
    let lines = List[str]()
    (mut lines).push("a \\")
    (mut lines).push("b \\")
    (mut lines).push("c")
    let result = join_continuations(lines)
    assert(result.len == 1, "expected 1 line")
    assert(result[0].text == "a b c", "expected joined line")
}

fn test_join_continuations_none() {
    let lines = List[str]()
    (mut lines).push("a")
    (mut lines).push("b")
    (mut lines).push("c")
    let result = join_continuations(lines)
    assert(result.len == 3, "expected 3 lines")
}

fn test_join_continuations_trailing() {
    let lines = List[str]()
    (mut lines).push("a \\")
    (mut lines).push("b")
    let result = join_continuations(lines)
    assert(result.len == 1, "expected 1 line")
    assert(result[0].text == "a b", "expected joined line")
}

fn test_strip_comment_none() {
    assert(strip_comment("hello world") == "hello world", "unchanged")
}

fn test_strip_comment_with() {
    assert(strip_comment("hello # world") == "hello ", "stripped")
}

fn test_strip_comment_start() {
    assert(strip_comment("# comment") == "", "empty")
}

fn test_check_refusal_pattern() {
    assert(check_refusal("%.o: %.c").len > 0, "pattern refused")
}

fn test_check_refusal_include() {
    assert(check_refusal("include other.mk").len == 0, "include is accepted")
}

fn test_check_refusal_ifeq() {
    assert(check_refusal("ifeq (1,2)").len == 0, "ifeq is accepted")
}

fn test_check_refusal_define() {
    assert(check_refusal("define FOO").len == 0, "define is accepted")
}

fn test_check_refusal_suffixes() {
    assert(check_refusal(".SUFFIXES: .c .o").len > 0, "suffixes refused")
}

fn test_check_refusal_order_only() {
    assert(check_refusal("all | clean: prog").len > 0, "order-only refused")
}

fn test_check_refusal_double_colon() {
    assert(check_refusal("prog:: a.o").len > 0, "double-colon refused")
}

fn test_check_refusal_wildcard() {
    assert(check_refusal("SRCS = $(wildcard *.c)").len == 0, "wildcard is read, not refused")
}

fn test_check_refusal_allowed() {
    assert(check_refusal("CC := gcc").len == 0, "allowed")
}

fn test_parse_assignment_simple() {
    let r = parse_assignment_ok("CC = gcc", 1)
    assert(r.name == "CC", "name")
    assert(r.op == "=", "op")
    assert(r.value == "gcc", "value")
    assert(r.line == 1, "line")
}

fn test_parse_assignment_colon_eq() {
    let r = parse_assignment_ok("CC := gcc", 1)
    assert(r.op == ":=", "op")
}

fn test_parse_assignment_qmark_eq() {
    let r = parse_assignment_ok("EXTRA ?= -g", 1)
    assert(r.op == "?=", "op")
    assert(r.value == "-g", "value")
}

fn test_parse_assignment_plus_eq() {
    let r = parse_assignment_ok("CFLAGS += -Wall", 1)
    assert(r.op == "+=", "op")
    assert(r.value == "-Wall", "value")
}

fn test_parse_assignment_none() {
    let r = parse_assignment_ok("all: main.o", 1)
    assert(r.name == "", "should be empty")
}

fn test_parse_rule_simple() {
    let r = parse_rule_ok("all: main.o", 1)
    assert(r.targets.len == 1, "1 target")
    assert(r.targets[0] == "all", "all")
    assert(r.prereqs.len == 1, "1 prereq")
    assert(r.prereqs[0] == "main.o", "main.o")
    assert(r.recipe.len == 0, "no recipe")
    assert(r.line == 1, "line")
}

fn test_parse_rule_no_prereqs() {
    let r = parse_rule_ok("clean:", 1)
    assert(r.targets.len == 1, "1 target")
    assert(r.targets[0] == "clean", "clean")
    assert(r.prereqs.len == 0, "no prereqs")
}

fn test_parse_rule_none() {
    let r = parse_rule_ok("CC = gcc", 1)
    assert(r.targets.len == 0, "should be empty")
}

fn test_parse_phony_valid() {
    let r = parse_phony_ok(".PHONY: clean all", 1)
    assert(r.names.len == 2, "2 names")
    assert(r.names[0] == "clean", "clean")
    assert(r.names[1] == "all", "all")
    assert(r.line == 1, "line")
}

fn test_parse_phony_none() {
    let r = parse_phony_ok("CC = gcc", 1)
    assert(r.names.len == 0, "should be empty")
}

fn test_parse_makefile_vars() {
    let text = "CC := gcc\nCFLAGS = -O2\nCFLAGS += -Wall\nEXTRA ?= -g\nLDFLAGS = -lm\nLDFLAGS += -lpthread\n\nall:\n\techo \"done\"\n"
    let db = parse_makefile_ok(text)
    assert(db.assignments.len == 6, "6 assignments")
    assert(db.rules.len == 1, "1 rule")
    assert(db.phonies.len == 0, "no phonies")
    assert(db.refusals.len == 0, "no refusals")
}

fn test_parse_makefile_continuation() {
    let text = "OBJS = a.o \\\n       b.o \\\n       c.o\n\nall: $(OBJS)\n\techo \"built $(OBJS)\"\n"
    let db = parse_makefile_ok(text)
    assert(db.assignments.len == 1, "1 assignment")
    assert(db.rules.len == 1, "1 rule")
}

fn test_parse_makefile_refuse() {
    let text = "%.o: %.c\n\tgcc -c -o $@ $<\n"
    let db = parse_makefile_ok(text)
    assert(db.refusals.len == 1, "1 refusal")
}

fn test_parse_makefile_phony() {
    let text = ".PHONY: clean all\n\nclean:\n\trm -f *.o\n"
    let db = parse_makefile_ok(text)
    assert(db.phonies.len == 1, "1 phony")
    assert(db.phonies[0].names.len == 2, "2 names")
}

fn test_parse_makefile_empty() {
    let db = parse_makefile_ok("")
    assert(db.assignments.len == 0, "no assignments")
    assert(db.rules.len == 0, "no rules")
}

fn test_parse_makefile_comments() {
    let db = parse_makefile_ok("# comment\n")
    assert(db.assignments.len == 0, "no assignments")
    assert(db.rules.len == 0, "no rules")
}

fn test_var_flavour_recursive() {
    let db = parse_makefile_ok("A = hello\nB = $(A) world\n")
    assert(db.assignments.len == 2, "2 assignments")
    assert(db.assignments[0].op == "=", "op1")
    assert(db.assignments[1].op == "=", "op2")
}

fn test_var_flavour_simple() {
    let db = parse_makefile_ok("A := hello\nB := $(A) world\n")
    assert(db.assignments.len == 2, "2 assignments")
    assert(db.assignments[0].op == ":=", "op1")
    assert(db.assignments[1].op == ":=", "op2")
}

fn test_var_flavour_conditional() {
    let db = parse_makefile_ok("A ?= default\n")
    assert(db.assignments.len == 1, "1 assignment")
    assert(db.assignments[0].op == "?=", "op")
    assert(db.assignments[0].value == "default", "value")
}

fn test_var_flavour_append() {
    let db = parse_makefile_ok("A = hello\nA += world\n")
    assert(db.assignments.len == 2, "2 assignments")
    assert(db.assignments[0].op == "=", "op1")
    assert(db.assignments[1].op == "+=", "op2")
}

fn test_vars_recursive() {
    let v = new_vars()
    set_var(mut v, "A", "one", "=", 1)
    set_var(mut v, "B", "$(A) two", "=", 2)
    set_var(mut v, "A", "uno", "=", 3)
    assert((expand(v, "$(B)", 4) else "") == "uno two", "recursive expansion")
}

fn test_vars_immediate() {
    let v = new_vars()
    set_var(mut v, "A", "one", "=", 1)
    set_var(mut v, "B", "$(A) two", ":=", 2)
    set_var(mut v, "A", "uno", "=", 3)
    assert((expand(v, "$(B)", 4) else "") == "one two", "immediate expansion")
}

fn test_vars_conditional() {
    let v = new_vars()
    set_var(mut v, "C", "three", "?=", 1)
    set_var(mut v, "C", "nope", "?=", 2)
    assert((expand(v, "$(C)", 3) else "") == "three", "conditional")
}

fn test_vars_append() {
    let v = new_vars()
    set_var(mut v, "D", "x", "=", 1)
    set_var(mut v, "D", "y", "+=", 2)
    assert((expand(v, "$(D)", 3) else "") == "x y", "append")
}

fn test_vars_dollar_dollar() {
    let v = new_vars()
    // $$ expands to $, and the next character is plain text (never re-scanned)
    set_var(mut v, "E", "$$X", ":=", 1)
    assert((expand(v, "$(E)", 2) else "") == "$X", "dollar dollar immediate")
    set_var(mut v, "F", "$$X", "=", 3)
    assert((expand(v, "$(F)", 4) else "") == "$X", "dollar dollar recursive")
}

fn test_vars_brace_syntax() {
    let v = new_vars()
    set_var(mut v, "A", "hello", "=", 1)
    assert((expand(v, "${{A}}", 2) else "") == "hello", "brace syntax")
}

fn test_vars_append_immediate() {
    let v = new_vars()
    set_var(mut v, "A", "one", ":=", 1)
    set_var(mut v, "A", "two", "+=", 2)
    assert((expand(v, "$(A)", 3) else "") == "one two", "append immediate")
}

fn test_vars_computed_name() {
    let v = new_vars()
    set_var(mut v, "NAME", "A", "=", 1)
    set_var(mut v, "A", "hello", "=", 2)
    assert((expand(v, "$($(NAME))", 3) else "") == "hello", "computed name")
}

fn test_vars_nested_ref() {
    let v = new_vars()
    set_var(mut v, "A", "hello", "=", 1)
    set_var(mut v, "B", "world", "=", 2)
    set_var(mut v, "Aworld", "nested", "=", 3)
    assert((expand(v, "$(A$(B))", 4) else "") == "nested", "nested reference")
}

fn test_vars_substitution() {
    let v = new_vars()
    set_var(mut v, "SRC", "a.c b.c", "=", 1)
    assert((expand(v, "$(SRC:.c=.o)", 2) else "") == "a.o b.o", "substitution reference")
}

fn test_vars_pattern_substitution() {
    let v = new_vars()
    set_var(mut v, "SRC", "a.c b.c", "=", 1)
    assert((expand(v, "$(SRC:%.c=%.o)", 2) else "") == "a.o b.o", "pattern substitution")
}

fn test_vars_cycle() {
    let v = new_vars()
    set_var(mut v, "A", "$(A)", "=", 1)
    assert((expand(v, "$(A)", 2) else "") == "", "cycle detection")
}

fn test_vars_single_char_followed_by_text() {
    let v = new_vars()
    set_var(mut v, "x", "one", "=", 1)
    assert((expand(v, "$xy", 2) else "") == "oney", "$x followed by text")
}

fn test_split_recipe_lines_continuation() {
    // "a \\\nb\nc" splits into two lines: the backslash-newline is a continuation
    let lines = split_recipe_lines("a \\\nb\nc")
    assert(lines.len == 2, "two lines: continuation stays together")
    assert(lines[0] == "a \\\nb", "first line includes continuation")
    assert(lines[1] == "c", "second line is bare")
}

fn test_split_recipe_lines_bare_newlines() {
    // "x\n\ny" splits into three lines: the empty line is preserved
    let lines = split_recipe_lines("x\n\ny")
    assert(lines.len == 3, "three lines: empty line preserved")
    assert(lines[0] == "x", "first line")
    assert(lines[1] == "", "empty line")
    assert(lines[2] == "y", "third line")
}

fn test_split_args_depth_and_max() {
    let p = split_args("a,$(b,c),d,e", 3)
    assert(
        p.len == 3 && p[0] == "a" && p[1] == "$(b,c)" && p[2] == "d,e",
        "split_args: depth zero, last keeps commas",
    )
}

fn test_function_subst() {
    let v = new_vars()
    assert(
        (expand(v, "$(subst ee,EE,feet on the street)", 1) else "") == "fEEt on the strEEt",
        "subst",
    )
}

fn test_function_strip_findstring() {
    let v = new_vars()
    assert((expand(v, "[$(strip   a   b  )]", 1) else "") == "[a b]", "strip")
    assert(
        (expand(v, "$(findstring a,a b c)|$(findstring z,a b c)", 1) else "") == "a|",
        "findstring",
    )
}

fn test_function_words_first_last() {
    let v = new_vars()
    assert((expand(v, "$(words foo bar)", 1) else "") == "2", "words")
    assert(
        (expand(v, "$(firstword foo bar baz)$(lastword foo bar baz)", 1) else "") == "foobaz",
        "firstword, lastword",
    )
}

fn test_function_patsubst_first_percent() {
    let v = new_vars()
    assert(
        (expand(v, "$(patsubst %.c,%-%.o,a.c b.h)", 1) else "") == "a-%.o b.h",
        "patsubst: first % only, non-matches pass",
    )
    assert(
        (expand(v, "$(patsubst a,x,a aa b)", 1) else "") == "x aa b",
        "patsubst: whole-word without %",
    )
}

fn test_function_filter_and_out() {
    let v = new_vars()
    assert((expand(v, "$(filter a%,abc bca a)", 1) else "") == "abc a", "filter")
    assert((expand(v, "$(filter-out x,x y x)", 1) else "") == "y", "filter-out")
    assert((expand(v, "$(filter %,a b)", 1) else "") == "a b", "filter: lone % matches all")
}

fn test_function_sort() {
    let v = new_vars()
    assert((expand(v, "$(sort b a b c)", 1) else "") == "a b c", "sort: bytewise, unique")
    assert((expand(v, "[$(sort  )]", 1) else "") == "[]", "sort: empty")
}

fn test_function_dir_notdir() {
    let v = new_vars()
    assert((expand(v, "$(dir src/foo.c hacks)", 1) else "") == "src/ ./", "dir")
    assert((expand(v, "$(dir /foo)", 1) else "") == "/", "dir: root")
    assert((expand(v, "$(notdir src/foo.c hacks)", 1) else "") == "foo.c hacks", "notdir")
    assert((expand(v, "[$(notdir src/ b)]", 1) else "") == "[ b]", "notdir: an empty piece stays")
}

fn test_function_suffix_basename() {
    let v = new_vars()
    assert(
        (expand(v, "$(suffix src/foo.c src-1.0/bar.c hacks)", 1) else "") == ".c .c",
        "suffix drops a word without one",
    )
    assert((expand(v, "$(suffix .c a.)", 1) else "") == ".c .", "suffix: dot first, dot last")
    assert(
        (expand(v, "$(basename src/foo.c src-1.0/bar hacks)", 1) else "") ==
            "src/foo src-1.0/bar hacks",
        "basename",
    )
    assert(
        (expand(v, "$(basename a.b/c d)", 1) else "") == "a.b/c d",
        "basename: a dot in the directory is not a suffix",
    )
    assert(
        (expand(v, "[$(basename .c a. b)]", 1) else "") == "[ a b]",
        "basename: an empty piece stays",
    )
}

fn test_function_affix_and_join() {
    let v = new_vars()
    assert((expand(v, "$(addsuffix .c,foo bar)", 1) else "") == "foo.c bar.c", "addsuffix")
    assert((expand(v, "$(addprefix src/,foo bar)", 1) else "") == "src/foo src/bar", "addprefix")
    assert((expand(v, "$(join a b,.c .o)", 1) else "") == "a.c b.o", "join")
    assert(
        (expand(v, "$(join a b,c)", 1) else "") == "ac b",
        "join: the longer tail passes through",
    )
}

fn test_function_abspath_absolute() {
    let v = new_vars()
    assert(
        (expand(v, "$(abspath /a/./b//c/)", 1) else "") == "/a/b/c",
        "abspath: dots, doubled and trailing slashes",
    )
    assert((expand(v, "$(abspath /)", 1) else "") == "/", "abspath: the root")
    assert((expand(v, "$(abspath /../../z)", 1) else "") == "/z", "abspath: .. clamps at the root")
}

fn test_function_wildcard_realpath_missing() {
    let v = new_vars()
    assert(
        (expand(v, "[$(wildcard nope-*.zz nope)]", 1) else "") == "[]",
        "wildcard: nothing matches, nothing exists",
    )
    assert(
        (expand(v, "[$(realpath nope)]", 1) else "") == "[]",
        "realpath: a missing file is dropped",
    )
}

fn test_function_if_or_and() {
    let v = new_vars()
    set_var(mut v, "X", "x", "=", 1)
    set_var(mut v, "E", "", "=", 1)
    assert((expand(v, "$(if $(X),yes,no)", 1) else "") == "yes", "if: taken")
    assert((expand(v, "$(if $(E),yes,no)", 1) else "") == "no", "if: not taken")
    assert((expand(v, "[$(if $(E),yes)]", 1) else "") == "[]", "if: no else part")
    assert((expand(v, "$(if  $(X) ,a,b)", 1) else "") == "a", "if: the condition is stripped")
    assert((expand(v, "$(or $(E),two,three)", 1) else "") == "two", "or: first non-empty")
    assert((expand(v, "$(and $(X),two,three)", 1) else "") == "three", "and: the last")
    assert((expand(v, "[$(and $(X),$(E),three)]", 1) else "") == "[]", "and: an empty one")
}

fn test_function_lazy_branch_never_expanded() {
    let v = new_vars()
    assert(
        (expand(v, "$(if ,$(error never),lazy)", 1) else "REFUSED") == "lazy",
        "if: the untaken branch is not expanded",
    )
    assert(
        (expand(v, "$(or yes,$(error never))", 1) else "REFUSED") == "yes",
        "or: stops at the first non-empty",
    )
    assert(
        (expand(v, "[$(and ,$(error never))]", 1) else "REFUSED") == "[]",
        "and: stops at the first empty",
    )
}

fn test_function_intcmp() {
    let v = new_vars()
    assert((expand(v, "[$(intcmp 1,2)]", 1) else "") == "[]", "intcmp: two arguments, unequal")
    assert((expand(v, "$(intcmp 2,2)", 1) else "") == "2", "intcmp: two arguments, equal")
    assert(
        (expand(v, "$(intcmp 3,2,lt,eq)", 1) else "") == "eq",
        "intcmp: greater falls to the fourth",
    )
    assert(
        (expand(v, "$(intcmp -5,-3,lt,eq,gt)", 1) else "") == "lt",
        "intcmp: two negatives order as numbers (R-mk-1)",
    )
    assert((expand(v, "$(intcmp -1,1,lt,eq,gt)", 1) else "") == "lt", "intcmp: mixed signs")
    assert(
        (expand(v, "$(intcmp 1,2,a,b,c,d)", 1) else "") == "a",
        "intcmp: extra arguments ignored",
    )
    assert(
        (expand(v, "$(intcmp a,1)", 1) else "REFUSED") == "REFUSED",
        "intcmp: non-numeric refuses",
    )
}

fn test_function_foreach_and_call() {
    let v = new_vars()
    set_var(mut v, "reverse", "$(2) $(1)", "=", 1)
    set_var(mut v, "i", "outer", "=", 1)
    assert((expand(v, "$(foreach i,a b,$(i).o)", 1) else "") == "a.o b.o", "foreach: each word")
    assert((expand(v, "[$(foreach i,,x)]", 1) else "") == "[]", "foreach: empty list")
    assert(
        (expand(v, "$(foreach i,a,$(i))$(i)", 1) else "") == "aouter",
        "foreach: the outer binding is untouched",
    )
    assert((expand(v, "$(call reverse,a,b)", 1) else "") == "b a", "call: $(1) and $(2)")
    assert(
        (expand(v, "[$(call nosuch,a)]", 1) else "") == "[]",
        "call: an undefined function is empty",
    )
    assert(
        (expand(v, "[$(call reverse)]", 1) else "") == "[ ]",
        "call: missing arguments are empty",
    )
    assert(
        (expand(v, "$(foreach i,a)", 1) else "REFUSED") == "REFUSED",
        "foreach: two arguments refuse",
    )
}

fn test_function_value_origin_flavor() {
    let v = new_vars()
    set_var(mut v, "R", "recursive $(S)", "=", 1)
    set_var(mut v, "S", "simple", ":=", 1)
    set_var_origin(mut v, "C", "c", "=", 1, "cli")
    set_var_origin(mut v, "E", "e", "=", 1, "env")
    assert((expand(v, "$(value R)", 1) else "") == "recursive $(S)", "value: the unexpanded text")
    assert((expand(v, "$(value S)", 1) else "") == "simple", "value: a simple variable")
    assert((expand(v, "[$(value nosuch)]", 1) else "") == "[]", "value: undefined is empty")
    assert((expand(v, "$(origin R)", 1) else "") == "file", "origin: file")
    assert((expand(v, "$(origin C)", 1) else "") == "command line", "origin: command line")
    assert((expand(v, "$(origin E)", 1) else "") == "environment", "origin: environment")
    assert((expand(v, "$(origin nosuch)", 1) else "") == "undefined", "origin: undefined")
    assert((expand(v, "$(origin MAKE)", 1) else "") == "default", "origin: MAKE is default")
    assert((expand(v, "$(flavor R)", 1) else "") == "recursive", "flavor: recursive")
    assert((expand(v, "$(flavor S)", 1) else "") == "simple", "flavor: simple")
    assert((expand(v, "$(flavor nosuch)", 1) else "") == "undefined", "flavor: undefined")
}

fn test_function_messages() {
    let v = new_vars()
    assert((expand(v, "[$(info unit)]", 1) else "") == "[]", "info expands to nothing")
    assert((expand(v, "[$(warning unit)]", 1) else "") == "[]", "warning expands to nothing")
    assert(
        (expand(v, "$(if ,$(error no),yes)", 1) else "REFUSED") == "yes",
        "if does not expand the branch not taken",
    )
    assert((expand(v, "$(error boom)", 1) else "REFUSED") == "REFUSED", "error refuses")
}

fn test_function_shell() {
    let v = new_vars()
    assert(
        (expand(v, "[$(shell echo a; echo b; echo)]", 1) else "") == "[a b]",
        "shell joins lines and drops the trailing newlines",
    )
    let (out, status) = shell_output("echo x; exit 3")
    assert(out == "x" && status == 3, "a failing command still gives its output, and its status")
    let a = parse_assignment("N!=echo n", 1) else Assignment {
        name: "",
        op: "",
        value: "",
        line: 0,
    }
    assert(
        a.name == "N" && a.op == "!=" && a.value == "echo n",
        "!= is the shell assignment, not a name ending in !",
    )
}

fn test_unterminated_messages() {
    assert(
        unterminated_message("subst a,b,abc", ")") ==
            "unterminated call to function 'subst': missing ')'",
        "an unclosed call names its function and the missing close",
    )
    assert(
        unterminated_message("foreach v,a b,$(v)", ")") ==
            "unterminated call to function 'foreach': missing ')'",
        "a lazy function is a function too",
    )
    assert(
        unterminated_message("Y", ")") == "unterminated variable reference",
        "a variable is a reference",
    )
    assert(
        unterminated_message("subst", ")") == "unterminated call to function 'subst': missing ')'",
        "a function name with nothing after it is still a call (gmake 4.4.1)",
    )
    assert(
        unterminated_message("foreach", "}}") ==
            "unterminated call to function 'foreach': missing '}}'",
        "a lazy function name with nothing after it is a call too",
    )
    assert(
        unterminated_message("wordx", ")") == "unterminated variable reference",
        "a name that is not a function is a reference",
    )
}

fn test_shellstatus_cell() {
    let v = new_vars()
    let (empty, absent) = expand_status(v, "$(.SHELLSTATUS)", 1) else ("error", -2)
    assert(empty == "" && absent == -1, "no shell leaves the sentinel")
    let (out, status) = expand_status(v, "$(shell exit 7)$(.SHELLSTATUS)", 1) else ("error", -2)
    assert(out == "7" && status == 7, "same-expansion visibility and returned status")
    assert(!var_defined(v, ".SHELLSTATUS"), "read-only expansion leaves the table alone")
}

fn test_shellstatus_store() {
    var v = new_vars()
    set_var(mut v, "R", "$(shell exit 3)", "=", 1)
    assert(!var_defined(v, ".SHELLSTATUS"), "recursive assignment does not run a shell")
    let out = expand_store(
        mut v,
        "$(R)$(origin .SHELLSTATUS)/$(flavor .SHELLSTATUS)/$(value .SHELLSTATUS)",
        2,
    ) else "error"
    assert(out == "override/simple/3", "metadata sees the cell too")
    assert(var_value(v, ".SHELLSTATUS") == "3", "persist the status")
    assert(var_origin(v, ".SHELLSTATUS") == "override", "override origin")
    assert(var_flavour(v, ".SHELLSTATUS") == ":=", "simple flavor")
    let unchanged = expand_store(mut v, "$(.SHELLSTATUS)", 3) else "error"
    assert(
        unchanged == "3" && var_value(v, ".SHELLSTATUS") == "3",
        "no shell preserves prior status",
    )
}

fn test_shellstatus_signal() {
    let (out, status) = shell_output("kill -9 $$")
    assert(out == "" && status == 137, "signal 9 becomes 128 + 9")
}

fn test_let_scope() {
    var v = new_vars()
    set_var_origin(mut v, "a", "outer", ":=", 1, "cli")
    let out = expand(v, "$(let a,one,[$(a)]$(let a,two,[$(a)])[$(a)])[$(a)]", 2) else "error"
    assert(out == "[one][two][one][outer]", "nested copies restore command-line binding")
    assert(
        (expand(v, "$(let a,$$x,[$(a)])", 2) else "error") == "[$x]",
        "no second expansion of bound value",
    )
    assert(
        (expand(v, "$(let a,one,$(origin a)/$(flavor a))", 2) else "error") == "automatic/simple",
        "binding metadata",
    )
    assert(var_value(v, "a") == "outer", "caller unchanged")
}

fn test_let_errors() {
    let v = new_vars()
    let msg = expand(v, "$(let a,b)", 7) else |e| match e {
        Refuse(l, m) => "{l}:{m}",
        _ => "wrong error",
    }
    assert(
        msg == "7:*** insufficient number of arguments (2) to function 'let'",
        "let arity is fatal",
    )
    assert(
        lazy_function_name("let a,b,c") == "let" &&
            lazy_function_name("file >x") == "file" &&
            is_text_function("eval"),
        "let, file and eval are functions",
    )
    assert(
        check_refusal("X := $(let a,b,$(file >x,$(a)))") == "",
        "line scan does not refuse supported calls",
    )
}

fn test_file_roundtrip() {
    let path = ".mk-p27a-roundtrip.txt"
    assert((file_operation(">{path}", "hello", true, 1) else "error") == "", "write returns empty")
    assert(
        (file_operation(">>{path}", "world", true, 1) else "error") == "",
        "append returns empty",
    )
    assert((fs.read_text(path) else "error") == "hello\nworld\n", "each write adds newline")
    assert(
        (file_operation("<{path}", "", false, 1) else "error") == "hello\nworld",
        "read drops exactly final newline",
    )
    fs.remove(path) else { assert(false, "remove roundtrip fixture") }
}

fn test_file_empty_and_newlines() {
    let path = ".mk-p27a-empty.txt"
    let _out = file_operation(">{path}", "", false, 1) else "error"
    assert((fs.size(path) else -1) == 0, "omitted text creates zero bytes")
    let _blank = file_operation(">{path}", "", true, 1) else "error"
    assert((fs.read_text(path) else "error") == "\n", "explicit empty text writes newline")
    let _nl = file_operation(">{path}", "hello\n\n", true, 1) else "error"
    assert(
        (fs.read_text(path) else "error") == "hello\n\n",
        "no extra newline when already present",
    )
    assert(
        (file_operation("<{path}", "", false, 1) else "error") == "hello\n",
        "read keeps earlier newline",
    )
    fs.remove(path) else { assert(false, "remove empty fixture") }
}

fn test_file_errors() {
    assert(
        (file_operation("<.mk-p27a-absent.txt", "", false, 1) else "error") == "",
        "missing read is empty",
    )
    let bad = file_operation("bad", "x", true, 3) else |e| match e {
        Refuse(l, m) => "{l}:{m}",
    }
    assert(bad == "3:*** file: invalid file operation: bad", "invalid operation")
    let extra = file_operation("<.mk-p27a-absent.txt", "extra", true, 1) else |e| match e {
        Refuse(l, m) => m,
    }
    assert(extra == "*** file: too many arguments", "read rejects text even for a missing file")
    let absent = file_operation(">", "", false, 1) else |e| match e {
        Refuse(l, m) => m,
    }
    assert(absent == "*** file: missing filename", "missing filename")
    let parent = file_operation(">.mk-p27a-no-dir/x", "hi", true, 1) else |e| match e {
        Refuse(l, m) => m,
    }
    assert(parent == "*** open: .mk-p27a-no-dir/x: No such file or directory", "open failure")
}

fn test_file_lazy() {
    var v = new_vars()
    let path = ".mk-p27a-lazy.txt"
    set_var(mut v, "R", "$(file >{path},one,two)", "=", 1)
    assert(!fs.exists(path), "recursive assignment is lazy")
    let (skipped, status) = expand_status(v, "$(if ,$(R),skip)", 2) else ("error", -2)
    assert(
        skipped == "skip" && status == -1 && !fs.exists(path),
        "unchosen branch does no I/O or shell",
    )
    let (out, used_status) = expand_status(v, "$(R)", 2) else ("error", -2)
    assert(out == "" && used_status == -1, "file does not set shell status")
    assert((fs.read_text(path) else "error") == "one,two\n", "commas belong to text")
    fs.remove(path) else { assert(false, "remove lazy fixture") }
}

fn test_let_distribution() {
    let v = new_vars()
    assert(
        (expand(v, "$(let a b rest,1 2 3 4,$(a)-$(b)-$(rest))", 1) else "error") == "1-2-3 4",
        "last name takes remainder",
    )
    assert(
        (expand(v, "$(let a b,1,[$(a)][$(b)])", 1) else "error") == "[1][]",
        "missing words bind empty",
    )
    assert((expand(v, "$(let a,,[$(a)])", 1) else "error") == "[]", "empty list")
    assert((expand(v, "$(let ,1 2,x)", 1) else "error") == "x", "no names still expands body")
    assert(
        (expand(v, "$(let a b,  1   2  3  ,[$(b)])", 1) else "error") == "[2  3  ]",
        "preserve tail whitespace",
    )
}

fn test_eval_assignments() {
    var v = new_vars()
    let out = expand_store(
        mut v,
        "$(eval A = 1)$(eval B := $(A)2)$(eval A = 9)[$(A)$(B)]",
        1,
    ) else "error"
    assert(out == "[912]", "eval is immediate within one expansion")
    assert(var_flavour(v, "A") == "=" && var_flavour(v, "B") == ":=", "recursive and simple")
    let acc = expand_store(mut v, "$(foreach x,a b c,$(eval ALL := $(ALL) $(x)))", 2) else "error"
    assert(acc == "" && var_value(v, "ALL") == "a b c", "foreach carries eval out")
    assert(!var_defined(v, "x"), "foreach restores its variable")
}

fn test_eval_read_only_copy() {
    let v = new_vars()
    let out = expand(v, "$(eval X := 1)$(X)", 1) else "error"
    assert(out == "1" && !var_defined(v, "X"), "a read-only expansion keeps eval in its copy")
    let a = parse_assignment_ok("L = $(eval X := 1)", 1)
    assert(
        a.name == "L" && a.op == "=" && a.value == "$(eval X := 1)",
        "the operator is at the first =",
    )
}

fn test_eval_rules() {
    let db = parse_makefile_ok("a:\ndefine R\nb: c\n\t@echo $$@\nendef\n$(eval $(R))\nd:\n")
    assert(db.rules.len == 3, "three rules")
    assert(
        db.rules[1].targets[0] == "b" && db.rules[2].targets[0] == "d",
        "the eval'd rule in reading order",
    )
    assert(
        db.rules[1].recipe.len == 1 && db.rules[1].recipe[0] == "@echo $@",
        "recipe from the body",
    )
    assert(
        db.rules[1].line == 6 && db.rules[1].first_recipe_line == 6,
        "reported at the eval's line",
    )
}

fn test_define_keeps_body_text() {
    var v = new_vars()
    let text = "define T\nifeq (a,b)\nX := 1\nendif\n\t@echo hi\ndefine IN\nendef\nendef\n"
    let _db = parse_makefile(
        text,
        "Makefile",
        mut v,
        Map[str, int](),
        List[str](),
        false,
        Map[str, int](),
    ) else new_database()
    let body = "ifeq (a,b)\nX := 1\nendif\n\t@echo hi\ndefine IN\nendef"
    assert(var_value(v, "T") == body, "directives, recipe lines and a nested define are text")
    assert(!var_defined(v, "X") && !var_defined(v, "IN"), "nothing in the body runs")
}

fn test_eval_errors() {
    var v = new_vars()
    let sep = expand_store(mut v, "$(eval X)", 4) else |e| match e {
        Unterminated(l, m) => "{l}:{m}",
        _ => "wrong error",
    }
    assert(sep == "4:missing separator", "a bad line stops at the eval's line")
    let rule = expand_store(mut v, "$(eval y: z)", 5) else |e| match e {
        Unterminated(l, m) => "{l}:{m}",
        _ => "wrong error",
    }
    assert(rule == "5:prerequisites cannot be defined in recipes", "no rule after the reader")
    assert(is_text_function("eval"), "eval is a function now")
    let open = unterminated_message("eval A := 1", ")")
    assert(open == "unterminated call to function 'eval': missing ')'", "an open eval is named")
}

fn test_eval_call_let_nested() {
    var v = new_vars()
    set_var(mut v, "T", "$(1)_V := $(2)", "=", 1)
    let out = expand_store(
        mut v,
        "$(eval $(call T,a,one))$(eval $$(eval N := deep))[$(a_V)][$(N)]",
        2,
    ) else "error"
    assert(out == "[one][deep]", "a call template and a nested eval")
    assert(!var_defined(v, "0") && !var_defined(v, "1"), "call restores its arguments")
    let in_let = expand_store(mut v, "$(let q,1,$(eval L := $(q)))[$(L)]", 3) else "error"
    assert(in_let == "[1]" && !var_defined(v, "q"), "let carries eval out and restores its names")
}

fn test_fatal_assignment_stops() {
    var v = new_vars()
    var got = "no error"
    let text = "A := 1\nY := $(error HELLO)\nZ := after\n"
    let empty = Map[str, int]()
    let _db = parse_makefile(
        text,
        "f.mk",
        mut v,
        empty,
        List[str](),
        false,
        empty,
    ) else |e| match e {
        Parse(p) => {
            got = "{p.file}:{p.line}: {p.message}"
            new_database()
        },
        parse => new_database(),
        io => new_database(),
    }
    assert(got == "f.mk:2: HELLO", "a fatal error in := stops the reader with gmake's line")
    assert(var_defined(v, "A") && !var_defined(v, "Z"), "nothing after it is read")
}
