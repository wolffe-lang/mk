//! main.lu — flags, goals, exit status, -p output.
//!
//! File layout (the module is one directory):
//!   main.lu     — flags, goals, exit status, -p output (this file)
//!   parse.lu    — Makefile parser: lines, continuations, assignments, rules, recipes
//!   vars.lu     — variable table, expansion, automatic variables
//!   graph.lu    — dependency graph, DFS, cycle detection, out-of-date decision
//!   run.lu      — scheduler: ready queue, parallel execution, -n/-s/-k
//!   mk_test.lu  — unit tests for the parser and variable flavours
//!
//! This file parses the CLI flags of README §4:
//!   mk [-f FILE] [-C DIR] [-n] [-s] [-k] [-j [N]] [-p] [NAME=VALUE]... [GOAL]...
//!   mk --help
//!   mk --version
//! and prints the parsed structure with --debug-opts.

use std.env
use std.fs
use std.str
use std.map

/// The version string, embedded at build time.
let VERSION: str = "0.3.1"

let WOLF_VERSION: str = "0.2.34"

/// Build the program-name prefix: `mk:` at level 0, `mk[N]:` at level N > 0.
fn mk_prefix(level: int) -> str {
    if level > 0 {
        "mk[{level}]:"
    } else {
        "mk:"
    }
}

/// Parsed CLI flags for mk.
struct Flags {
    files: List[str],
    dir: str,
    dry_run: bool,
    silent: bool,
    keep_going: bool,
    jobs: int,
    print_db: bool,
    overrides: List[str],
    goals: List[str],
    include_dirs: List[str],
    env_wins: bool,
}

/// Print usage and exit 0.
fn print_usage() -> int {
    print(
        "Usage: mk [-f FILE] [-C DIR] [-n] [-s] [-k] [-j [N]] [-p] [-I DIR] [-e] [NAME=VALUE]... [GOAL]...",
    )
    print("       mk --help")
    print("       mk --version")
    print("")
    print("  -p         print the parsed database (variables sorted, rules in file order)")
    print("  -n         print recipes without running them")
    print("  -s         silent mode (do not print recipes)")
    print("  -k         keep going after a failure")
    print("  -j [N]     allow up to N jobs at once; no N: no limit")
    print("  -f FILE    read FILE as the Makefile")
    print("  -C DIR     change to DIR before doing anything")
    print("  -I DIR     search DIR for included makefiles")
    print("  -e         environment variables override Makefile assignments")
    print("  --version  print the version and exit")
    print("  NAME=VALUE set a variable from the command line")
    0
}

/// A parse error with a description.
struct ParseError {
    kind: str,
    arg: str,
}

/// Parse a single argument. Returns the kind of token found.
fn parse_arg(arg: str) -> str {
    if arg == "--help" {
        return "help"
    }
    if arg == "--version" {
        return "version"
    }
    if arg == "--debug-opts" {
        return "debug"
    }
    if arg == "-n" {
        return "dry_run"
    }
    if arg == "-s" {
        return "silent"
    }
    if arg == "-k" {
        return "keep_going"
    }
    if arg == "-p" {
        return "print_db"
    }
    if arg == "-e" {
        return "env_wins"
    }
    if arg == "-f" {
        return "file_flag"
    }
    if arg == "-C" {
        return "dir_flag"
    }
    if arg == "-j" || arg.starts_with("-j") {
        return "jobs_flag"
    }
    if arg == "-I" || arg.starts_with("-I") {
        return "include_dir_flag"
    }
    if arg.contains("=") {
        return "override"
    }
    if arg.starts_with("-") {
        return "unknown"
    }
    return "goal"
}

/// Extract the number from a -j flag using slicing.
fn extract_jobs(arg: str) -> int {
    if arg == "-j" {
        return 0
    }
    let rest = arg[2..]
    if rest.len == 0 {
        return 0
    }
    let n = rest.to_int() else 0
    if n <= 0 {
        return 0
    }
    return n
}

/// Print the parsed flags in a debug format.
fn print_flags(f: Flags) {
    if f.files.len > 0 {
        print("files: {str.join(" ", f.files)}")
    } else {
        print("files: (none, will use Makefile)")
    }
    print("dir: {f.dir}")
    print("dry_run: {f.dry_run}")
    print("silent: {f.silent}")
    print("keep_going: {f.keep_going}")
    print("jobs: {f.jobs}")
    print("print_db: {f.print_db}")
    print("overrides: {f.overrides.len} items")
    for o in f.overrides {
        print("  {o}")
    }
    print("goals: {f.goals.len} items")
    for g in f.goals {
        print("  {g}")
    }
}

/// Print the usage text to stderr.
fn print_usage_stderr() {
    eprint("Usage: mk [-f FILE] [-C DIR] [-n] [-s] [-k] [-j [N]] [-p] [NAME=VALUE]... [GOAL]...")
    eprint("       mk --help")
}

/// Parse the CLI arguments into a Flags struct.
fn parse_flags(args: List[str]) -> Flags ! {help, version, Parse(ParseError)} {
    var f = Flags {
        files: List[str](),
        dir: "",
        dry_run: false,
        silent: false,
        keep_going: false,
        jobs: 1,
        print_db: false,
        overrides: List[str](),
        goals: List[str](),
        include_dirs: List[str](),
        env_wins: false,
    }
    var i = 0
    while i < args.len {
        let arg = args[i]
        let kind = parse_arg(arg)
        if kind == "help" {
            return help
        }
        if kind == "version" {
            return version
        }
        if kind == "debug" {
            i += 1
            continue
        }
        if kind == "dry_run" {
            f.dry_run = true
            i += 1
            continue
        }
        if kind == "silent" {
            f.silent = true
            i += 1
            continue
        }
        if kind == "keep_going" {
            f.keep_going = true
            i += 1
            continue
        }
        if kind == "print_db" {
            f.print_db = true
            i += 1
            continue
        }
        if kind == "env_wins" {
            f.env_wins = true
            i += 1
            continue
        }
        if kind == "file_flag" {
            if i + 1 >= args.len {
                return Parse(ParseError { kind: "missing_arg", arg: "-f" })
            }
            (mut f.files).push(args[i + 1])
            i += 2
            continue
        }
        if kind == "dir_flag" {
            if i + 1 >= args.len {
                return Parse(ParseError { kind: "missing_arg", arg: "-C" })
            }
            f.dir = args[i + 1]
            i += 2
            continue
        }
        if kind == "jobs_flag" {
            if arg == "-j" {
                if i + 1 < args.len {
                    let next = args[i + 1]
                    let n = next.to_int() else {
                        // Not a number; treat it as a goal
                        (mut f.goals).push(next)
                        i += 2
                        continue
                    }
                    if n <= 0 {
                        return Parse(ParseError { kind: "bad_jobs", arg: arg })
                    }
                    f.jobs = n
                    i += 2
                } else {
                    // -j is the last argument; no limit
                    f.jobs = 0
                    i += 1
                }
            } else {
                let n = extract_jobs(arg)
                if n <= 0 {
                    return Parse(ParseError { kind: "bad_jobs", arg: arg })
                }
                f.jobs = n
                i += 1
            }
            continue
        }
        if kind == "include_dir_flag" {
            // -I DIR or -IDIR
            if arg == "-I" {
                if i + 1 >= args.len {
                    return Parse(ParseError { kind: "missing_arg", arg: "-I" })
                }
                (mut f.include_dirs).push(args[i + 1])
                i += 2
            } else {
                // -IDIR
                let dir = arg[2..]
                if dir.len == 0 {
                    return Parse(ParseError { kind: "missing_arg", arg: "-I" })
                }
                (mut f.include_dirs).push(dir)
                i += 1
            }
            continue
        }
        if kind == "override" {
            (mut f.overrides).push(arg)
            i += 1
            continue
        }
        if kind == "unknown" {
            if arg.starts_with("--") {
                return Parse(ParseError { kind: "unrecognized", arg: arg })
            }
            return Parse(ParseError { kind: "invalid", arg: arg })
        }
        if kind == "goal" {
            (mut f.goals).push(arg)
            i += 1
            continue
        }
        return Parse(ParseError { kind: "unknown", arg: arg })
    }
    return f
}

/// Parse the Makefile(s) and build the graph. Returns the database and graph.
fn parse_and_build(
    files: List[str],
    mut v: Vars,
    cli_names: Map[str, int],
    include_dirs: List[str],
    env_wins: bool,
    env_names: Map[str, int],
    primary_file: str,
    makelevel: int,
) -> (Database, Graph) ! {parse, Parse(ParseErr), io} {
    let db = parse_makefile_files(
        files,
        mut v,
        cli_names,
        include_dirs,
        env_wins,
        env_names,
    ) else |e| match e {
        parse => return parse,
        Parse(p) => return Parse(p),
        io => return io,
    }
    if db.refusals.len > 0 {
        let r = db.refusals[0]
        eprint("{mk_prefix(makelevel)} {primary_file}:{r.line}: {r.kind}")
        return parse
    }
    let g = build_graph(db, v, primary_file) else |e| match e {
        Unterminated(l) => {
            eprint("{primary_file}:{l}: *** unterminated variable reference.  Stop.")
            return parse
        },
        Cycle(l, n) => {
            eprint(
                "{primary_file}:{l}: *** Recursive variable '{n}' references itself (eventually).  Stop.",
            )
            return parse
        },
        Refuse(l, msg) => {
            eprint(refusal_text("mk: ", primary_file, l, msg))
            return parse
        },
    }
    return (db, g)
}

/// Parse MAKEFLAGS from the environment and merge into the flags.
/// MAKEFLAGS contains single-letter flags (k, n, s) and optionally " -jN".
/// CLI flags take precedence over environment flags.
fn merge_env_flags(mut f: Flags) {
    // Only apply MAKEFLAGS if it's in the environment (i.e., we're a sub-make)
    let makeflags = env.get("MAKEFLAGS") else ""
    if makeflags.len == 0 {
        return
    }
    // Parse the flags: single-letter flags (k, n, s) and " -jN"
    // CLI flags take precedence, so only apply env flags if the CLI didn't set them
    var i = 0
    while i < makeflags.len {
        let c = makeflags[i..i + 1]
        if c == "k" && !f.keep_going {
            f.keep_going = true
        } else if c == "n" && !f.dry_run {
            f.dry_run = true
        } else if c == "s" && !f.silent {
            f.silent = true
        } else if c == " " {
            // Look for -jN
            let rest = makeflags[i + 1..]
            if rest.starts_with("-j") {
                if f.jobs <= 1 {
                    // CLI didn't set -j; parse the env value
                    let jrest = rest[2..]
                    let n = jrest.to_int() else 0
                    if n > 0 {
                        f.jobs = n
                    }
                }
            }
        }
        i += 1
    }
}

fn run(mut f: Flags) -> int {
    // Merge MAKEFLAGS from the environment (for sub-makes)
    merge_env_flags(mut f)
    // First, collect CLI override names
    var cli_names = Map[str, int]()
    for o in f.overrides {
        let eq = o.find("=") else {
            continue
        }
        let name = o[0..eq]
        map.set(mut cli_names, name, 1)
    }
    // Seed the variable table with command-line overrides (origin: "cli", exported)
    var v = new_vars()
    for o in f.overrides {
        let eq = o.find("=") else {
            continue
        }
        let name = o[0..eq]
        let value = o[eq + 1..]
        set_var_origin(mut v, name, value, "=", 0, "cli")
        // CLI variables are always exported
        set_var_exported(mut v, name, true)
    }
    // Build a map of environment variable names (for origin tracking)
    var env_names = Map[str, int]()
    for ev in env_vars() {
        // ev is "NAME=VALUE"; extract the name
        let eq = ev.find("=") else {
            continue
        }
        let name = ev[0..eq]
        map.set(mut env_names, name, 1)
    }
    // Set special variables: MAKE, CURDIR, MAKEFILE_LIST, MAKEFLAGS, MAKELEVEL, .DEFAULT_GOAL
    // MAKE: the program as invoked. wolf has env_arg0() only from 0.2.36; until then the literal "mk"
    set_var(mut v, "MAKE", "mk", "=", 0)
    // CURDIR: the working directory after -C (the physical path, symlinks resolved)
    let curdir = env.cwd() else |_| ""
    set_var(mut v, "CURDIR", curdir, ":=", 0)
    // Determine the files to read: if -f was given, use those; otherwise use "Makefile"
    var files = List[str]()
    if f.files.len > 0 {
        for file in f.files {
            (mut files).push(file)
        }
    } else {
        (mut files).push("Makefile")
    }
    // MAKEFILE_LIST: the list of files read (space-separated)
    set_var(mut v, "MAKEFILE_LIST", str.join(" ", files), "=", 0)
    // MAKECMDGOALS: the goals given on the command line, space-joined (empty when none)
    set_var(mut v, "MAKECMDGOALS", str.join(" ", f.goals), "=", 0)
    // Use the first file as the primary makefile name for error messages
    let primary_file = files[0]
    // MAKEFLAGS: the single-letter flags given, in gmake's spelling
    // -k → k, -n → n, -s → s, -j N → " -jN" (leading space separates from letter flags)
    // The jobserver word (--jobserver-auth=…) is track 05's — we strip it and document the difference
    var makeflags = ""
    if f.keep_going {
        makeflags = makeflags + "k"
    }
    if f.dry_run {
        makeflags = makeflags + "n"
    }
    if f.silent {
        makeflags = makeflags + "s"
    }
    if f.jobs > 1 {
        makeflags = makeflags + " -j{f.jobs}"
    }
    if makeflags.len > 0 {
        set_var(mut v, "MAKEFLAGS", makeflags, "=", 0)
    } else {
        set_var(mut v, "MAKEFLAGS", "", "=", 0)
    }
    // MAKELEVEL: read from the environment at start (default 0)
    let makelevel_str = env.get("MAKELEVEL") else "0"
    let makelevel = makelevel_str.to_int() else 0
    set_var(mut v, "MAKELEVEL", "{makelevel}", "=", 0)
    // Export MAKELEVEL as MAKELEVEL + 1 to recipes
    set_var_exported(mut v, "MAKELEVEL", true)
    // Export MAKEFLAGS to recipes
    set_var_exported(mut v, "MAKEFLAGS", true)
    // Track whether we've already restarted (gmake restarts at most until nothing changes;
    // one restart suffices for our witnesses)
    var restarted = false
    // The MAKELEVEL for this invocation (used for the [N] prefix)
    let my_level = makelevel
    // Every -f file is named before stopping, as gmake does
    if f.files.len > 0 {
        var first_missing = ""
        for file in files {
            if !fs.exists(file) {
                eprint("{mk_prefix(my_level)} {file}: No such file or directory")
                if first_missing.len == 0 {
                    first_missing = file
                }
            }
        }
        if first_missing.len > 0 {
            eprint("{mk_prefix(my_level)} *** No rule to make target '{first_missing}'.  Stop.")
            return 2
        }
    }
    if f.print_db {
        let (db, _) = parse_and_build(
            files,
            mut v,
            cli_names,
            f.include_dirs,
            f.env_wins,
            env_names,
            primary_file,
            my_level,
        ) else |e| match e {
            parse => {
                return 2
            },
            Parse(p) => {
                eprint("{p.file}:{p.line}: *** {p.message}.  Stop.")
                return 2
            },
            io => {
                if !fs.exists(primary_file) {
                    eprint("{mk_prefix(my_level)} {primary_file}: No such file or directory")
                    eprint(
                        "{mk_prefix(my_level)} *** No rule to make target '{primary_file}'.  Stop.",
                    )
                } else {
                    eprint("mk: cannot read {primary_file}")
                }
                return 2
            },
        }
        print_database(db, v, primary_file) else |e| {
            return 2
        }
        return 0
    }
    // Parse and build the graph, potentially restarting if included files need remaking
    var (db, g) = parse_and_build(
        files,
        mut v,
        cli_names,
        f.include_dirs,
        f.env_wins,
        env_names,
        primary_file,
        my_level,
    ) else |e| match e {
        parse => {
            return 2
        },
        Parse(p) => {
            eprint("{p.file}:{p.line}: *** {p.message}.  Stop.")
            return 2
        },
        io => {
            if !fs.exists(primary_file) {
                eprint("mk: {primary_file}: No such file or directory")
                eprint("mk: *** No rule to make target '{primary_file}'.  Stop.")
            } else {
                eprint("mk: cannot read {primary_file}")
            }
            return 2
        },
    }
    // Check if any included file needs remaking or is missing with a rule
    var needs_restart = false
    var missing_with_rule = false
    for inc in db.included_files {
        if !map.has(g.nodes, inc.path) {
            continue
        }
        if !inc.found {
            // The file is missing but has a rule to build it
            missing_with_rule = true
            break
        }
        // Check if the file is out of date
        var built = Map[str, int]()
        if is_out_of_date(g, inc.path, built) {
            needs_restart = true
            break
        }
    }
    // If an included file needs remaking or is missing with a rule, build it and restart (once)
    if (needs_restart || missing_with_rule) && !restarted {
        restarted = true
        // Build the included files that need remaking or are missing with a rule
        var built = Map[str, int]()
        for inc in db.included_files {
            if !map.has(g.nodes, inc.path) {
                continue
            }
            if !inc.found || is_out_of_date(g, inc.path, built) {
                // A missing include whose remake cannot succeed is named first, as gmake does
                if !inc.found && !inc.optional && remake_blocked(g, inc.path, 0) {
                    eprint("{primary_file}:{inc.line}: {inc.path}: No such file or directory")
                }
                let result = build_recursive(
                    g,
                    v,
                    inc.path,
                    f.silent,
                    f.dry_run,
                    true,
                    f.keep_going,
                    mut built,
                    "\n",
                    "",
                    primary_file,
                    my_level,
                )
                if !result.success {
                    return result.exit_code
                }
            }
        }
        // Re-parse and re-build
        let (new_db, new_g) = parse_and_build(
            files,
            mut v,
            cli_names,
            f.include_dirs,
            f.env_wins,
            env_names,
            primary_file,
            my_level,
        ) else |e| match e {
            parse => {
                return 2
            },
            Parse(p) => {
                eprint("{p.file}:{p.line}: *** {p.message}.  Stop.")
                return 2
            },
            io => {
                if !fs.exists(primary_file) {
                    eprint("{mk_prefix(my_level)} {primary_file}: No such file or directory")
                    eprint(
                        "{mk_prefix(my_level)} *** No rule to make target '{primary_file}'.  Stop.",
                    )
                } else {
                    eprint("mk: cannot read {primary_file}")
                }
                return 2
            },
        }
        db = new_db
        g = new_g
    }
    // Report missing includes that have no rule to build them
    // (after the restart, so the graph is final)
    // Report only the FIRST missing include, as gmake does
    var has_missing_hard = false
    for inc in db.included_files {
        if inc.found {
            continue
        }
        // The file is missing
        if map.has(g.nodes, inc.path) {
            // It has a rule; it was built above (or will be built as a goal)
            continue
        }
        // No rule to build it
        if !inc.optional {
            // Hard include: error
            has_missing_hard = true
            eprint("{primary_file}:{inc.line}: {inc.path}: No such file or directory")
            break
        }
        // Soft include: silent
    }
    if has_missing_hard {
        // Print the "No rule" line for the first missing hard include
        for inc in db.included_files {
            if inc.found {
                continue
            }
            if map.has(g.nodes, inc.path) {
                continue
            }
            if !inc.optional {
                eprint("{mk_prefix(my_level)} *** No rule to make target '{inc.path}'.  Stop.")
                break
            }
        }
        return 2
    }
    // Export the environment for recipes
    export_environment(v) else |e| match e {
        invalid => {
            eprint("mk: *** invalid variable name.  Stop.")
            return 2
        },
    }
    // Set .DEFAULT_GOAL: the first target in the file, if not already set by the Makefile.
    // If the Makefile set .DEFAULT_GOAL, use that value as the default goal.
    // If the value names more than one word, refuse it.
    if f.goals.len == 0 {
        // No goals on the command line; use .DEFAULT_GOAL if set, else the first target
        let default_goal = var_value(v, ".DEFAULT_GOAL")
        if default_goal.len > 0 {
            // .DEFAULT_GOAL was set by the Makefile
            let words = default_goal.words()
            if words.len > 1 {
                eprint("mk: *** .DEFAULT_GOAL contains more than one target.  Stop.")
                return 2
            }
            (mut f.goals).push(default_goal)
        } else if g.order.len > 0 {
            // .DEFAULT_GOAL was not set; use the first target
            (mut f.goals).push(g.order[0])
            // Set .DEFAULT_GOAL to the first target (for -p output)
            set_var(mut v, ".DEFAULT_GOAL", g.order[0], "=", 0)
        }
    } else {
        // Goals were given on the command line; set .DEFAULT_GOAL to the first target
        // (for -p output) only if it wasn't already set by the Makefile
        let default_goal = var_value(v, ".DEFAULT_GOAL")
        if default_goal.len == 0 && g.order.len > 0 {
            set_var(mut v, ".DEFAULT_GOAL", g.order[0], "=", 0)
        }
    }
    // If there are no goals and no targets, print "No targets. Stop." and exit 2.
    if f.goals.len == 0 && g.order.len == 0 {
        eprint("mk: *** No targets.  Stop.")
        return 2
    }
    // Build the goals
    let exit_code = build_goals(
        g,
        v,
        mut f.goals,
        f.silent,
        f.dry_run,
        f.keep_going,
        f.jobs,
        primary_file,
        my_level,
    )
    return exit_code
}

fn main() -> !int {
    let args = env.args()
    var debug = false
    var i = 0
    while i < args.len {
        if args[i] == "--debug-opts" {
            debug = true
        }
        i += 1
    }
    if debug {
        let f = parse_flags(args) else |e| match e {
            help => {
                print_usage()
                return 0
            },
            version => {
                print("mk {VERSION} (built with wolf {WOLF_VERSION})")
                return 0
            },
            Parse(p) => {
                if p.kind == "invalid" {
                    eprint("mk: invalid option -- {p.arg[1..]}")
                } else if p.kind == "missing_arg" {
                    eprint("mk: option requires an argument -- {p.arg[1..]}")
                } else if p.kind == "bad_jobs" {
                    eprint("mk: the '-j' option requires a positive integer argument")
                } else if p.kind == "unrecognized" {
                    eprint("mk: unrecognized option '{p.arg}'")
                } else {
                    eprint("mk: invalid option -- {p.arg[1..]}")
                }
                print_usage_stderr()
                return 2
            },
        }
        print_flags(f)
        return 0
    }
    let f = parse_flags(args) else |e| match e {
        help => {
            print_usage()
            return 0
        },
        version => {
            print("mk {VERSION} (built with wolf {WOLF_VERSION})")
            return 0
        },
        Parse(p) => {
            if p.kind == "invalid" {
                eprint("mk: invalid option -- {p.arg[1..]}")
            } else if p.kind == "missing_arg" {
                eprint("mk: option requires an argument -- {p.arg[1..]}")
            } else if p.kind == "bad_jobs" {
                eprint("mk: the '-j' option requires a positive integer argument")
            } else if p.kind == "unrecognized" {
                eprint("mk: unrecognized option '{p.arg}'")
            } else {
                eprint("mk: invalid option -- {p.arg[1..]}")
            }
            print_usage_stderr()
            return 2
        },
    }
    // Change directory if -C is used. If it fails, print the error and exit 2.
    var abs_dir = ""
    // Read MAKELEVEL from the environment (for the [N] prefix)
    let level = (env.get("MAKELEVEL") else "0").to_int() else 0
    if f.dir.len > 0 {
        env.set_cwd(f.dir) else |e| match e {
            io => {
                // -C failed; print the error with Entering/Leaving around it
                abs_dir = env.cwd() else |_| ""
                print("{mk_prefix(level)} Entering directory '{abs_dir}'")
                eprint("{mk_prefix(level)} *** {f.dir}: No such file or directory.  Stop.")
                print("{mk_prefix(level)} Leaving directory '{abs_dir}'")
                return 2
            },
            denied => {
                // -C failed; print the error with Entering/Leaving around it
                abs_dir = env.cwd() else |_| ""
                print("{mk_prefix(level)} Entering directory '{abs_dir}'")
                eprint("{mk_prefix(level)} *** {f.dir}: No such file or directory.  Stop.")
                print("{mk_prefix(level)} Leaving directory '{abs_dir}'")
                return 2
            },
            not_found => {
                // -C failed; print the error with Entering/Leaving around it
                abs_dir = env.cwd() else |_| ""
                print("{mk_prefix(level)} Entering directory '{abs_dir}'")
                eprint("{mk_prefix(level)} *** {f.dir}: No such file or directory.  Stop.")
                print("{mk_prefix(level)} Leaving directory '{abs_dir}'")
                return 2
            },
        }
        // Get the physical absolute path (symlinks resolved), same as gmake prints
        abs_dir = env.cwd() else |_| f.dir
        print("{mk_prefix(level)} Entering directory '{abs_dir}'")
    }
    let status = run(mut f)
    // Print "Leaving directory" if -C was used
    if f.dir.len > 0 {
        print("{mk_prefix(level)} Leaving directory '{abs_dir}'")
    }
    return status
}

/// Whether remaking `name` must fail before any recipe runs: a prerequisite at
/// any depth that is neither a file on disk nor a target with a rule.
fn remake_blocked(g: Graph, name: str, depth: int) -> bool {
    if depth > 64 {
        return false
    }
    let node = map.get(g.nodes, name) else {
        return !fs.exists(name)
    }
    for p in node.prereqs {
        if remake_blocked(g, p, depth + 1) {
            return true
        }
    }
    return false
}
