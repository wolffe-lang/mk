//! main.lu — flags, goals, exit status, -p output.
//!
//! File layout (the module is one directory):
//!   main.lu     — flags, goals, exit status, -p output (this file)
//!   parse.lu    — Makefile parser: lines, continuations, assignments, rules, recipes
//!   vars.lu     — variable table, expansion, automatic variables
//!   graph.lu    — dependency graph, DFS, cycle detection, out-of-date decision
//!   run.lu      — scheduler: ready queue, parallel execution, -n/-s/-k
//!   mk_test.lu  — unit tests for the parser and variable flavours
//!
//! This file parses the CLI flags of README §4:
//!   mk [-f FILE] [-C DIR] [-n] [-s] [-k] [-j [N]] [-p] [NAME=VALUE]... [GOAL]...
//!   mk --help
//!   mk --version
//! and prints the parsed structure with --debug-opts.

use std.env
use std.fs
use std.str
use std.map

/// The version string, embedded at build time.
let VERSION: str = "0.2.2"

let WOLF_VERSION: str = "0.2.34"

/// Parsed CLI flags for mk.
struct Flags {
    file: str,
    dir: str,
    dry_run: bool,
    silent: bool,
    keep_going: bool,
    jobs: int,
    print_db: bool,
    overrides: List[str],
    goals: List[str],
}

/// Print usage and exit 0.
fn print_usage() -> int {
    print("Usage: mk [-f FILE] [-C DIR] [-n] [-s] [-k] [-j [N]] [-p] [NAME=VALUE]... [GOAL]...")
    print("       mk --help")
    print("       mk --version")
    print("")
    print("  -p         print the parsed database (variables sorted, rules in file order)")
    print("  -n         print recipes without running them")
    print("  -s         silent mode (do not print recipes)")
    print("  -k         keep going after a failure")
    print("  -j [N]     allow up to N jobs at once; no N: no limit")
    print("  -f FILE    read FILE as the Makefile")
    print("  -C DIR     change to DIR before doing anything")
    print("  --version  print the version and exit")
    print("  NAME=VALUE set a variable from the command line")
    0
}

/// A parse error with a description.
struct ParseError {
    kind: str,
    arg: str,
}

/// Parse a single argument. Returns the kind of token found.
fn parse_arg(arg: str) -> str {
    if arg == "--help" {
        return "help"
    }
    if arg == "--version" {
        return "version"
    }
    if arg == "--debug-opts" {
        return "debug"
    }
    if arg == "-n" {
        return "dry_run"
    }
    if arg == "-s" {
        return "silent"
    }
    if arg == "-k" {
        return "keep_going"
    }
    if arg == "-p" {
        return "print_db"
    }
    if arg == "-f" {
        return "file_flag"
    }
    if arg == "-C" {
        return "dir_flag"
    }
    if arg == "-j" || arg.starts_with("-j") {
        return "jobs_flag"
    }
    if arg.contains("=") {
        return "override"
    }
    if arg.starts_with("-") {
        return "unknown"
    }
    return "goal"
}

/// Extract the number from a -j flag using slicing.
fn extract_jobs(arg: str) -> int {
    if arg == "-j" {
        return 0
    }
    let rest = arg[2..]
    if rest.len == 0 {
        return 0
    }
    let n = rest.to_int() else 0
    if n <= 0 {
        return 0
    }
    return n
}

/// Print the parsed flags in a debug format.
fn print_flags(f: Flags) {
    print("file: {f.file}")
    print("dir: {f.dir}")
    print("dry_run: {f.dry_run}")
    print("silent: {f.silent}")
    print("keep_going: {f.keep_going}")
    print("jobs: {f.jobs}")
    print("print_db: {f.print_db}")
    print("overrides: {f.overrides.len} items")
    for o in f.overrides {
        print("  {o}")
    }
    print("goals: {f.goals.len} items")
    for g in f.goals {
        print("  {g}")
    }
}

/// Print the usage text to stderr.
fn print_usage_stderr() {
    eprint("Usage: mk [-f FILE] [-C DIR] [-n] [-s] [-k] [-j [N]] [-p] [NAME=VALUE]... [GOAL]...")
    eprint("       mk --help")
}

/// Parse the CLI arguments into a Flags struct.
fn parse_flags(args: List[str]) -> Flags ! {help, version, Parse(ParseError)} {
    var f = Flags {
        file: "Makefile",
        dir: "",
        dry_run: false,
        silent: false,
        keep_going: false,
        jobs: 1,
        print_db: false,
        overrides: List[str](),
        goals: List[str](),
    }
    var i = 0
    while i < args.len {
        let arg = args[i]
        let kind = parse_arg(arg)
        if kind == "help" {
            return help
        }
        if kind == "version" {
            return version
        }
        if kind == "debug" {
            i += 1
            continue
        }
        if kind == "dry_run" {
            f.dry_run = true
            i += 1
            continue
        }
        if kind == "silent" {
            f.silent = true
            i += 1
            continue
        }
        if kind == "keep_going" {
            f.keep_going = true
            i += 1
            continue
        }
        if kind == "print_db" {
            f.print_db = true
            i += 1
            continue
        }
        if kind == "file_flag" {
            if i + 1 >= args.len {
                return Parse(ParseError { kind: "missing_arg", arg: "-f" })
            }
            f.file = args[i + 1]
            i += 2
            continue
        }
        if kind == "dir_flag" {
            if i + 1 >= args.len {
                return Parse(ParseError { kind: "missing_arg", arg: "-C" })
            }
            f.dir = args[i + 1]
            i += 2
            continue
        }
        if kind == "jobs_flag" {
            if arg == "-j" {
                if i + 1 < args.len {
                    let next = args[i + 1]
                    let n = next.to_int() else {
                        // Not a number; treat it as a goal
                        (mut f.goals).push(next)
                        i += 2
                        continue
                    }
                    if n <= 0 {
                        return Parse(ParseError { kind: "bad_jobs", arg: arg })
                    }
                    f.jobs = n
                    i += 2
                } else {
                    // -j is the last argument; no limit
                    f.jobs = 0
                    i += 1
                }
            } else {
                let n = extract_jobs(arg)
                if n <= 0 {
                    return Parse(ParseError { kind: "bad_jobs", arg: arg })
                }
                f.jobs = n
                i += 1
            }
            continue
        }
        if kind == "override" {
            (mut f.overrides).push(arg)
            i += 1
            continue
        }
        if kind == "unknown" {
            if arg.starts_with("--") {
                return Parse(ParseError { kind: "unrecognized", arg: arg })
            }
            return Parse(ParseError { kind: "invalid", arg: arg })
        }
        if kind == "goal" {
            (mut f.goals).push(arg)
            i += 1
            continue
        }
        return Parse(ParseError { kind: "unknown", arg: arg })
    }
    return f
}

/// Parse the Makefile and build the variable table.
/// `cli_names` is the set of variable names that were set on the command line.
/// Assignments to those names are ignored (the command-line value wins).
fn build_vars(db: Database, cli_names: Map[str, int]) -> Vars {
    var v = new_vars()
    for a in db.assignments {
        // If this name was set on the command line, skip the Makefile assignment
        if map.has(cli_names, a.name) {
            continue
        }
        set_var(mut v, a.name, a.value, a.op)
    }
    return v
}

fn run(mut f: Flags) -> int {
    if f.print_db {
        let db = parse_makefile_file(f.file) else |e| match e {
            parse => {
                return 2
            },
            Parse(p) => {
                eprint("{p.file}:{p.line}: *** {p.message}.  Stop.")
                return 2
            },
            io => {
                // Check if the file exists
                if !fs.exists(f.file) {
                    eprint("mk: {f.file}: No such file or directory")
                    eprint("mk: *** No rule to make target '{f.file}'.  Stop.")
                } else {
                    eprint("mk: cannot read {f.file}")
                }
                return 2
            },
        }
        if db.refusals.len > 0 {
            // Print only the first refusal on stderr with the correct format
            let r = db.refusals[0]
            eprint("mk: {f.file}:{r.line}: {r.kind}")
            return 2
        }
        // Build the variable table for expansion
        // First, collect CLI override names
        var cli_names = Map[str, int]()
        for o in f.overrides {
            let eq = o.find("=") else {
                continue
            }
            let name = o[0..eq]
            map.set(mut cli_names, name, 1)
        }
        // Seed the variable table with command-line overrides
        var v = new_vars()
        for o in f.overrides {
            let eq = o.find("=") else {
                continue
            }
            let name = o[0..eq]
            let value = o[eq + 1..]
            set_var(mut v, name, value, ":=")
        }
        // Now process Makefile assignments, skipping CLI names
        for a in db.assignments {
            if map.has(cli_names, a.name) {
                continue
            }
            set_var(mut v, a.name, a.value, a.op)
        }
        print_database(db, v)
        return 0
    }
    // Parse the Makefile
    let db = parse_makefile_file(f.file) else |e| match e {
        parse => {
            return 2
        },
        Parse(p) => {
            eprint("{p.file}:{p.line}: *** {p.message}.  Stop.")
            return 2
        },
        io => {
            // Check if the file exists
            if !fs.exists(f.file) {
                eprint("mk: {f.file}: No such file or directory")
                eprint("mk: *** No rule to make target '{f.file}'.  Stop.")
            } else {
                eprint("mk: cannot read {f.file}")
            }
            return 2
        },
    }
    if db.refusals.len > 0 {
        // Print only the first refusal on stderr with the correct format
        let r = db.refusals[0]
        eprint("mk: {f.file}:{r.line}: {r.kind}")
        return 2
    }
    // Build the variable table
    // First, collect CLI override names
    var cli_names = Map[str, int]()
    for o in f.overrides {
        let eq = o.find("=") else {
            continue
        }
        let name = o[0..eq]
        map.set(mut cli_names, name, 1)
    }
    // Seed the variable table with command-line overrides
    var v = new_vars()
    for o in f.overrides {
        let eq = o.find("=") else {
            continue
        }
        let name = o[0..eq]
        let value = o[eq + 1..]
        set_var(mut v, name, value, ":=")
    }
    // Now process Makefile assignments, skipping CLI names
    for a in db.assignments {
        if map.has(cli_names, a.name) {
            continue
        }
        set_var(mut v, a.name, a.value, a.op)
    }
    // Build the graph
    let g = build_graph(db, v)
    // Build the goals
    let exit_code = build_goals(
        g,
        v,
        mut f.goals,
        f.silent,
        f.dry_run,
        f.keep_going,
        f.jobs,
        f.file,
    )
    return exit_code
}

fn main() -> !int {
    let args = env.args()
    var debug = false
    var i = 0
    while i < args.len {
        if args[i] == "--debug-opts" {
            debug = true
        }
        i += 1
    }
    if debug {
        let f = parse_flags(args) else |e| match e {
            help => {
                print_usage()
                return 0
            },
            version => {
                print("mk {VERSION} (built with wolf {WOLF_VERSION})")
                return 0
            },
            Parse(p) => {
                if p.kind == "invalid" {
                    eprint("mk: invalid option -- {p.arg[1..]}")
                } else if p.kind == "missing_arg" {
                    eprint("mk: option requires an argument -- {p.arg[1..]}")
                } else if p.kind == "bad_jobs" {
                    eprint("mk: the '-j' option requires a positive integer argument")
                } else if p.kind == "unrecognized" {
                    eprint("mk: unrecognized option '{p.arg}'")
                } else {
                    eprint("mk: invalid option -- {p.arg[1..]}")
                }
                print_usage_stderr()
                return 2
            },
        }
        print_flags(f)
        return 0
    }
    let f = parse_flags(args) else |e| match e {
        help => {
            print_usage()
            return 0
        },
        version => {
            print("mk {VERSION} (built with wolf {WOLF_VERSION})")
            return 0
        },
        Parse(p) => {
            if p.kind == "invalid" {
                eprint("mk: invalid option -- {p.arg[1..]}")
            } else if p.kind == "missing_arg" {
                eprint("mk: option requires an argument -- {p.arg[1..]}")
            } else if p.kind == "bad_jobs" {
                eprint("mk: the '-j' option requires a positive integer argument")
            } else if p.kind == "unrecognized" {
                eprint("mk: unrecognized option '{p.arg}'")
            } else {
                eprint("mk: invalid option -- {p.arg[1..]}")
            }
            print_usage_stderr()
            return 2
        },
    }
    // Change directory if -C is used. If it fails, use the current directory.
    var abs_dir = ""
    if f.dir.len > 0 {
        env.set_cwd(f.dir) else |e| match e {
            io => {
                // -C failed; use current directory
                abs_dir = env.cwd() else |_| ""
                print("mk: Entering directory '{abs_dir}'")
                let status = run(mut f)
                print("mk: Leaving directory '{abs_dir}'")
                return 2
            },
            denied => {
                // -C failed; use current directory
                abs_dir = env.cwd() else |_| ""
                print("mk: Entering directory '{abs_dir}'")
                let status = run(mut f)
                print("mk: Leaving directory '{abs_dir}'")
                return 2
            },
            not_found => {
                // -C failed; use current directory
                abs_dir = env.cwd() else |_| ""
                print("mk: Entering directory '{abs_dir}'")
                let status = run(mut f)
                print("mk: Leaving directory '{abs_dir}'")
                return 2
            },
        }
        // Get the physical absolute path (symlinks resolved), same as gmake prints
        abs_dir = env.cwd() else |_| f.dir
        print("mk: Entering directory '{abs_dir}'")
    }
    let status = run(mut f)
    // Print "Leaving directory" if -C was used
    if f.dir.len > 0 {
        print("mk: Leaving directory '{abs_dir}'")
    }
    return status
}
