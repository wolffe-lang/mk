subst:
	@echo [$(subst ee,EE,feet on the street)]
patsubst:
	@echo [$(patsubst %.c,%.o,x.c.c bar.c)]
strip:
	@echo [$(strip   a   b  )]
findstring:
	@echo [$(findstring a,a b c)] [$(findstring z,a b c)]
filter:
	@echo [$(filter %.c %.s,foo.c bar.c baz.s ugh.h)]
filter-out:
	@echo [$(filter-out %.c %.s,foo.c bar.c baz.s ugh.h)]
sort:
	@echo [$(sort foo bar lose foo)]
word:
	@echo [$(word 2, foo bar baz)] [$(word 5, foo bar baz)]
wordlist:
	@echo [$(wordlist 2, 3, foo bar baz)] [$(wordlist 3, 2, foo bar baz)]
words:
	@echo [$(words foo bar)]
firstword:
	@echo [$(firstword foo bar baz)]
lastword:
	@echo [$(lastword foo bar baz)]
