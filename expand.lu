//! expand.lu — recursive-descent variable expander.
//!
//! Replaces the old expand in vars.lu. Supports:
//! - $$ → $
//! - $x (single letter) → variable x
//! - $(NAME) and ${NAME} with balanced parens/braces
//! - Computed names: $(A$(B)) reads variable AB's value when B is B
//! - Substitution references: $(VAR:.c=.o) and $(VAR:%.c=%.o)
//! - Function calls: $(foo bar) → refused with "functions are not supported"
//!   for every gmake function name (error, subst, patsubst, strip, findstring,
//!   filter, filter-out, sort, word, wordlist, words, firstword, lastword, dir,
//!   notdir, suffix, basename, addsuffix, addprefix, join, wildcard, realpath,
//!   abspath, if, or, and, intcmp, foreach, file, call, eval, shell, info, let).
//! - Unterminated reference error: expand returns {Unterminated(int, str)} with the line
//! - Recursive self-reference error: expand returns {Cycle(int)} with the line
//! - Function refusal: expand returns {Refuse(int, str)} with the line and message

/// Expand a string, resolving variable references.
/// Returns {Unterminated(int, str)} if a $( or ${ is not closed, carrying the line number.
/// Returns {Cycle(int, str)} if a variable references itself recursively,
/// carrying the line number and the name of the variable that closed the cycle.
/// Returns {Refuse(int, str)} if a gmake function is encountered,
/// carrying the line number and the refusal message.
struct ShellStatus {
    last: int,
}

fn expand(v: Vars, s: str, line: int) -> str ! {
    Unterminated(int, str),
    Cycle(int, str),
    Refuse(int, str),
} {
    let (out, _status) = expand_status(v, s, line)?
    out
}

/// Keep expand's read-only interface; mutable callers can persist the status.
fn expand_status(v: Vars, s: str, line: int) -> (str, int) ! {
    Unterminated(int, str),
    Cycle(int, str),
    Refuse(int, str),
} {
    var st = ShellStatus { last: -1 }
    var w = copy v
    let out = expand_inner(mut st, mut w, s, "", line)?
    (out, st.last)
}

/// Expand in the caller's own table, so what a $(eval …) defines stays.
fn expand_store(mut v: Vars, s: str, line: int) -> str ! {
    Unterminated(int, str),
    Cycle(int, str),
    Refuse(int, str),
} {
    var st = ShellStatus { last: -1 }
    let out = expand_inner(mut st, mut v, s, "", line)?
    store_shell_status(mut v, st.last, line)
    out
}

/// A recipe line under -n or -j: expanded in the table itself, so what a
/// $(eval …) sets stays for the lines and targets after it; .SHELLSTATUS
/// is not kept.
fn expand_recipe(mut v: Vars, s: str, line: int) -> str ! {
    Unterminated(int, str),
    Cycle(int, str),
    Refuse(int, str),
} {
    var st = ShellStatus { last: -1 }
    expand_inner(mut st, mut v, s, "", line)
}

/// gmake's words for an unclosed `$(` or `${`: a call to a function names the
/// function and the missing close; anything else is a variable reference.
fn unterminated_message(rest: str, close: str) -> str {
    var n = 0
    while n < rest.len && rest[n..n + 1] != " " && rest[n..n + 1] != "\t" {
        n += 1
    }
    let name = rest[0..n]
    let named = is_text_function(name) ||
        is_gmake_function(name) ||
        lazy_function_name(rest).len > 0
    if n < rest.len && named {
        return "unterminated call to function '{name}': missing '{close}'"
    }
    "unterminated variable reference"
}

/// Expand with a visiting set for cycle detection.
/// The `visiting` string contains names currently being expanded,
/// separated by newlines, to detect recursive self-references.
fn expand_inner(mut st: ShellStatus, mut v: Vars, s: str, visiting: str, line: int) -> str ! {
    Unterminated(int, str),
    Cycle(int, str),
    Refuse(int, str),
} {
    var result = ""
    var i = 0
    while i < s.len {
        if s[i..i + 1] == "$" {
            if i + 1 >= s.len {
                result = result + "$"
                i += 1
                continue
            }
            let next = s[i + 1..i + 2]
            if next == "$" {
                result = result + "$"
                i += 2
                continue
            }
            if next == "(" {
                // $(...) — find matching close paren
                let rest = s[i + 2..]
                let found = balanced_close(rest, "(", ")") else {
                    return Unterminated(line, unterminated_message(rest, ")"))
                }
                let inside = rest[0..found]
                let lazy = lazy_function_name(inside)
                if lazy.len > 0 {
                    let lval = call_lazy_function(
                        mut st,
                        mut v,
                        lazy,
                        inside,
                        visiting,
                        line,
                    ) else |e| match e {
                        Unterminated(l, m) => return Unterminated(l, m),
                        Cycle(l, n) => return Cycle(l, n),
                        Refuse(l, msg) => return Refuse(l, msg),
                    }
                    result = result + lval
                    i = i + 2 + found + 1
                    continue
                }
                // Expand the inside first (computed names)
                let expanded_inside = expand_inner(
                    mut st,
                    mut v,
                    inside,
                    visiting,
                    line,
                ) else |e| match e {
                    Unterminated(l, m) => return Unterminated(l, m),
                    Cycle(l, n) => return Cycle(l, n),
                    Refuse(l, msg) => return Refuse(l, msg),
                }
                // Check for substitution reference: $(VAR:.c=.o) or $(VAR:%.c=%.o)
                let sub_result = try_substitution(
                    mut st,
                    mut v,
                    expanded_inside,
                    visiting,
                    line,
                ) else |e| match e {
                    Unterminated(l, m) => return Unterminated(l, m),
                    Cycle(l, n) => return Cycle(l, n),
                    Refuse(l, msg) => return Refuse(l, msg),
                }
                if sub_result.len > 0 {
                    result = result + sub_result
                } else
                // Check if it's a function call (contains whitespace)
                if is_whitespace(expanded_inside) {
                    // A function call, or a variable name with spaces
                    let first_word = expanded_inside.words()[0]
                    if is_text_function(first_word) {
                        let fval = call_function(
                            mut st,
                            mut v,
                            first_word,
                            expanded_inside,
                            visiting,
                            line,
                        ) else |e| match e {
                            Unterminated(l, m) => return Unterminated(l, m),
                            Cycle(l, n) => return Cycle(l, n),
                            Refuse(l, msg) => return Refuse(l, msg),
                        }
                        result = result + fval
                    } else {
                        if is_gmake_function(first_word) {
                            return Refuse(line, "functions are not supported")
                        }
                        // Not a known function; treat as a variable name with spaces
                        let val = expand_var(
                            mut st,
                            mut v,
                            expanded_inside,
                            visiting,
                        ) else |e| match e {
                            Unterminated(l, m) => return Unterminated(l, m),
                            Cycle(l, n) => return Cycle(l, n),
                            Refuse(l, msg) => return Refuse(l, msg),
                        }
                        result = result + val
                    }
                } else {
                    // Simple variable reference
                    let val = expand_var(
                        mut st,
                        mut v,
                        expanded_inside,
                        visiting,
                    ) else |e| match e {
                        Unterminated(l, m) => return Unterminated(l, m),
                        Cycle(l, n) => return Cycle(l, n),
                        Refuse(l, msg) => return Refuse(l, msg),
                    }
                    result = result + val
                }
                i = i + 2 + found + 1
                continue
            }
            if next == "{{" {
                // ${...} — find matching close brace
                let rest = s[i + 2..]
                let found = balanced_close(rest, "{{", "}}") else {
                    return Unterminated(line, unterminated_message(rest, "}}"))
                }
                let inside = rest[0..found]
                let lazy = lazy_function_name(inside)
                if lazy.len > 0 {
                    let lval = call_lazy_function(
                        mut st,
                        mut v,
                        lazy,
                        inside,
                        visiting,
                        line,
                    ) else |e| match e {
                        Unterminated(l, m) => return Unterminated(l, m),
                        Cycle(l, n) => return Cycle(l, n),
                        Refuse(l, msg) => return Refuse(l, msg),
                    }
                    result = result + lval
                    i = i + 2 + found + 1
                    continue
                }
                // Expand the inside first (computed names)
                let expanded_inside = expand_inner(
                    mut st,
                    mut v,
                    inside,
                    visiting,
                    line,
                ) else |e| match e {
                    Unterminated(l, m) => return Unterminated(l, m),
                    Cycle(l, n) => return Cycle(l, n),
                    Refuse(l, msg) => return Refuse(l, msg),
                }
                // Check for substitution reference
                let sub_result = try_substitution(
                    mut st,
                    mut v,
                    expanded_inside,
                    visiting,
                    line,
                ) else |e| match e {
                    Unterminated(l, m) => return Unterminated(l, m),
                    Cycle(l, n) => return Cycle(l, n),
                    Refuse(l, msg) => return Refuse(l, msg),
                }
                if sub_result.len > 0 {
                    result = result + sub_result
                } else
                // Check if it's a function call (contains whitespace)
                if is_whitespace(expanded_inside) {
                    // A function call, or a variable name with spaces
                    let first_word = expanded_inside.words()[0]
                    if is_text_function(first_word) {
                        let fval = call_function(
                            mut st,
                            mut v,
                            first_word,
                            expanded_inside,
                            visiting,
                            line,
                        ) else |e| match e {
                            Unterminated(l, m) => return Unterminated(l, m),
                            Cycle(l, n) => return Cycle(l, n),
                            Refuse(l, msg) => return Refuse(l, msg),
                        }
                        result = result + fval
                    } else {
                        if is_gmake_function(first_word) {
                            return Refuse(line, "functions are not supported")
                        }
                        // Not a known function; treat as a variable name with spaces
                        let val = expand_var(
                            mut st,
                            mut v,
                            expanded_inside,
                            visiting,
                        ) else |e| match e {
                            Unterminated(l, m) => return Unterminated(l, m),
                            Cycle(l, n) => return Cycle(l, n),
                            Refuse(l, msg) => return Refuse(l, msg),
                        }
                        result = result + val
                    }
                } else {
                    let val = expand_var(
                        mut st,
                        mut v,
                        expanded_inside,
                        visiting,
                    ) else |e| match e {
                        Unterminated(l, m) => return Unterminated(l, m),
                        Cycle(l, n) => return Cycle(l, n),
                        Refuse(l, msg) => return Refuse(l, msg),
                    }
                    result = result + val
                }
                i = i + 2 + found + 1
                continue
            }
            // $x — single character variable reference
            if is_var_char(next) {
                let val = expand_var(mut st, mut v, next, visiting) else |e| match e {
                    Unterminated(l, m) => return Unterminated(l, m),
                    Cycle(l, n) => return Cycle(l, n),
                    Refuse(l, msg) => return Refuse(l, msg),
                }
                result = result + val
                i += 2
                continue
            }
            // Not a valid reference
            result = result + "$"
            i += 1
            continue
        }
        result = result + s[i..i + 1]
        i += 1
    }
    return result
}

/// Find the position of the matching close character, counting depth.
/// Returns the index of the matching close, or none if not found.
fn balanced_close(s: str, open: str, close: str) -> int ! {none} {
    var depth = 1
    var i = 0
    while i < s.len {
        if s[i..i + 1] == open {
            depth += 1
        } else if s[i..i + 1] == close {
            depth -= 1
            if depth == 0 {
                return i
            }
        }
        i += 1
    }
    return none
}

/// Check if a string contains whitespace.
fn is_whitespace(s: str) -> bool {
    if s.contains(" ") {
        return true
    }
    if s.contains("\t") {
        return true
    }
    return false
}

/// Check if a character is valid in a variable name.
fn is_var_char(c: str) -> bool {
    if c.len != 1 {
        return false
    }
    if c >= "a" && c <= "z" {
        return true
    }
    if c >= "A" && c <= "Z" {
        return true
    }
    if c >= "0" && c <= "9" {
        return true
    }
    if c == "_" {
        return true
    }
    return false
}

/// Check if a name is a gmake function that mk does not implement.
/// These are refused with "functions are not supported" from expand_inner,
/// so the refusal comes from the expander (every $(…) passes here), not
/// from check_refusal's line scan.
fn is_gmake_function(name: str) -> bool {
    // The complete list of gmake functions mk does not implement.
    // patsubst and filter formerly said "pattern rules are not supported";
    // the function name is the refusal, the % inside its arguments is not a pattern rule.
    if name == "word" {
        return true
    }
    if name == "wordlist" {
        return true
    }
    return false
}

/// Expand a variable reference, with cycle detection.
/// Returns the expanded value, or {Cycle(int, str)} if a cycle is detected,
/// carrying the line number and the name of the variable that closed the cycle.
/// Returns {Refuse(int, str)} if a gmake function is encountered in the value.
fn expand_var(mut st: ShellStatus, mut v: Vars, name: str, visiting: str) -> str ! {
    Unterminated(int, str),
    Cycle(int, str),
    Refuse(int, str),
} {
    if name == ".SHELLSTATUS" && st.last >= 0 {
        return "{st.last}"
    }
    // Check if this name is already being visited (cycle detection)
    let needle = "\n{name}\n"
    let found = visiting.find(needle) else -1
    if found >= 0 {
        // Cycle detected — return error with the line of the variable and its name
        let var_line = var_line_of(v, name)
        return Cycle(var_line, name)
    }
    // Get the raw value (var_value checks the environment)
    let raw = var_value(v, name)
    if raw.len == 0 {
        return ""
    }
    // Get the line of this variable
    let var_line = var_line_of(v, name)
    // If the variable is := (immediate), the value is already expanded; return it as-is.
    // Otherwise, expand it.
    let flavour = var_flavour(v, name)
    if flavour == ":=" {
        return raw
    }
    // Expand the value with the updated visiting set
    let new_visiting = "{visiting}{name}\n"
    let expanded = expand_inner(mut st, mut v, raw, new_visiting, var_line) else |e| match e {
        Unterminated(l, m) => return Unterminated(l, m),
        Cycle(l, n) => return Cycle(l, n),
        Refuse(l, msg) => return Refuse(l, msg),
    }
    return expanded
}

/// Try to apply a substitution reference.
/// Returns the result if it's a substitution, or "" if it's not.
fn try_substitution(
    mut st: ShellStatus,
    mut v: Vars,
    inside: str,
    visiting: str,
    line: int,
) -> str ! {Unterminated(int, str), Cycle(int, str), Refuse(int, str)} {
    // Check for : form: $(VAR:.c=.o)
    let colon_pos = inside.find(":") else 0
    if colon_pos > 0 {
        let var_name = inside[0..colon_pos]
        let rest = inside[colon_pos + 1..]
        // Check for % form: $(VAR:%.c=%.o)
        if rest.contains("%") {
            // Pattern substitution
            let eq_pos = rest.find("=") else 0
            if eq_pos > 0 {
                let pattern = rest[0..eq_pos]
                let replacement = rest[eq_pos + 1..]
                let val = expand_var(mut st, mut v, var_name, visiting) else |e| match e {
                    Unterminated(l, m) => return Unterminated(l, m),
                    Cycle(l, n) => return Cycle(l, n),
                    Refuse(l, msg) => return Refuse(l, msg),
                }
                return apply_pattern_sub(val, pattern, replacement)
            }
        } else {
            // Simple substitution: $(VAR:.c=.o)
            let eq_pos = rest.find("=") else 0
            if eq_pos > 0 {
                let from = rest[0..eq_pos]
                let to = rest[eq_pos + 1..]
                let val = expand_var(mut st, mut v, var_name, visiting) else |e| match e {
                    Unterminated(l, m) => return Unterminated(l, m),
                    Cycle(l, n) => return Cycle(l, n),
                    Refuse(l, msg) => return Refuse(l, msg),
                }
                return apply_simple_sub(val, from, to)
            }
        }
    }
    return ""
}

/// Split a string into words (space-separated).
fn split_words(s: str) -> List[str] {
    var result = List[str]()
    var start = 0
    var i = 0
    while i < s.len {
        if s[i..i + 1] == " " || s[i..i + 1] == "\t" {
            if i > start {
                (mut result).push(s[start..i])
            }
            start = i + 1
        }
        i += 1
    }
    if start < s.len {
        (mut result).push(s[start..])
    }
    return result
}

/// Apply a simple substitution: replace trailing `from` with `to` on each word.
fn apply_simple_sub(s: str, from: str, to: str) -> str {
    if from.len == 0 {
        return s
    }
    var result = ""
    var words = split_words(s)
    var i = 0
    while i < words.len {
        let word = words[i]
        if word.ends_with(from) {
            let replaced = word[0..word.len - from.len] + to
            if i > 0 {
                result = result + " "
            }
            result = result + replaced
        } else {
            if i > 0 {
                result = result + " "
            }
            result = result + word
        }
        i += 1
    }
    return result
}

/// Apply a pattern substitution: $(VAR:%.c=%.o)
/// % matches any run of characters.
fn apply_pattern_sub(s: str, pattern: str, replacement: str) -> str {
    if pattern.len == 0 {
        return s
    }
    var result = ""
    var words = split_words(s)
    var i = 0
    while i < words.len {
        let word = words[i]
        // Find % in pattern
        let pct_pos = pattern.find("%") else -1
        if pct_pos >= 0 {
            let prefix = pattern[0..pct_pos]
            let suffix = pattern[pct_pos + 1..]
            // Check if word starts with prefix and ends with suffix
            if word.starts_with(prefix) && word.ends_with(suffix) {
                let middle = word[prefix.len..word.len - suffix.len]
                let rp = replacement.find("%") else -1
                let replaced = if rp < 0 {
                    replacement
                } else {
                    replacement[0..rp] + middle + replacement[rp + 1..]
                }
                if i > 0 {
                    result = result + " "
                }
                result = result + replaced
            } else {
                if i > 0 {
                    result = result + " "
                }
                result = result + word
            }
        } else {
            if i > 0 {
                result = result + " "
            }
            result = result + (if word == pattern then replacement else word)
        }
        i += 1
    }
    return result
}
