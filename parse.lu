//! parse.lu — Makefile parser: lines, continuations, assignments, rules, recipes
//!
//! Parses the Makefile subset of README §2.1. Refuses by name anything outside it:
//! pattern rules, include, ifeq/ifdef, functions, define, .SUFFIXES, |, ::.

use std.fs
use std.str
use std.map
use std.env

/// A parsed assignment: NAME op VALUE.
struct Assignment {
    name: str,
    op: str,
    value: str,
    line: int,
}

/// A parsed rule: TARGETS : PREREQUISITES followed by recipe lines.
struct Rule {
    targets: List[str],
    prereqs: List[str],
    recipe: List[str],
    first_recipe_line: int,
    line: int,
}

/// A parsed .PHONY directive.
struct Phony {
    names: List[str],
    line: int,
}

/// A parsed include directive.
struct Include {
    names: List[str],
    optional: bool,
    line: int,
}

/// A conditional stack entry.
struct CondEntry {
    // The line number of the ifeq/ifdef/etc.
    line: int,
    // Whether lines are currently live (true = in the active branch)
    live: bool,
    // Whether an else has been seen in this conditional
    else_seen: bool,
}

/// A parsed define directive.
struct Define {
    name: str,
    op: str,
    value: str,
    line: int,
}

/// A refusal to parse a construct.
struct Refusal {
    kind: str,
    line: int,
}

/// A parse error with file, line, and message.
struct ParseErr {
    file: str,
    line: int,
    message: str,
}

/// A logical line with its first physical line number.
struct Line {
    text: str,
    line: int,
}

/// An included file with its path and whether it was found.
struct IncludedFile {
    path: str,
    found: bool,
    optional: bool,
    line: int,
}

/// The parsed Makefile database.
struct Database {
    assignments: List[Assignment],
    rules: List[Rule],
    phonies: List[Phony],
    includes: List[Include],
    defines: List[Define],
    refusals: List[Refusal],
    // Files that were included (for remaking)
    included_files: List[IncludedFile],
}

/// Join non-recipe lines with continuations and strip comments.
/// A trailing `\` joins with the next line (one space between).
/// A `#` ends the line.
/// Recipe lines (tab-prefixed) are joined with continuations, preserving raw text.
/// Returns lines with their first physical line number.
fn join_continuations(lines: List[str]) -> List[Line] {
    var result = List[Line]()
    var current = ""
    var current_line = 0
    var in_continuation = false
    var in_recipe = false
    var i = 0
    while i < lines.len {
        let line = lines[i]
        // While in a recipe continuation, accept the line regardless of its first character.
        // A recipe continuation may be indented with spaces, not just tabs.
        if in_recipe && in_continuation {
            // Append with newline — the raw text is stored for the shell.
            // Drop exactly one leading tab from the continued physical line
            // (gmake strips the tab that follows each backslash-newline in a recipe).
            let cont = if line.starts_with("\t") { line[1..] } else { line }
            current = current + "\n" + cont
            // Check for trailing backslash
            if current.ends_with("\\") {
                in_continuation = true
            } else {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
                in_recipe = false
            }
            i += 1
            continue
        }
        // Check if this is a recipe line (starts with tab)
        if line.starts_with("\t") {
            // If we were building a non-recipe line, push it.
            // This guard must NOT fire while in_recipe: a recipe line is still being built.
            if !in_recipe && current.len > 0 {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
            }
            if in_recipe && in_continuation {
                // This line continues the previous recipe line; append with newline.
                // Drop exactly one leading tab from the continued physical line.
                let cont = if line.starts_with("\t") { line[1..] } else { line }
                current = current + "\n" + cont
            } else {
                // New recipe line
                if current.len > 0 {
                    (mut result).push(Line { text: current, line: current_line })
                }
                current = line
                current_line = i + 1
                in_recipe = true
            }
            // Check for trailing backslash
            if current.ends_with("\\") {
                in_continuation = true
            } else {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
                in_recipe = false
            }
            i += 1
            continue
        }
        // This is a non-recipe line
        if in_recipe {
            // End of recipe block
            if current.len > 0 {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_recipe = false
                in_continuation = false
            }
        }
        if in_continuation {
            // Append to the current line with a space, trimming leading whitespace
            // from the continuation line (make joins with one space and discards
            // the indentation of the continuation line)
            current = current + " " + line.trim_start()
        } else {
            current = line
            current_line = i + 1
        }
        // Check for trailing backslash
        if current.ends_with("\\") {
            // Strip the trailing backslash and any trailing whitespace before it
            current = current[0..current.len - 1].trim_end()
            in_continuation = true
            i += 1
        } else {
            // Strip comments from non-recipe lines
            let stripped = strip_comment(current)
            (mut result).push(Line { text: stripped, line: current_line })
            current = ""
            in_continuation = false
            i += 1
        }
    }
    // If the file ends with a continuation, push what we have
    if current.len > 0 {
        if in_recipe {
            // A recipe whose last line ends in a backslash at end of file continues
            // onto an empty line, as gmake reads it.
            let text = if in_continuation { current + "\n" } else { current }
            (mut result).push(Line { text: text, line: current_line })
        } else {
            let stripped = strip_comment(current)
            (mut result).push(Line { text: stripped, line: current_line })
        }
    }
    return result
}

/// Strip a `#` comment from a line (not inside a recipe).
/// A `\#` is an escaped `#` and is not a comment start.
fn strip_comment(line: str) -> str {
    let idx = line.find("#") else {
        return line
    }
    if idx == 0 {
        return ""
    }
    // Check if the `#` is preceded by `\`
    if idx > 0 && line[idx - 1..idx] == "\\" {
        // The `#` is escaped; not a comment start.
        // Return the line with the `\` removed (the `#` is kept).
        return line[0..idx - 1] + "#" + line[idx + 1..]
    }
    return line[0..idx]
}

/// Check if a line is a refusal (pattern rule, include, ifeq, etc.).
/// Returns the refusal kind, or empty string if it's allowed.
fn check_refusal(line: str) -> str {
    // Pattern rules: a % among the target names, outside any $(…) or ${…}
    if percent_in_targets(line) {
        return "pattern rules are not supported"
    }
    // .SUFFIXES
    if line.starts_with(".SUFFIXES") {
        return ".SUFFIXES is not supported"
    }
    // Special targets that mk does not support
    let special_refusal = unsupported_special_target(line)
    if special_refusal.len > 0 {
        return special_refusal
    }
    // Order-only prerequisites: |
    if line.contains("|") {
        return "order-only prerequisites are not supported"
    }
    // Double-colon rules: ::
    if line.contains("::") {
        return "double-colon rules are not supported"
    }
    // Functions: $(shell ...)
    if line.contains("$(shell") {
        return "functions are not supported"
    }
    return ""
}

/// Check if a target name is an unsupported special target.
/// Returns the refusal message, or "" if it's allowed.
/// The supported special targets are: .PHONY, .SUFFIXES, .DEFAULT_GOAL, .EXPORT_ALL_VARIABLES.
/// All other gmake special targets are refused.
fn unsupported_special_target(line: str) -> str {
    // Extract the target name (before the first :)
    let colon_pos = line.find(":") else 0
    let target = if colon_pos > 0 {
        line[0..colon_pos].trim()
    } else {
        line.trim()
    }
    // Check for known unsupported special targets
    if target == ".ONESHELL" {
        return ".ONESHELL is not supported"
    }
    if target == ".SILENT" {
        return ".SILENT is not supported"
    }
    if target == ".DELETE_ON_ERROR" {
        return ".DELETE_ON_ERROR is not supported"
    }
    if target == ".PRECIOUS" {
        return ".PRECIOUS is not supported"
    }
    if target == ".INTERMEDIATE" {
        return ".INTERMEDIATE is not supported"
    }
    if target == ".SECONDARY" {
        return ".SECONDARY is not supported"
    }
    if target == ".NOTINTERMEDIATE" {
        return ".NOTINTERMEDIATE is not supported"
    }
    if target == ".IGNORE" {
        return ".IGNORE is not supported"
    }
    if target == ".NOTPARALLEL" {
        return ".NOTPARALLEL is not supported"
    }
    if target == ".WAIT" {
        return ".WAIT is not supported"
    }
    if target == ".POSIX" {
        return ".POSIX is not supported"
    }
    if target == ".SECONDEXPANSION" {
        return ".SECONDEXPANSION is not supported"
    }
    if target == ".EXTRA_PREREQS" {
        return ".EXTRA_PREREQS is not supported"
    }
    if target == ".DEFAULT" {
        return ".DEFAULT is not supported"
    }
    if target == ".LOW_RESOLUTION_TIME" {
        return ".LOW_RESOLUTION_TIME is not supported"
    }
    return ""
}

/// Parse an assignment line. Returns the assignment, or empty if it's not an assignment.
fn parse_assignment(line: str, line_num: int) -> Assignment ! {none} {
    // Check for :=, =, ?=, +=
    // The operator is the first occurrence of :=, ?=, or +=, or a bare = not preceded by : or ?
    var op = ""
    var op_pos = -1

    // Check for := first
    let colon_eq = line.find(":=") else 0
    if colon_eq > 0 {
        op = ":="
        op_pos = colon_eq
    } else {
        // Check for ?=
        let qmark_eq = line.find("?=") else 0
        if qmark_eq > 0 {
            op = "?="
            op_pos = qmark_eq
        } else {
            // Check for +=
            let plus_eq = line.find("+=") else 0
            if plus_eq > 0 {
                op = "+="
                op_pos = plus_eq
            } else {
                // Check for bare =
                let eq = line.find("=") else 0
                if eq > 0 {
                    // Make sure it's not part of :=, ?=, or +=
                    op = "="
                    op_pos = eq
                } else {
                    return none
                }
            }
        }
    }

    // The name is everything before the operator, trimmed
    let name = line[0..op_pos].trim()
    if name.len == 0 {
        return none
    }
    // A variable name with a space is not a valid assignment (gmake rejects with
    // "missing separator"). define NAME WITH SPACES is legal, but ordinary assignments
    // are not.
    if name.contains(" ") || name.contains("\t") {
        return none
    }

    // The value is everything after the operator, trimmed
    let value = line[op_pos + op.len..].trim()

    return Assignment {
        name: name,
        op: op,
        value: value,
        line: line_num,
    }
}

/// Parse a rule line. Returns the rule, or empty if it's not a rule.
fn parse_rule(line: str, line_num: int) -> Rule ! {none} {
    // A rule has a : that is not part of :=
    let colon_pos = line.find(":") else 0
    if colon_pos <= 0 {
        return none
    }

    // Check if this is := (assignment, not a rule)
    if colon_pos + 1 < line.len && line[colon_pos + 1..colon_pos + 2] == "=" {
        return none
    }

    // Split on the first :
    let targets_str = line[0..colon_pos].trim()
    let prereqs_str = line[colon_pos + 1..].trim()

    // Parse targets (space-separated, respecting $(…) boundaries)
    let targets = split_on_whitespace(targets_str)
    if targets.len == 0 {
        return none
    }

    // Parse prerequisites (space-separated, respecting $(…) boundaries)
    var prereqs = List[str]()
    if prereqs_str.len > 0 {
        prereqs = split_on_whitespace(prereqs_str)
    }

    return Rule {
        targets: targets,
        prereqs: prereqs,
        recipe: List[str](),
        first_recipe_line: 0,
        line: line_num,
    }
}

/// Parse a .PHONY line. Returns the phony directive, or empty if it's not .PHONY.
fn parse_phony(line: str, line_num: int) -> Phony ! {none} {
    if !line.starts_with(".PHONY") {
        return none
    }
    let colon_pos = line.find(":") else 0
    if colon_pos <= 0 {
        return none
    }
    let names_str = line[colon_pos + 1..].trim()
    if names_str.len == 0 {
        return none
    }
    let names = names_str.words()
    return Phony {
        names: names,
        line: line_num,
    }
}

/// Parse an include line. Returns the include directive, or empty if it's not an include.
fn parse_include(line: str, line_num: int) -> Include ! {none} {
    // Check for -include or sinclude (both are optional)
    let optional = line.starts_with("-include ") || line.starts_with("sinclude ")
    let names_str = if optional {
        // Strip the -include or sinclude prefix
        if line.starts_with("-include ") {
            line[9..]
        } else {
            line[9..]
        }
    } else if line.starts_with("include ") {
        line[8..]
    } else {
        return none
    }
    if names_str.len == 0 {
        return none
    }
    let names = names_str.words()
    return Include {
        names: names,
        optional: optional,
        line: line_num,
    }
}

/// Parse a define line. Returns the define directive, or empty if it's not a define.
fn parse_define(line: str, line_num: int) -> Define ! {none} {
    // Check for define NAME, define NAME =, define NAME :=, define NAME +=, define NAME ?=
    if !line.starts_with("define ") {
        return none
    }
    let rest = line[7..].trim()
    if rest.len == 0 {
        return none
    }
    // Check for operator
    let op = if rest.contains(":=") {
        ":="
    } else if rest.contains("+=") {
        "+="
    } else if rest.contains("?=") {
        "?="
    } else if rest.contains("=") {
        "="
    } else {
        "="
    }
    // Extract the name
    let name = if op == "=" || op == ":=" || op == "+=" || op == "?=" {
        let eq_pos = if op == ":=" {
            rest.find(":=") else 0
        } else if op == "+=" {
            rest.find("+=") else 0
        } else if op == "?=" {
            rest.find("?=") else 0
        } else {
            rest.find("=") else 0
        }
        if eq_pos <= 0 {
            rest
        } else {
            rest[0..eq_pos].trim()
        }
    } else {
        rest
    }
    if name.len == 0 {
        return none
    }
    return Define {
        name: name,
        op: op,
        value: "",
        line: line_num,
    }
}

/// Parse a conditional directive. Returns the kind, or empty if it's not a conditional.
fn parse_conditional(line: str) -> str {
    if line == "else" {
        return "else"
    }
    if line == "endif" {
        return "endif"
    }
    // else ifeq … / else ifneq … / else ifdef … / else ifndef …
    if line.starts_with("else ifeq") {
        return "else ifeq"
    }
    if line.starts_with("else ifneq") {
        return "else ifneq"
    }
    if line.starts_with("else ifdef") {
        return "else ifdef"
    }
    if line.starts_with("else ifndef") {
        return "else ifndef"
    }
    if line.starts_with("ifeq") {
        return "ifeq"
    }
    if line.starts_with("ifneq") {
        return "ifneq"
    }
    if line.starts_with("ifdef") {
        return "ifdef"
    }
    if line.starts_with("ifndef") {
        return "ifndef"
    }
    return ""
}

/// Evaluate a conditional expression.
/// `ifeq (a,b)` or `ifeq "a" "b"` or `ifeq 'a' 'b'`
/// Returns true if the condition is true.
fn eval_conditional(v: Vars, line: str, kind: str, line_num: int) -> bool ! {
    parse,
    Parse(ParseErr),
} {
    // Handle else-if forms: "else ifeq", "else ifneq", "else ifdef", "else ifndef"
    let actual_kind = if kind.starts_with("else ") {
        kind[5..]
    } else {
        kind
    }
    if actual_kind == "ifdef" || actual_kind == "ifndef" {
        // Extract the variable name
        let name = if actual_kind == "ifdef" {
            line[5..].trim()
        } else {
            line[7..].trim()
        }
        // Expand the name
        let expanded = expand(v, name, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
            Refuse(l, msg) => return parse,
        }
        // Check if the variable has a non-empty value
        let val = var_value(v, expanded)
        let is_set = val.len > 0
        if actual_kind == "ifndef" {
            return !is_set
        }
        return is_set
    }
    // ifeq or ifneq
    // Parse the arguments: (a,b) or "a" "b" or 'a' 'b'
    let rest = if actual_kind == "ifeq" {
        // For "else ifeq", strip "else " prefix first
        let line_rest = if kind.starts_with("else ") {
            line[5..]
        } else {
            line
        }
        line_rest[4..].trim()
    } else {
        // For "else ifneq", strip "else " prefix first
        let line_rest = if kind.starts_with("else ") {
            line[5..]
        } else {
            line
        }
        line_rest[6..].trim()
    }
    // Check for (a,b) syntax
    if rest.starts_with("(") {
        let close = rest.rfind(")") else 0
        if close <= 0 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let inner = rest[1..close]
        // Split on the first comma
        let comma = inner.find(",") else 0
        if comma <= 0 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let left = inner[0..comma]
        let right = inner[comma + 1..]
        // Strip leading whitespace only (gmake's rule: leading whitespace removed, trailing kept)
        let left_trimmed = left.trim_start()
        let right_trimmed = right.trim_start()
        // Expand both sides
        let left_expanded = expand(v, left_trimmed, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
            Refuse(l, msg) => return parse,
        }
        let right_expanded = expand(v, right_trimmed, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
            Refuse(l, msg) => return parse,
        }
        // Compare byte for byte (no trimming after expansion)
        if kind == "ifneq" {
            return left_expanded != right_expanded
        }
        return left_expanded == right_expanded
    }
    // Check for "a" "b" or 'a' 'b' or mixed 'a' "b" / "a" 'b' syntax
    let dq = "\""
    let sq = "'"
    if rest.starts_with(dq) || rest.starts_with(sq) {
        let quote1 = rest[0..1]
        // Find the closing quote for the first argument (skip the opening quote at index 0)
        let close1 = rest[1..].find(quote1) else 0
        if close1 <= 0 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        // close1 is the offset within rest[1..], so the actual index is close1 + 1
        let left = rest[1..close1 + 1]
        // Skip whitespace and find the second quote (can be " or ')
        let rest2 = rest[close1 + 2..].trim()
        let quote2 = if rest2.starts_with(dq) {
            dq
        } else if rest2.starts_with(sq) {
            sq
        } else {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let close2 = rest2[1..].find(quote2) else 0
        if close2 <= 0 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let right = rest2[1..close2 + 1]
        // Expand both sides (no trimming — the text between quotes is exact)
        let left_expanded = expand(v, left, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
            Refuse(l, msg) => return parse,
        }
        let right_expanded = expand(v, right, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
            Refuse(l, msg) => return parse,
        }
        // Compare byte for byte (no trimming after expansion)
        if kind == "ifneq" {
            return left_expanded != right_expanded
        }
        return left_expanded == right_expanded
    }
    // Invalid syntax
    return Parse(ParseErr {
        file: "",
        line: line_num,
        message: "invalid syntax in conditional",
    })
}

/// Parse a Makefile from text. Returns the database.
/// `file` is the filename for error messages.
/// `include_dirs` is the list of -I directories to search for included files.
/// `env_names` is a map of environment variable names (value is ignored).
fn parse_makefile(
    text: str,
    file: str,
    mut v: Vars,
    cli_names: Map[str, int],
    include_dirs: List[str],
    env_wins: bool,
    env_names: Map[str, int],
) -> Database ! {parse, Parse(ParseErr), io} {
    var db = Database {
        assignments: List[Assignment](),
        rules: List[Rule](),
        phonies: List[Phony](),
        includes: List[Include](),
        defines: List[Define](),
        refusals: List[Refusal](),
        included_files: List[IncludedFile](),
    }

    // Split into lines
    let lines = text.lines()

    // Join continuations
    let logical_lines = join_continuations(lines)

    // Process each logical line
    var line_num = 0
    var has_rule = false
    var current_rule = Rule {
        targets: List[str](),
        prereqs: List[str](),
        recipe: List[str](),
        first_recipe_line: 0,
        line: 0,
    }
    // Conditional stack: each entry tracks whether lines are live
    var cond_stack = List[CondEntry]()
    // Define stack: each entry tracks the define directive and accumulated body
    var define_stack = List[Define]()
    while line_num < logical_lines.len {
        let line = logical_lines[line_num].text
        let line_number = logical_lines[line_num].line

        // Check for recipe lines (start with tab)
        if line.starts_with("\t") {
            // This is a recipe line for the current rule
            if has_rule {
                // Strip only the first tab (the recipe prefix) from the first line
                // The joined line may contain newlines from continuations
                let first_newline = line.find("\n") else {
                    // No newline, strip the first tab
                    let recipe_line = line[1..]
                    if recipe_line.trim().len == 0 {
                        line_num += 1
                        continue
                    }
                    (mut current_rule.recipe).push(recipe_line)
                    // Set first_recipe_line on the first recipe line
                    if current_rule.first_recipe_line == 0 {
                        current_rule.first_recipe_line = line_number
                    }
                    line_num += 1
                    continue
                }
                // Has a newline: the line is "\tFIRST\nREST"
                // We want "FIRST\nREST" - strip only the first \t from the first line
                // line[1..] gives "FIRST\nREST" which is correct
                let recipe_line = line[1..]
                if recipe_line.trim().len == 0 {
                    line_num += 1
                    continue
                }
                (mut current_rule.recipe).push(recipe_line)
                // Set first_recipe_line on the first recipe line
                if current_rule.first_recipe_line == 0 {
                    current_rule.first_recipe_line = line_number
                }
            }
            line_num += 1
            continue
        }

        // For non-recipe lines, trim (comments already stripped by join_continuations)
        let stripped = line.trim()

        // Skip empty lines
        if stripped.len == 0 {
            line_num += 1
            continue
        }

        // If we were in a rule, save it
        if has_rule {
            (mut db.rules).push(current_rule)
            has_rule = false
        }

        // Check for refusals
        let refusal = check_refusal(stripped)
        if refusal.len > 0 {
            (mut db.refusals).push(Refusal {
                kind: refusal,
                line: line_number,
            })
            line_num += 1
            continue
        }

        // Check for conditional directives
        let cond_kind = parse_conditional(stripped)
        if cond_kind.len > 0 {
            // Handle conditional directives
            if cond_kind == "else" {
                // Check if we're in a conditional
                if cond_stack.len == 0 {
                    // Extraneous else
                    eprint("{file}:{line_number}: *** extraneous 'else'.  Stop.")
                    return parse
                }
                // Check if else has already been seen
                let top_idx = cond_stack.len - 1
                if cond_stack[top_idx].else_seen {
                    // Two else in one conditional
                    eprint("{file}:{line_number}: *** only one 'else' per conditional.  Stop.")
                    return parse
                }
                // Flip the live flag
                var entry = cond_stack[top_idx]
                entry.live = !entry.live
                entry.else_seen = true
                cond_stack[top_idx] = entry
                line_num += 1
                continue
            }
            // Handle else-if forms: "else ifeq", "else ifneq", "else ifdef", "else ifndef"
            if cond_kind.starts_with("else ") {
                // Check if we're in a conditional
                if cond_stack.len == 0 {
                    eprint("{file}:{line_number}: *** extraneous 'else'.  Stop.")
                    return parse
                }
                // Check if else has already been seen on the top entry
                let top_idx = cond_stack.len - 1
                if cond_stack[top_idx].else_seen {
                    eprint("{file}:{line_number}: *** only one 'else' per conditional.  Stop.")
                    return parse
                }
                // If the top entry is live, the else-if is ignored (lines are not live)
                if cond_stack[top_idx].live {
                    // Push a new entry for the else-if branch (not live)
                    (mut cond_stack).push(CondEntry {
                        live: false,
                        else_seen: false,
                        line: line_number,
                    })
                    line_num += 1
                    continue
                }
                // The top entry is not live; evaluate the else-if condition
                let result = eval_conditional(
                    v,
                    stripped,
                    cond_kind,
                    line_number,
                ) else |e| match e {
                    parse => {
                        eprint("{file}:{line_number}: *** invalid syntax in conditional.  Stop.")
                        return parse
                    },
                    Parse(p) => {
                        eprint("{file}:{line_number}: *** {p.message}.  Stop.")
                        return parse
                    },
                }
                // Update the top entry's live status (don't push a new entry)
                var entry = cond_stack[top_idx]
                entry.live = result
                cond_stack[top_idx] = entry
                line_num += 1
                continue
            }
            if cond_kind == "endif" {
                // Check if we're in a conditional
                if cond_stack.len == 0 {
                    // Extraneous endif (treat as missing endif error)
                    eprint("{file}:{line_number}: *** missing 'endif'.  Stop.")
                    return parse
                }
                // Pop the top entry (one endif closes one if)
                let _ = (mut cond_stack).pop()
                line_num += 1
                continue
            }
            // ifeq, ifneq, ifdef, ifndef
            // Evaluate the conditional
            let result = eval_conditional(v, stripped, cond_kind, line_number) else |e| match e {
                parse => {
                    eprint("{file}:{line_number}: *** invalid syntax in conditional.  Stop.")
                    return parse
                },
                Parse(p) => {
                    eprint("{file}:{line_number}: *** {p.message}.  Stop.")
                    return parse
                },
            }
            // Push onto the stack
            (mut cond_stack).push(CondEntry {
                line: line_number,
                live: result,
                else_seen: false,
            })
            line_num += 1
            continue
        }

        // Check for define/endef directives
        if stripped == "endef" {
            // Check if we're in a define
            if define_stack.len == 0 {
                // Extra endef: treat as missing separator
                eprint("{file}:{line_number}: *** missing separator.  Stop.")
                return parse
            }
            // Pop the define stack by keeping all but the last element
            var tmp = List[Define]()
            var i = 0
            while i < define_stack.len - 1 {
                (mut tmp).push(define_stack[i])
                i += 1
            }
            // Get the last element (the one being popped)
            var top = define_stack[define_stack.len - 1]
            define_stack = tmp
            // Apply the define to the variable table
            if top.op == ":=" {
                // Immediate expansion
                let expanded = expand(v, top.value, top.line) else |e| match e {
                    Unterminated(l) => {
                        eprint("{file}:{l}: *** unterminated variable reference.  Stop.")
                        return parse
                    },
                    Cycle(l, n) => {
                        eprint(
                            "{file}:{l}: *** Recursive variable '{n}' references itself (eventually).  Stop.",
                        )
                        return parse
                    },
                    Refuse(l, msg) => {
                        eprint(refusal_text("mk: ", file, l, msg))
                        return parse
                    },
                }
                set_var(mut v, top.name, expanded, "=immediate", top.line)
            } else {
                // Recursive expansion (store the value as-is)
                set_var(mut v, top.name, top.value, top.op, top.line)
            }
            // Store the define
            (mut db.defines).push(top)
            // Also add to assignments for -p output
            (mut db.assignments).push(Assignment {
                name: top.name,
                op: top.op,
                value: top.value,
                line: top.line,
            })
            line_num += 1
            continue
        }
        // Check for define NAME (also override define)
        if stripped.starts_with("define ") || stripped.starts_with("override define ") {
            // Strip the override prefix if present
            let def_line = if stripped.starts_with("override define ") {
                stripped[9..]
            } else {
                stripped
            }
            // Parse the define directive
            let define = parse_define(def_line, line_number) else |e| match e {
                none => {
                    // Not a define, fall through to normal parsing
                    line_num += 1
                    continue
                },
            }
            // Push onto the define stack
            (mut define_stack).push(define)
            line_num += 1
            continue
        }
        // Check for undefine NAME (also override undefine)
        if stripped.starts_with("undefine ") || stripped.starts_with("override undefine ") {
            // Strip the override prefix if present
            let undef_line = if stripped.starts_with("override undefine ") {
                stripped[13..]
            } else {
                stripped[9..]
            }
            // Extract the name (just the first word)
            let name = undef_line.words()[0]
            // Remove the variable
            undefine_var(mut v, name)
            line_num += 1
            continue
        }
        // Check for export NAME, export NAME = v, or bare export
        if stripped.starts_with("export ") || stripped == "export" {
            if stripped == "export" {
                // Bare export: export all variables
                v.export_all = true
                line_num += 1
                continue
            }
            // export NAME or export NAME = v
            let rest = stripped[7..].trim()
            if rest.len == 0 {
                line_num += 1
                continue
            }
            // Check for operator
            let op = if rest.contains(":=") {
                ":="
            } else if rest.contains("+=") {
                "+="
            } else if rest.contains("?=") {
                "?="
            } else if rest.contains("=") {
                "="
            } else {
                ""
            }
            // Extract the name
            let name = if op.len > 0 {
                let eq_pos = if op == ":=" {
                    rest.find(":=") else 0
                } else if op == "+=" {
                    rest.find("+=") else 0
                } else if op == "?=" {
                    rest.find("?=") else 0
                } else {
                    rest.find("=") else 0
                }
                if eq_pos <= 0 {
                    rest
                } else {
                    rest[0..eq_pos].trim()
                }
            } else {
                rest
            }
            if name.len == 0 {
                line_num += 1
                continue
            }
            // Remove from unexported list (export after unexport re-exports)
            var i = 0
            while i < v.unexported.len {
                if v.unexported[i] == name {
                    let _ = (mut v.unexported).swap_remove(i)
                    continue
                }
                i += 1
            }
            // Set the exported flag
            set_var_exported(mut v, name, true)
            // If there's an operator, also set the value
            if op.len > 0 {
                let value = if op == ":=" {
                    let p = (rest.find(":=") else 0) + 2
                    rest[p..].trim()
                } else if op == "+=" {
                    let p = (rest.find("+=") else 0) + 2
                    rest[p..].trim()
                } else if op == "?=" {
                    let p = (rest.find("?=") else 0) + 2
                    rest[p..].trim()
                } else {
                    let p = (rest.find("=") else 0) + 1
                    rest[p..].trim()
                }
                set_var_checked(mut v, name, value, op, line_number) else |e| match e {
                    Refuse(l, msg) => {
                        (mut db.refusals).push(Refusal { kind: msg, line: l })
                        line_num += 1
                        continue
                    },
                }
                // Re-set the exported flag (set_var may have created a new Var)
                set_var_exported(mut v, name, true)
            }
            line_num += 1
            continue
        }
        // Check for unexport NAME or bare unexport
        if stripped.starts_with("unexport ") || stripped == "unexport" {
            if stripped == "unexport" {
                // Bare unexport: clear export_all and unexport all variables
                v.export_all = false
                // Unexport all variables in the table
                for name in map.keys(v.table) {
                    (mut v.unexported).push(name)
                }
                line_num += 1
                continue
            }
            // unexport NAME
            let name = stripped[9..].trim()
            if name.len > 0 {
                // Add to the unexported list
                (mut v.unexported).push(name)
                // Clear the exported flag
                set_var_exported(mut v, name, false)
            }
            line_num += 1
            continue
        }
        // Check for override NAME = v (also handled by set_var_skip)
        if stripped.starts_with("override ") {
            // Strip the override prefix
            let rest = stripped[9..].trim()
            // Parse as an assignment
            let assignment = parse_assignment(rest, line_number) else |e| match e {
                none => {
                    // Not an assignment: override NAME with no operator is an error
                    eprint("{file}:{line_number}: *** missing separator.  Stop.")
                    return parse
                },
            }
            // Apply the assignment, skipping CLI overrides
            // SHELL and .SHELLFLAGS are refused until track 04 implements them
            if assignment.name == "SHELL" || assignment.name == ".SHELLFLAGS" {
                (mut db.refusals).push(Refusal {
                    kind: "{assignment.name} is not supported",
                    line: assignment.line,
                })
                line_num += 1
                continue
            }
            set_var_checked(
                mut v,
                assignment.name,
                assignment.value,
                assignment.op,
                assignment.line,
            ) else |e| match e {
                Refuse(l, msg) => {
                    (mut db.refusals).push(Refusal { kind: msg, line: l })
                    line_num += 1
                    continue
                },
            }
            // Store the assignment for -p output
            (mut db.assignments).push(assignment)
            line_num += 1
            continue
        }

        // Check if lines are live (based on the conditional stack)
        var is_live = true
        if cond_stack.len > 0 {
            // Check the top of the stack
            let top_idx = cond_stack.len - 1
            is_live = cond_stack[top_idx].live
        }
        // If not live, skip this line
        if !is_live {
            line_num += 1
            continue
        }

        // If we're inside a define block, accumulate the line as body text
        if define_stack.len > 0 {
            // Append the line to the current define's body
            let top_idx = define_stack.len - 1
            var top = define_stack[top_idx]
            if top.value.len > 0 {
                top.value = top.value + "\n" + line
            } else {
                top.value = line
            }
            define_stack[top_idx] = top
            line_num += 1
            continue
        }

        // Try to parse as assignment
        let assignment = parse_assignment(stripped, line_number) else |e| match e {
            none => {
                // Not an assignment, try as include first (before .PHONY and rule)
                let include = parse_include(stripped, line_number) else |e4| match e4 {
                    none => {
                        // Not an include, try as .PHONY first (before rule, since .PHONY: looks like a rule)
                        let phony = parse_phony(stripped, line_number) else |e3| match e3 {
                            none => {
                                // Not .PHONY, check for .EXPORT_ALL_VARIABLES
                                if stripped == ".EXPORT_ALL_VARIABLES:" ||
                                    stripped == ".EXPORT_ALL_VARIABLES" {
                                    v.export_all = true
                                    line_num += 1
                                    continue
                                }
                                // Not .EXPORT_ALL_VARIABLES, try as rule
                                let rule = parse_rule(stripped, line_number) else |e2| match e2 {
                                    none => {
                                        // Unknown line: not blank, not a comment, not a recipe line,
                                        // not an assignment, not a rule, not a refusal.
                                        // Check if it's a function call at top level (e.g. $(info hi))
                                        if stripped.starts_with("$(") {
                                            // Try to expand it; if it's a gmake function, refuse it
                                            let _ = expand(
                                                v,
                                                stripped,
                                                line_number,
                                            ) else |e| match e {
                                                Refuse(l, msg) => {
                                                    (mut db.refusals).push(Refusal {
                                                        kind: msg,
                                                        line: l,
                                                    })
                                                    line_num += 1
                                                    continue
                                                },
                                                _ => "",
                                            }
                                        }
                                        // This is a "missing separator" error.
                                        return Parse(ParseErr {
                                            file: file,
                                            line: line_number,
                                            message: "missing separator",
                                        })
                                    },
                                }
                                current_rule = rule
                                has_rule = true
                                line_num += 1
                                continue
                            },
                        }
                        (mut db.phonies).push(phony)
                        line_num += 1
                        continue
                    },
                }
                // Store the include for -p output
                (mut db.includes).push(include)
                // Process the include directive
                for name in include.names {
                    // Expand the name
                    let expanded = expand(v, name, include.line) else |e| match e {
                        Unterminated(l) => {
                            eprint("{file}:{l}: *** unterminated variable reference.  Stop.")
                            return parse
                        },
                        Cycle(l, n) => {
                            eprint(
                                "{file}:{l}: *** Recursive variable '{n}' references itself (eventually).  Stop.",
                            )
                            return parse
                        },
                        Refuse(l, msg) => {
                            eprint(refusal_text("mk: ", file, l, msg))
                            return parse
                        },
                    }
                    // Glob the expanded name
                    let globs = glob(expanded)
                    if globs.len == 0 {
                        // No matches - record for potential remaking.
                        // Do NOT fail here: the file might have a rule to build it.
                        // The error check happens after the graph is built (in main.lu).
                        (mut db.included_files).push(IncludedFile {
                            path: expanded,
                            found: false,
                            optional: include.optional,
                            line: include.line,
                        })
                        continue
                    }
                    // Read and parse each file
                    for g in globs {
                        let sub_db = parse_makefile_file(
                            g,
                            mut v,
                            cli_names,
                            include_dirs,
                            env_wins,
                            env_names,
                        ) else |e| match e {
                            parse => {
                                // The file could not be parsed (likely missing).
                                // Record it as missing; the error check happens after the graph is built.
                                (mut db.included_files).push(IncludedFile {
                                    path: g,
                                    found: false,
                                    optional: include.optional,
                                    line: include.line,
                                })
                                continue
                            },
                            Parse(p) => {
                                if !include.optional {
                                    eprint("{p.file}:{p.line}: *** {p.message}.  Stop.")
                                    return parse
                                }
                                // Soft include: silent
                                continue
                            },
                            io => {
                                // The file could not be read (likely missing).
                                // Record it as missing; the error check happens after the graph is built.
                                (mut db.included_files).push(IncludedFile {
                                    path: g,
                                    found: false,
                                    optional: include.optional,
                                    line: include.line,
                                })
                                continue
                            },
                        }
                        // Record the included file for potential remaking
                        (mut db.included_files).push(IncludedFile {
                            path: g,
                            found: true,
                            optional: include.optional,
                            line: include.line,
                        })
                        // Merge the sub-database into the main database
                        for a in sub_db.assignments {
                            (mut db.assignments).push(a)
                            if !map.has(cli_names, a.name) {
                                set_var_checked(
                                    mut v,
                                    a.name,
                                    a.value,
                                    a.op,
                                    a.line,
                                ) else |e| match e {
                                    Refuse(l, msg) => {
                                        (mut db.refusals).push(Refusal { kind: msg, line: l })
                                        continue
                                    },
                                }
                            }
                        }
                        for r in sub_db.rules {
                            (mut db.rules).push(r)
                        }
                        for p in sub_db.phonies {
                            (mut db.phonies).push(p)
                        }
                        for i in sub_db.includes {
                            (mut db.includes).push(i)
                        }
                        for r in sub_db.refusals {
                            (mut db.refusals).push(r)
                        }
                        // Update MAKEFILE_LIST
                        let current_list = var_value(v, "MAKEFILE_LIST")
                        if current_list.len > 0 {
                            set_var(mut v, "MAKEFILE_LIST", current_list + " " + g, "=", 0)
                        } else {
                            set_var(mut v, "MAKEFILE_LIST", g, "=", 0)
                        }
                    }
                }
                line_num += 1
                continue
            },
        }
        // Store the assignment for -p output
        (mut db.assignments).push(assignment)
        // SHELL and .SHELLFLAGS are refused until track 04 implements them
        if assignment.name == "SHELL" || assignment.name == ".SHELLFLAGS" {
            (mut db.refusals).push(Refusal {
                kind: "{assignment.name} is not supported",
                line: assignment.line,
            })
            line_num += 1
            continue
        }
        // Apply the assignment to the variable table, respecting CLI overrides
        if !map.has(cli_names, assignment.name) {
            // If env_wins is true, check if the variable is in the environment
            if env_wins {
                if map.has(env_names, assignment.name) {
                    // Environment wins: use the environment value
                    let env_val = env.get(assignment.name) else ""
                    set_var_origin(mut v, assignment.name, env_val, ":=", assignment.line, "env")
                    line_num += 1
                    continue
                }
            }
            // Check if the variable is in the environment (for origin tracking)
            if map.has(env_names, assignment.name) {
                // The variable is in the environment; use the Makefile value but mark as env origin
                set_var_origin(
                    mut v,
                    assignment.name,
                    assignment.value,
                    assignment.op,
                    assignment.line,
                    "env",
                )
            } else {
                set_var_checked(
                    mut v,
                    assignment.name,
                    assignment.value,
                    assignment.op,
                    assignment.line,
                ) else |e| match e {
                    Refuse(l, msg) => {
                        (mut db.refusals).push(Refusal { kind: msg, line: l })
                        line_num += 1
                        continue
                    },
                }
            }
        }
        line_num += 1
    }

    // Save the last rule if any
    if has_rule {
        (mut db.rules).push(current_rule)
    }

    // Check for open conditionals (missing endif)
    if cond_stack.len > 0 {
        // The error line is the last line + 1
        let last_line = logical_lines[logical_lines.len - 1].line
        eprint("{file}:{last_line + 1}: *** missing 'endif'.  Stop.")
        return parse
    }

    // Check for open defines (missing endef)
    if define_stack.len > 0 {
        // The error line is the line of the define
        let define_line = define_stack[0].line
        eprint("{file}:{define_line}: *** missing 'endef', unterminated 'define'.  Stop.")
        return parse
    }

    return db
}

/// Read a Makefile from a file and parse it.
/// `include_dirs` is the list of -I directories to search for included files.
fn parse_makefile_file(
    path: str,
    mut v: Vars,
    cli_names: Map[str, int],
    include_dirs: List[str],
    env_wins: bool,
    env_names: Map[str, int],
) -> Database ! {parse, Parse(ParseErr), io} {
    let text = fs.read_text(path) else |e| match e {
        io => return io,
        denied => return io,
        not_found => return io,
        utf8 => return parse,
    }
    // Skip BOM (U+FEFF) at the start of the file
    let bom = "\u{FEFF}"
    let text = if text.starts_with(bom) {
        text[bom.len..]
    } else {
        text
    }
    parse_makefile(text, path, mut v, cli_names, include_dirs, env_wins, env_names)
}

/// Parse multiple Makefile files, merging their contents.
/// Each file is parsed in order, and its assignments, rules, and phonies
/// are appended to the database.
fn parse_makefile_files(
    paths: List[str],
    mut v: Vars,
    cli_names: Map[str, int],
    include_dirs: List[str],
    env_wins: bool,
    env_names: Map[str, int],
) -> Database ! {parse, Parse(ParseErr), io} {
    var db = Database {
        assignments: List[Assignment](),
        rules: List[Rule](),
        phonies: List[Phony](),
        includes: List[Include](),
        defines: List[Define](),
        refusals: List[Refusal](),
        included_files: List[IncludedFile](),
    }
    for path in paths {
        let text = fs.read_text(path) else |e| match e {
            io => return io,
            denied => return io,
            not_found => return io,
            utf8 => return parse,
        }
        // Skip BOM (U+FEFF) at the start of the file
        let bom = "\u{FEFF}"
        let text = if text.starts_with(bom) {
            text[bom.len..]
        } else {
            text
        }
        let file_db = parse_makefile(
            text,
            path,
            mut v,
            cli_names,
            include_dirs,
            env_wins,
            env_names,
        ) else |e| match e {
            parse => return parse,
            Parse(p) => return Parse(p),
            io => return io,
        }
        // Merge the file's contents into the database
        for a in file_db.assignments {
            (mut db.assignments).push(a)
        }
        for r in file_db.rules {
            (mut db.rules).push(r)
        }
        for p in file_db.phonies {
            (mut db.phonies).push(p)
        }
        for i in file_db.includes {
            (mut db.includes).push(i)
        }
        for d in file_db.defines {
            (mut db.defines).push(d)
        }
        for r in file_db.refusals {
            (mut db.refusals).push(r)
        }
        for f in file_db.included_files {
            (mut db.included_files).push(f)
        }
    }
    return db
}

/// Print the database in a stable format for -p.
/// Variables are sorted by name, with their expanded values.
/// Rules are in file order, with prerequisites and recipes.
/// .PHONY directives are printed after rules.
///
/// Format:
///   # Variables
///   NAME = EXPANDED_VALUE
///   ...
///   # Rules
///   TARGETS: PREREQS
///   \tRECIPE_LINE
///   ...
///   .PHONY: NAMES
fn print_database(db: Database, v: Vars, makefile: str) -> !int {
    // Collect unique variable names and sort them
    var names = List[str]()
    for a in db.assignments {
        // Check if the name is already in the list
        var found = false
        for n in names {
            if n == a.name {
                found = true
                break
            }
        }
        if !found {
            (mut names).push(a.name)
        }
    }
    // Simple insertion sort
    var i = 1
    while i < names.len {
        let key = names[i]
        var j = i - 1
        while j >= 0 && names[j] > key {
            names[j + 1] = names[j]
            j -= 1
        }
        names[j + 1] = key
        i += 1
    }
    // Print variables sorted by name with expanded values
    print("# Variables")
    for name in names {
        let val = var_value(v, name)
        let line = var_line_of(v, name)
        let flavour = var_flavour(v, name)
        // := values are already expanded; print them as-is.
        // = values need to be expanded.
        let expanded = if flavour == ":=" {
            val
        } else {
            expand(v, val, line) else |e| match e {
                Unterminated(l) => {
                    eprint("{makefile}:{l}: *** unterminated variable reference.  Stop.")
                    return 2
                },
                Cycle(l, n) => {
                    eprint(
                        "{makefile}:{l}: *** Recursive variable '{n}' references itself (eventually).  Stop.",
                    )
                    return 2
                },
                Refuse(l, msg) => {
                    eprint(refusal_text("mk: ", makefile, l, msg))
                    return 2
                },
            }
        }
        print("{name} = {expanded}")
    }
    // Print rules with their prerequisites and recipes
    print("# Rules")
    for r in db.rules {
        let targets = str.join(" ", r.targets)
        let prereqs = str.join(" ", r.prereqs)
        if prereqs.len > 0 {
            print("{targets}: {prereqs}")
        } else {
            print("{targets}:")
        }
        for recipe_line in r.recipe {
            print("\t{recipe_line}")
        }
    }
    // Print .PHONY directives
    for p in db.phonies {
        let names = str.join(" ", p.names)
        print(".PHONY: {names}")
    }
    return 0
}

/// True when a `%` stands among a rule line's target names: before the
/// first `:` at reference depth zero, and itself at depth zero (a `%`
/// inside `$(…)` or `${…}` belongs to a function, not a pattern rule).
fn percent_in_targets(line: str) -> bool {
    var depth = 0
    var i = 0
    while i < line.len {
        let rest = line[i..]
        if rest.starts_with("${{") {
            depth = depth + 1
            i = i + 2
            continue
        }
        if rest.starts_with("(") {
            depth = depth + 1
            i = i + 1
            continue
        }
        if rest.starts_with(")") {
            if depth > 0 {
                depth = depth - 1
            }
            i = i + 1
            continue
        }
        if rest.starts_with(":") && depth == 0 {
            return false
        }
        if rest.starts_with("%") && depth == 0 {
            return true
        }
        i = i + 1
    }
    false
}

/// Split on whitespace at depth zero: a space or tab at depth zero is a
/// separator; inside `$(…)` or `${…}` whitespace is part of the word.
fn split_on_whitespace(line: str) -> List[str] {
    var result = List[str]()
    var start = 0
    var depth = 0
    var i = 0
    while i < line.len {
        let rest = line[i..]
        if rest.starts_with("${{") {
            depth = depth + 1
            i = i + 2
            continue
        }
        if rest.starts_with("(") {
            depth = depth + 1
            i = i + 1
            continue
        }
        if rest.starts_with(")") {
            if depth > 0 {
                depth = depth - 1
            }
            i = i + 1
            continue
        }
        if (rest.starts_with(" ") || rest.starts_with("\t")) && depth == 0 {
            if i > start {
                (mut result).push(line[start..i])
            }
            start = i + 1
            i = i + 1
            continue
        }
        i = i + 1
    }
    if start < line.len {
        (mut result).push(line[start..])
    }
    result
}
