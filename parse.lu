//! parse.lu — Makefile parser: lines, continuations, assignments, rules, recipes
//!
//! Parses the Makefile subset of README §2.1. Refuses by name anything outside it:
//! pattern rules, include, ifeq/ifdef, functions, define, .SUFFIXES, |, ::.

use std.fs
use std.str

/// A parsed assignment: NAME op VALUE.
struct Assignment {
    name: str,
    op: str,
    value: str,
    line: int,
}

/// A parsed rule: TARGETS : PREREQUISITES followed by recipe lines.
struct Rule {
    targets: List[str],
    prereqs: List[str],
    recipe: List[str],
    first_recipe_line: int,
    line: int,
}

/// A parsed .PHONY directive.
struct Phony {
    names: List[str],
    line: int,
}

/// A refusal to parse a construct.
struct Refusal {
    kind: str,
    line: int,
}

/// A logical line with its first physical line number.
struct Line {
    text: str,
    line: int,
}

/// The parsed Makefile database.
struct Database {
    assignments: List[Assignment],
    rules: List[Rule],
    phonies: List[Phony],
    refusals: List[Refusal],
}

/// Join non-recipe lines with continuations and strip comments.
/// A trailing `\` joins with the next line (one space between).
/// A `#` ends the line.
/// Recipe lines (tab-prefixed) are joined with continuations, preserving raw text.
/// Returns lines with their first physical line number.
fn join_continuations(lines: List[str]) -> List[Line] {
    var result = List[Line]()
    var current = ""
    var current_line = 0
    var in_continuation = false
    var in_recipe = false
    var i = 0
    while i < lines.len {
        let line = lines[i]
        // While in a recipe continuation, accept the line regardless of its first character.
        // A recipe continuation may be indented with spaces, not just tabs.
        if in_recipe && in_continuation {
            // Append with newline — the raw text is stored for the shell.
            // Drop exactly one leading tab from the continued physical line
            // (gmake strips the tab that follows each backslash-newline in a recipe).
            let cont = if line.starts_with("\t") { line[1..] } else { line }
            current = current + "\n" + cont
            // Check for trailing backslash
            if current.ends_with("\\") {
                in_continuation = true
            } else {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
                in_recipe = false
            }
            i += 1
            continue
        }
        // Check if this is a recipe line (starts with tab)
        if line.starts_with("\t") {
            // If we were building a non-recipe line, push it.
            // This guard must NOT fire while in_recipe: a recipe line is still being built.
            if !in_recipe && current.len > 0 {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
            }
            if in_recipe && in_continuation {
                // This line continues the previous recipe line; append with newline.
                // Drop exactly one leading tab from the continued physical line.
                let cont = if line.starts_with("\t") { line[1..] } else { line }
                current = current + "\n" + cont
            } else {
                // New recipe line
                if current.len > 0 {
                    (mut result).push(Line { text: current, line: current_line })
                }
                current = line
                current_line = i + 1
                in_recipe = true
            }
            // Check for trailing backslash
            if current.ends_with("\\") {
                in_continuation = true
            } else {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
                in_recipe = false
            }
            i += 1
            continue
        }
        // This is a non-recipe line
        if in_recipe {
            // End of recipe block
            if current.len > 0 {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_recipe = false
                in_continuation = false
            }
        }
        if in_continuation {
            // Append to the current line with a space, trimming leading whitespace
            // from the continuation line (make joins with one space and discards
            // the indentation of the continuation line)
            current = current + " " + line.trim_start()
        } else {
            current = line
            current_line = i + 1
        }
        // Check for trailing backslash
        if current.ends_with("\\") {
            // Strip the trailing backslash and any trailing whitespace before it
            current = current[0..current.len - 1].trim_end()
            in_continuation = true
            i += 1
        } else {
            // Strip comments from non-recipe lines
            let stripped = strip_comment(current)
            (mut result).push(Line { text: stripped, line: current_line })
            current = ""
            in_continuation = false
            i += 1
        }
    }
    // If the file ends with a continuation, push what we have
    if current.len > 0 {
        if in_recipe {
            (mut result).push(Line { text: current, line: current_line })
        } else {
            let stripped = strip_comment(current)
            (mut result).push(Line { text: stripped, line: current_line })
        }
    }
    return result
}

/// Strip a `#` comment from a line (not inside a recipe).
fn strip_comment(line: str) -> str {
    let idx = line.find("#") else {
        return line
    }
    if idx == 0 {
        return ""
    }
    return line[0..idx]
}

/// Check if a line is a refusal (pattern rule, include, ifeq, etc.).
/// Returns the refusal kind, or empty string if it's allowed.
fn check_refusal(line: str) -> str {
    // Pattern rules: contain % in the target
    if line.contains("%") {
        return "pattern rules are not supported"
    }
    // include directive
    if line.starts_with("include ") || line.starts_with("-include ") {
        return "include is not supported"
    }
    // ifeq/ifdef/ifndef/else/endif
    if line.starts_with("ifeq") || line.starts_with("ifdef") || line.starts_with("ifndef") {
        return "conditional directives are not supported"
    }
    if line.starts_with("else") || line.starts_with("endif") {
        return "conditional directives are not supported"
    }
    // define/endef
    if line.starts_with("define ") || line.starts_with("endef") {
        return "define is not supported"
    }
    // .SUFFIXES
    if line.starts_with(".SUFFIXES") {
        return ".SUFFIXES is not supported"
    }
    // Order-only prerequisites: |
    if line.contains("|") {
        return "order-only prerequisites are not supported"
    }
    // Double-colon rules: ::
    if line.contains("::") {
        return "double-colon rules are not supported"
    }
    // Functions: $(wildcard ...), $(patsubst ...), $(shell ...)
    if line.contains("$(wildcard") || line.contains("$(patsubst") || line.contains("$(shell") {
        return "functions are not supported"
    }
    return ""
}

/// Parse an assignment line. Returns the assignment, or empty if it's not an assignment.
fn parse_assignment(line: str, line_num: int) -> Assignment ! {none} {
    // Check for :=, =, ?=, +=
    // The operator is the first occurrence of :=, ?=, or +=, or a bare = not preceded by : or ?
    var op = ""
    var op_pos = -1

    // Check for := first
    let colon_eq = line.find(":=") else 0
    if colon_eq > 0 {
        op = ":="
        op_pos = colon_eq
    } else {
        // Check for ?=
        let qmark_eq = line.find("?=") else 0
        if qmark_eq > 0 {
            op = "?="
            op_pos = qmark_eq
        } else {
            // Check for +=
            let plus_eq = line.find("+=") else 0
            if plus_eq > 0 {
                op = "+="
                op_pos = plus_eq
            } else {
                // Check for bare =
                let eq = line.find("=") else 0
                if eq > 0 {
                    // Make sure it's not part of :=, ?=, or +=
                    op = "="
                    op_pos = eq
                } else {
                    return none
                }
            }
        }
    }

    // The name is everything before the operator, trimmed
    let name = line[0..op_pos].trim()
    if name.len == 0 {
        return none
    }

    // The value is everything after the operator, trimmed
    let value = line[op_pos + op.len..].trim()

    return Assignment {
        name: name,
        op: op,
        value: value,
        line: line_num,
    }
}

/// Parse a rule line. Returns the rule, or empty if it's not a rule.
fn parse_rule(line: str, line_num: int) -> Rule ! {none} {
    // A rule has a : that is not part of :=
    let colon_pos = line.find(":") else 0
    if colon_pos <= 0 {
        return none
    }

    // Check if this is := (assignment, not a rule)
    if colon_pos + 1 < line.len && line[colon_pos + 1..colon_pos + 2] == "=" {
        return none
    }

    // Split on the first :
    let targets_str = line[0..colon_pos].trim()
    let prereqs_str = line[colon_pos + 1..].trim()

    // Parse targets (space-separated)
    let targets = targets_str.words()
    if targets.len == 0 {
        return none
    }

    // Parse prerequisites (space-separated)
    var prereqs = List[str]()
    if prereqs_str.len > 0 {
        prereqs = prereqs_str.words()
    }

    return Rule {
        targets: targets,
        prereqs: prereqs,
        recipe: List[str](),
        first_recipe_line: 0,
        line: line_num,
    }
}

/// Parse a .PHONY line. Returns the phony directive, or empty if it's not .PHONY.
fn parse_phony(line: str, line_num: int) -> Phony ! {none} {
    if !line.starts_with(".PHONY") {
        return none
    }
    let colon_pos = line.find(":") else 0
    if colon_pos <= 0 {
        return none
    }
    let names_str = line[colon_pos + 1..].trim()
    if names_str.len == 0 {
        return none
    }
    let names = names_str.words()
    return Phony {
        names: names,
        line: line_num,
    }
}

/// Parse a Makefile from text. Returns the database.
fn parse_makefile(text: str) -> Database ! {parse} {
    var db = Database {
        assignments: List[Assignment](),
        rules: List[Rule](),
        phonies: List[Phony](),
        refusals: List[Refusal](),
    }

    // Split into lines
    let lines = text.lines()

    // Join continuations
    let logical_lines = join_continuations(lines)

    // Process each logical line
    var line_num = 0
    var has_rule = false
    var current_rule = Rule {
        targets: List[str](),
        prereqs: List[str](),
        recipe: List[str](),
        first_recipe_line: 0,
        line: 0,
    }
    while line_num < logical_lines.len {
        let line = logical_lines[line_num].text
        let line_number = logical_lines[line_num].line

        // Check for recipe lines (start with tab)
        if line.starts_with("\t") {
            // This is a recipe line for the current rule
            if has_rule {
                // Strip only the first tab (the recipe prefix) from the first line
                // The joined line may contain newlines from continuations
                let first_newline = line.find("\n") else {
                    // No newline, strip the first tab
                    let recipe_line = line[1..]
                    (mut current_rule.recipe).push(recipe_line)
                    // Set first_recipe_line on the first recipe line
                    if current_rule.first_recipe_line == 0 {
                        current_rule.first_recipe_line = line_number
                    }
                    line_num += 1
                    continue
                }
                // Has a newline: the line is "\tFIRST\nREST"
                // We want "FIRST\nREST" - strip only the first \t from the first line
                // line[1..] gives "FIRST\nREST" which is correct
                let recipe_line = line[1..]
                (mut current_rule.recipe).push(recipe_line)
                // Set first_recipe_line on the first recipe line
                if current_rule.first_recipe_line == 0 {
                    current_rule.first_recipe_line = line_number
                }
            }
            line_num += 1
            continue
        }

        // For non-recipe lines, strip comments and trim
        let stripped = strip_comment(line).trim()

        // Skip empty lines
        if stripped.len == 0 {
            line_num += 1
            continue
        }

        // If we were in a rule, save it
        if has_rule {
            (mut db.rules).push(current_rule)
            has_rule = false
        }

        // Check for refusals
        let refusal = check_refusal(stripped)
        if refusal.len > 0 {
            (mut db.refusals).push(Refusal {
                kind: refusal,
                line: line_number,
            })
            line_num += 1
            continue
        }

        // Try to parse as assignment
        let assignment = parse_assignment(stripped, line_number) else |e| match e {
            none => {
                // Not an assignment, try as .PHONY first (before rule, since .PHONY: looks like a rule)
                let phony = parse_phony(stripped, line_number) else |e3| match e3 {
                    none => {
                        // Not .PHONY, try as rule
                        let rule = parse_rule(stripped, line_number) else |e2| match e2 {
                            none => {
                                // Unknown line, skip
                                line_num += 1
                                continue
                            },
                        }
                        current_rule = rule
                        has_rule = true
                        line_num += 1
                        continue
                    },
                }
                (mut db.phonies).push(phony)
                line_num += 1
                continue
            },
        }
        (mut db.assignments).push(assignment)
        line_num += 1
    }

    // Save the last rule if any
    if has_rule {
        (mut db.rules).push(current_rule)
    }

    return db
}

/// Read a Makefile from a file and parse it.
fn parse_makefile_file(path: str) -> Database ! {parse, io} {
    let text = fs.read_text(path) else |e| match e {
        io => return io,
        denied => return io,
        not_found => return io,
        utf8 => return parse,
    }
    parse_makefile(text)
}

/// Print the database in a stable format for -p.
/// Variables are sorted by name, with their expanded values.
/// Rules are in file order, with prerequisites and recipes.
/// .PHONY directives are printed after rules.
///
/// Format:
///   # Variables
///   NAME = EXPANDED_VALUE
///   ...
///   # Rules
///   TARGETS: PREREQS
///   \tRECIPE_LINE
///   ...
///   .PHONY: NAMES
fn print_database(db: Database, v: Vars) {
    // Collect unique variable names and sort them
    var names = List[str]()
    for a in db.assignments {
        // Check if the name is already in the list
        var found = false
        for n in names {
            if n == a.name {
                found = true
                break
            }
        }
        if !found {
            (mut names).push(a.name)
        }
    }
    // Simple insertion sort
    var i = 1
    while i < names.len {
        let key = names[i]
        var j = i - 1
        while j >= 0 && names[j] > key {
            names[j + 1] = names[j]
            j -= 1
        }
        names[j + 1] = key
        i += 1
    }
    // Print variables sorted by name with expanded values
    print("# Variables")
    for name in names {
        let val = var_value(v, name)
        let expanded = expand(v, val)
        print("{name} = {expanded}")
    }
    // Print rules with their prerequisites and recipes
    print("# Rules")
    for r in db.rules {
        let targets = str.join(" ", r.targets)
        let prereqs = str.join(" ", r.prereqs)
        if prereqs.len > 0 {
            print("{targets}: {prereqs}")
        } else {
            print("{targets}:")
        }
        for recipe_line in r.recipe {
            print("\t{recipe_line}")
        }
    }
    // Print .PHONY directives
    for p in db.phonies {
        let names = str.join(" ", p.names)
        print(".PHONY: {names}")
    }
}
