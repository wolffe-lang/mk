//! parse.lu — Makefile parser: lines, continuations, assignments, rules, recipes
//!
//! Parses the Makefile subset of README §2.1. Refuses by name anything outside it:
//! pattern rules, include, ifeq/ifdef, functions, define, .SUFFIXES, |, ::.

use std.fs
use std.str
use std.map
use std.env

/// A parsed assignment: NAME op VALUE.
struct Assignment {
    name: str,
    op: str,
    value: str,
    line: int,
}

/// A parsed rule: TARGETS : PREREQUISITES followed by recipe lines.
struct Rule {
    targets: List[str],
    prereqs: List[str],
    recipe: List[str],
    first_recipe_line: int,
    line: int,
}

/// A parsed .PHONY directive.
struct Phony {
    names: List[str],
    line: int,
}

/// A parsed include directive.
struct Include {
    names: List[str],
    optional: bool,
    line: int,
}

/// A conditional stack entry.
struct CondEntry {
    // The line number of the ifeq/ifdef/etc.
    line: int,
    // Whether lines are currently live (true = in the active branch)
    live: bool,
    // Whether an else has been seen in this conditional
    else_seen: bool,
}

/// A parsed define directive.
struct Define {
    name: str,
    op: str,
    value: str,
    line: int,
}

/// A refusal to parse a construct.
struct Refusal {
    kind: str,
    line: int,
}

/// A parse error with file, line, and message.
struct ParseErr {
    file: str,
    line: int,
    message: str,
}

/// A logical line with its first physical line number.
struct Line {
    text: str,
    line: int,
}

/// The parsed Makefile database.
struct Database {
    assignments: List[Assignment],
    rules: List[Rule],
    phonies: List[Phony],
    includes: List[Include],
    defines: List[Define],
    refusals: List[Refusal],
}

/// Join non-recipe lines with continuations and strip comments.
/// A trailing `\` joins with the next line (one space between).
/// A `#` ends the line.
/// Recipe lines (tab-prefixed) are joined with continuations, preserving raw text.
/// Returns lines with their first physical line number.
fn join_continuations(lines: List[str]) -> List[Line] {
    var result = List[Line]()
    var current = ""
    var current_line = 0
    var in_continuation = false
    var in_recipe = false
    var i = 0
    while i < lines.len {
        let line = lines[i]
        // While in a recipe continuation, accept the line regardless of its first character.
        // A recipe continuation may be indented with spaces, not just tabs.
        if in_recipe && in_continuation {
            // Append with newline — the raw text is stored for the shell.
            // Drop exactly one leading tab from the continued physical line
            // (gmake strips the tab that follows each backslash-newline in a recipe).
            let cont = if line.starts_with("\t") { line[1..] } else { line }
            current = current + "\n" + cont
            // Check for trailing backslash
            if current.ends_with("\\") {
                in_continuation = true
            } else {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
                in_recipe = false
            }
            i += 1
            continue
        }
        // Check if this is a recipe line (starts with tab)
        if line.starts_with("\t") {
            // If we were building a non-recipe line, push it.
            // This guard must NOT fire while in_recipe: a recipe line is still being built.
            if !in_recipe && current.len > 0 {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
            }
            if in_recipe && in_continuation {
                // This line continues the previous recipe line; append with newline.
                // Drop exactly one leading tab from the continued physical line.
                let cont = if line.starts_with("\t") { line[1..] } else { line }
                current = current + "\n" + cont
            } else {
                // New recipe line
                if current.len > 0 {
                    (mut result).push(Line { text: current, line: current_line })
                }
                current = line
                current_line = i + 1
                in_recipe = true
            }
            // Check for trailing backslash
            if current.ends_with("\\") {
                in_continuation = true
            } else {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_continuation = false
                in_recipe = false
            }
            i += 1
            continue
        }
        // This is a non-recipe line
        if in_recipe {
            // End of recipe block
            if current.len > 0 {
                (mut result).push(Line { text: current, line: current_line })
                current = ""
                in_recipe = false
                in_continuation = false
            }
        }
        if in_continuation {
            // Append to the current line with a space, trimming leading whitespace
            // from the continuation line (make joins with one space and discards
            // the indentation of the continuation line)
            current = current + " " + line.trim_start()
        } else {
            current = line
            current_line = i + 1
        }
        // Check for trailing backslash
        if current.ends_with("\\") {
            // Strip the trailing backslash and any trailing whitespace before it
            current = current[0..current.len - 1].trim_end()
            in_continuation = true
            i += 1
        } else {
            // Strip comments from non-recipe lines
            let stripped = strip_comment(current)
            (mut result).push(Line { text: stripped, line: current_line })
            current = ""
            in_continuation = false
            i += 1
        }
    }
    // If the file ends with a continuation, push what we have
    if current.len > 0 {
        if in_recipe {
            (mut result).push(Line { text: current, line: current_line })
        } else {
            let stripped = strip_comment(current)
            (mut result).push(Line { text: stripped, line: current_line })
        }
    }
    return result
}

/// Strip a `#` comment from a line (not inside a recipe).
fn strip_comment(line: str) -> str {
    let idx = line.find("#") else {
        return line
    }
    if idx == 0 {
        return ""
    }
    return line[0..idx]
}

/// Check if a line is a refusal (pattern rule, include, ifeq, etc.).
/// Returns the refusal kind, or empty string if it's allowed.
fn check_refusal(line: str) -> str {
    // Pattern rules: contain % in the target
    if line.contains("%") {
        return "pattern rules are not supported"
    }
    // .SUFFIXES
    if line.starts_with(".SUFFIXES") {
        return ".SUFFIXES is not supported"
    }
    // Order-only prerequisites: |
    if line.contains("|") {
        return "order-only prerequisites are not supported"
    }
    // Double-colon rules: ::
    if line.contains("::") {
        return "double-colon rules are not supported"
    }
    // Functions: $(wildcard ...), $(patsubst ...), $(shell ...)
    if line.contains("$(wildcard") || line.contains("$(patsubst") || line.contains("$(shell") {
        return "functions are not supported"
    }
    return ""
}

/// Parse an assignment line. Returns the assignment, or empty if it's not an assignment.
fn parse_assignment(line: str, line_num: int) -> Assignment ! {none} {
    // Check for :=, =, ?=, +=
    // The operator is the first occurrence of :=, ?=, or +=, or a bare = not preceded by : or ?
    var op = ""
    var op_pos = -1

    // Check for := first
    let colon_eq = line.find(":=") else 0
    if colon_eq > 0 {
        op = ":="
        op_pos = colon_eq
    } else {
        // Check for ?=
        let qmark_eq = line.find("?=") else 0
        if qmark_eq > 0 {
            op = "?="
            op_pos = qmark_eq
        } else {
            // Check for +=
            let plus_eq = line.find("+=") else 0
            if plus_eq > 0 {
                op = "+="
                op_pos = plus_eq
            } else {
                // Check for bare =
                let eq = line.find("=") else 0
                if eq > 0 {
                    // Make sure it's not part of :=, ?=, or +=
                    op = "="
                    op_pos = eq
                } else {
                    return none
                }
            }
        }
    }

    // The name is everything before the operator, trimmed
    let name = line[0..op_pos].trim()
    if name.len == 0 {
        return none
    }

    // The value is everything after the operator, trimmed
    let value = line[op_pos + op.len..].trim()

    return Assignment {
        name: name,
        op: op,
        value: value,
        line: line_num,
    }
}

/// Parse a rule line. Returns the rule, or empty if it's not a rule.
fn parse_rule(line: str, line_num: int) -> Rule ! {none} {
    // A rule has a : that is not part of :=
    let colon_pos = line.find(":") else 0
    if colon_pos <= 0 {
        return none
    }

    // Check if this is := (assignment, not a rule)
    if colon_pos + 1 < line.len && line[colon_pos + 1..colon_pos + 2] == "=" {
        return none
    }

    // Split on the first :
    let targets_str = line[0..colon_pos].trim()
    let prereqs_str = line[colon_pos + 1..].trim()

    // Parse targets (space-separated)
    let targets = targets_str.words()
    if targets.len == 0 {
        return none
    }

    // Parse prerequisites (space-separated)
    var prereqs = List[str]()
    if prereqs_str.len > 0 {
        prereqs = prereqs_str.words()
    }

    return Rule {
        targets: targets,
        prereqs: prereqs,
        recipe: List[str](),
        first_recipe_line: 0,
        line: line_num,
    }
}

/// Parse a .PHONY line. Returns the phony directive, or empty if it's not .PHONY.
fn parse_phony(line: str, line_num: int) -> Phony ! {none} {
    if !line.starts_with(".PHONY") {
        return none
    }
    let colon_pos = line.find(":") else 0
    if colon_pos <= 0 {
        return none
    }
    let names_str = line[colon_pos + 1..].trim()
    if names_str.len == 0 {
        return none
    }
    let names = names_str.words()
    return Phony {
        names: names,
        line: line_num,
    }
}

/// Parse an include line. Returns the include directive, or empty if it's not an include.
fn parse_include(line: str, line_num: int) -> Include ! {none} {
    // Check for -include or sinclude (both are optional)
    let optional = line.starts_with("-include ") || line.starts_with("sinclude ")
    let names_str = if optional {
        // Strip the -include or sinclude prefix
        if line.starts_with("-include ") {
            line[9..]
        } else {
            line[9..]
        }
    } else if line.starts_with("include ") {
        line[8..]
    } else {
        return none
    }
    if names_str.len == 0 {
        return none
    }
    let names = names_str.words()
    return Include {
        names: names,
        optional: optional,
        line: line_num,
    }
}

/// Parse a define line. Returns the define directive, or empty if it's not a define.
fn parse_define(line: str, line_num: int) -> Define ! {none} {
    // Check for define NAME, define NAME =, define NAME :=, define NAME +=, define NAME ?=
    if !line.starts_with("define ") {
        return none
    }
    let rest = line[7..].trim()
    if rest.len == 0 {
        return none
    }
    // Check for operator
    let op = if rest.contains(":=") {
        ":="
    } else if rest.contains("+=") {
        "+="
    } else if rest.contains("?=") {
        "?="
    } else if rest.contains("=") {
        "="
    } else {
        "="
    }
    // Extract the name
    let name = if op == "=" || op == ":=" || op == "+=" || op == "?=" {
        let eq_pos = if op == ":=" {
            rest.find(":=") else 0
        } else if op == "+=" {
            rest.find("+=") else 0
        } else if op == "?=" {
            rest.find("?=") else 0
        } else {
            rest.find("=") else 0
        }
        if eq_pos <= 0 {
            rest
        } else {
            rest[0..eq_pos].trim()
        }
    } else {
        rest
    }
    if name.len == 0 {
        return none
    }
    return Define {
        name: name,
        op: op,
        value: "",
        line: line_num,
    }
}

/// Parse a conditional directive. Returns the kind, or empty if it's not a conditional.
fn parse_conditional(line: str) -> str {
    if line == "else" {
        return "else"
    }
    if line == "endif" {
        return "endif"
    }
    if line.starts_with("ifeq") {
        return "ifeq"
    }
    if line.starts_with("ifneq") {
        return "ifneq"
    }
    if line.starts_with("ifdef") {
        return "ifdef"
    }
    if line.starts_with("ifndef") {
        return "ifndef"
    }
    return ""
}

/// Evaluate a conditional expression.
/// `ifeq (a,b)` or `ifeq "a" "b"` or `ifeq 'a' 'b'`
/// Returns true if the condition is true.
fn eval_conditional(v: Vars, line: str, kind: str, line_num: int) -> bool ! {
    parse,
    Parse(ParseErr),
} {
    if kind == "ifdef" || kind == "ifndef" {
        // Extract the variable name
        let name = if kind == "ifdef" {
            line[5..].trim()
        } else {
            line[7..].trim()
        }
        // Expand the name
        let expanded = expand(v, name, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
        }
        // Check if the variable has a non-empty value
        let val = var_value(v, expanded)
        let is_set = val.len > 0
        if kind == "ifndef" {
            return !is_set
        }
        return is_set
    }
    // ifeq or ifneq
    // Parse the arguments: (a,b) or "a" "b" or 'a' 'b'
    let rest = if kind == "ifeq" {
        line[4..].trim()
    } else {
        line[6..].trim()
    }
    // Check for (a,b) syntax
    if rest.starts_with("(") {
        let close = rest.rfind(")") else 0
        if close <= 0 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let inner = rest[1..close]
        // Split on the first comma
        let comma = inner.find(",") else 0
        if comma <= 0 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let left = inner[0..comma].trim()
        let right = inner[comma + 1..].trim()
        // Expand both sides
        let left_expanded = expand(v, left, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
        }
        let right_expanded = expand(v, right, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
        }
        // Compare after stripping whitespace
        let left_trimmed = left_expanded.trim()
        let right_trimmed = right_expanded.trim()
        if kind == "ifneq" {
            return left_trimmed != right_trimmed
        }
        return left_trimmed == right_trimmed
    }
    // Check for "a" "b" or 'a' 'b' syntax
    if rest.starts_with("\"") || rest.starts_with("'") {
        let quote = rest[0..1]
        // Find the closing quote for the first argument
        let close1 = rest.find(quote) else 0
        if close1 <= 1 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let left = rest[1..close1]
        // Skip whitespace and find the second quote
        let rest2 = rest[close1 + 1..].trim()
        if !rest2.starts_with(quote) {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let close2 = rest2.find(quote) else 0
        if close2 <= 1 {
            return Parse(ParseErr {
                file: "",
                line: line_num,
                message: "invalid syntax in conditional",
            })
        }
        let right = rest2[1..close2]
        // Expand both sides
        let left_expanded = expand(v, left, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
        }
        let right_expanded = expand(v, right, line_num) else |e| match e {
            Unterminated(l) => return parse,
            Cycle(l, n) => return parse,
        }
        // Compare after stripping whitespace
        let left_trimmed = left_expanded.trim()
        let right_trimmed = right_expanded.trim()
        if kind == "ifneq" {
            return left_trimmed != right_trimmed
        }
        return left_trimmed == right_trimmed
    }
    // Invalid syntax
    return Parse(ParseErr {
        file: "",
        line: line_num,
        message: "invalid syntax in conditional",
    })
}

/// Parse a Makefile from text. Returns the database.
/// `file` is the filename for error messages.
/// `include_dirs` is the list of -I directories to search for included files.
fn parse_makefile(
    text: str,
    file: str,
    mut v: Vars,
    cli_names: Map[str, int],
    include_dirs: List[str],
    env_wins: bool,
) -> Database ! {parse, Parse(ParseErr), io} {
    var db = Database {
        assignments: List[Assignment](),
        rules: List[Rule](),
        phonies: List[Phony](),
        includes: List[Include](),
        defines: List[Define](),
        refusals: List[Refusal](),
    }

    // Split into lines
    let lines = text.lines()

    // Join continuations
    let logical_lines = join_continuations(lines)

    // Process each logical line
    var line_num = 0
    var has_rule = false
    var current_rule = Rule {
        targets: List[str](),
        prereqs: List[str](),
        recipe: List[str](),
        first_recipe_line: 0,
        line: 0,
    }
    // Conditional stack: each entry tracks whether lines are live
    var cond_stack = List[CondEntry]()
    // Define stack: each entry tracks the define directive and accumulated body
    var define_stack = List[Define]()
    while line_num < logical_lines.len {
        let line = logical_lines[line_num].text
        let line_number = logical_lines[line_num].line

        // Check for recipe lines (start with tab)
        if line.starts_with("\t") {
            // This is a recipe line for the current rule
            if has_rule {
                // Strip only the first tab (the recipe prefix) from the first line
                // The joined line may contain newlines from continuations
                let first_newline = line.find("\n") else {
                    // No newline, strip the first tab
                    let recipe_line = line[1..]
                    (mut current_rule.recipe).push(recipe_line)
                    // Set first_recipe_line on the first recipe line
                    if current_rule.first_recipe_line == 0 {
                        current_rule.first_recipe_line = line_number
                    }
                    line_num += 1
                    continue
                }
                // Has a newline: the line is "\tFIRST\nREST"
                // We want "FIRST\nREST" - strip only the first \t from the first line
                // line[1..] gives "FIRST\nREST" which is correct
                let recipe_line = line[1..]
                (mut current_rule.recipe).push(recipe_line)
                // Set first_recipe_line on the first recipe line
                if current_rule.first_recipe_line == 0 {
                    current_rule.first_recipe_line = line_number
                }
            }
            line_num += 1
            continue
        }

        // For non-recipe lines, strip comments and trim
        let stripped = strip_comment(line).trim()

        // Skip empty lines
        if stripped.len == 0 {
            line_num += 1
            continue
        }

        // If we were in a rule, save it
        if has_rule {
            (mut db.rules).push(current_rule)
            has_rule = false
        }

        // Check for refusals
        let refusal = check_refusal(stripped)
        if refusal.len > 0 {
            (mut db.refusals).push(Refusal {
                kind: refusal,
                line: line_number,
            })
            line_num += 1
            continue
        }

        // Check for conditional directives
        let cond_kind = parse_conditional(stripped)
        if cond_kind.len > 0 {
            // Handle conditional directives
            if cond_kind == "else" {
                // Check if we're in a conditional
                if cond_stack.len == 0 {
                    // Extraneous else
                    eprint("{file}:{line_number}: *** extraneous 'else'.  Stop.")
                    return parse
                }
                // Check if else has already been seen
                let top_idx = cond_stack.len - 1
                if cond_stack[top_idx].else_seen {
                    // Two else in one conditional
                    eprint("{file}:{line_number}: *** only one 'else' per conditional.  Stop.")
                    return parse
                }
                // Flip the live flag
                var entry = cond_stack[top_idx]
                entry.live = !entry.live
                entry.else_seen = true
                cond_stack[top_idx] = entry
                line_num += 1
                continue
            }
            if cond_kind == "endif" {
                // Check if we're in a conditional
                if cond_stack.len == 0 {
                    // Extraneous endif (treat as missing endif error)
                    eprint("{file}:{line_number}: *** missing 'endif'.  Stop.")
                    return parse
                }
                // Pop the stack
                var tmp = List[CondEntry]()
                var i = 0
                while i < cond_stack.len - 1 {
                    (mut tmp).push(cond_stack[i])
                    i += 1
                }
                cond_stack = tmp
                line_num += 1
                continue
            }
            // ifeq, ifneq, ifdef, ifndef
            // Evaluate the conditional
            let result = eval_conditional(v, stripped, cond_kind, line_number) else |e| match e {
                parse => {
                    eprint("{file}:{line_number}: *** invalid syntax in conditional.  Stop.")
                    return parse
                },
                Parse(p) => {
                    eprint("{file}:{line_number}: *** {p.message}.  Stop.")
                    return parse
                },
            }
            // Push onto the stack
            (mut cond_stack).push(CondEntry {
                line: line_number,
                live: result,
                else_seen: false,
            })
            line_num += 1
            continue
        }

        // Check for define/endef directives
        if stripped == "endef" {
            // Check if we're in a define
            if define_stack.len == 0 {
                // Extra endef: treat as missing separator
                eprint("{file}:{line_number}: *** missing separator.  Stop.")
                return parse
            }
            // Pop the define stack by keeping all but the last element
            var tmp = List[Define]()
            var i = 0
            while i < define_stack.len - 1 {
                (mut tmp).push(define_stack[i])
                i += 1
            }
            // Get the last element (the one being popped)
            var top = define_stack[define_stack.len - 1]
            define_stack = tmp
            // Apply the define to the variable table
            if top.op == ":=" {
                // Immediate expansion
                let expanded = expand(v, top.value, top.line) else |e| match e {
                    Unterminated(l) => {
                        eprint("{file}:{l}: *** unterminated variable reference.  Stop.")
                        return parse
                    },
                    Cycle(l, n) => {
                        eprint(
                            "{file}:{l}: *** Recursive variable '{n}' references itself (eventually).  Stop.",
                        )
                        return parse
                    },
                }
                set_var(mut v, top.name, expanded, top.op, top.line)
            } else {
                // Recursive expansion (store the value as-is)
                set_var(mut v, top.name, top.value, top.op, top.line)
            }
            // Store the define
            (mut db.defines).push(top)
            // Also add to assignments for -p output
            (mut db.assignments).push(Assignment {
                name: top.name,
                op: top.op,
                value: top.value,
                line: top.line,
            })
            line_num += 1
            continue
        }
        // Check for define NAME (also override define)
        if stripped.starts_with("define ") || stripped.starts_with("override define ") {
            // Strip the override prefix if present
            let def_line = if stripped.starts_with("override define ") {
                stripped[9..]
            } else {
                stripped
            }
            // Parse the define directive
            let define = parse_define(def_line, line_number) else |e| match e {
                none => {
                    // Not a define, fall through to normal parsing
                    line_num += 1
                    continue
                },
            }
            // Push onto the define stack
            (mut define_stack).push(define)
            line_num += 1
            continue
        }
        // Check for undefine NAME (also override undefine)
        if stripped.starts_with("undefine ") || stripped.starts_with("override undefine ") {
            // Strip the override prefix if present
            let undef_line = if stripped.starts_with("override undefine ") {
                stripped[13..]
            } else {
                stripped[9..]
            }
            // Extract the name (just the first word)
            let name = undef_line.words()[0]
            // Remove the variable
            undefine_var(mut v, name)
            line_num += 1
            continue
        }
        // Check for export NAME, export NAME = v, or bare export
        if stripped.starts_with("export ") || stripped == "export" {
            if stripped == "export" {
                // Bare export: export all variables
                v.export_all = true
                line_num += 1
                continue
            }
            // export NAME or export NAME = v
            let rest = stripped[7..].trim()
            if rest.len == 0 {
                line_num += 1
                continue
            }
            // Check for operator
            let op = if rest.contains(":=") {
                ":="
            } else if rest.contains("+=") {
                "+="
            } else if rest.contains("?=") {
                "?="
            } else if rest.contains("=") {
                "="
            } else {
                ""
            }
            // Extract the name
            let name = if op.len > 0 {
                let eq_pos = if op == ":=" {
                    rest.find(":=") else 0
                } else if op == "+=" {
                    rest.find("+=") else 0
                } else if op == "?=" {
                    rest.find("?=") else 0
                } else {
                    rest.find("=") else 0
                }
                if eq_pos <= 0 {
                    rest
                } else {
                    rest[0..eq_pos].trim()
                }
            } else {
                rest
            }
            if name.len == 0 {
                line_num += 1
                continue
            }
            // Set the exported flag
            set_var_exported(mut v, name, true)
            // If there's an operator, also set the value
            if op.len > 0 {
                let value = if op == ":=" {
                    let p = (rest.find(":=") else 0) + 2
                    rest[p..].trim()
                } else if op == "+=" {
                    let p = (rest.find("+=") else 0) + 2
                    rest[p..].trim()
                } else if op == "?=" {
                    let p = (rest.find("?=") else 0) + 2
                    rest[p..].trim()
                } else {
                    let p = (rest.find("=") else 0) + 1
                    rest[p..].trim()
                }
                set_var(mut v, name, value, op, line_number)
                // Re-set the exported flag (set_var may have created a new Var)
                set_var_exported(mut v, name, true)
            }
            line_num += 1
            continue
        }
        // Check for unexport NAME or bare unexport
        if stripped.starts_with("unexport ") || stripped == "unexport" {
            if stripped == "unexport" {
                // Bare unexport: clear export_all and unexport all variables
                v.export_all = false
                // Unexport all variables in the table
                for name in map.keys(v.table) {
                    (mut v.unexported).push(name)
                }
                line_num += 1
                continue
            }
            // unexport NAME
            let name = stripped[9..].trim()
            if name.len > 0 {
                // Add to the unexported list
                (mut v.unexported).push(name)
                // Clear the exported flag
                set_var_exported(mut v, name, false)
            }
            line_num += 1
            continue
        }
        // Check for override NAME = v (also handled by set_var_skip)
        if stripped.starts_with("override ") {
            // Strip the override prefix
            let rest = stripped[9..].trim()
            // Parse as an assignment
            let assignment = parse_assignment(rest, line_number) else |e| match e {
                none => {
                    // Not an assignment, fall through to normal parsing
                    line_num += 1
                    continue
                },
            }
            // Apply the assignment, skipping CLI overrides
            set_var(mut v, assignment.name, assignment.value, assignment.op, assignment.line)
            // Store the assignment for -p output
            (mut db.assignments).push(assignment)
            line_num += 1
            continue
        }

        // Check if lines are live (based on the conditional stack)
        var is_live = true
        if cond_stack.len > 0 {
            // Check the top of the stack
            let top_idx = cond_stack.len - 1
            is_live = cond_stack[top_idx].live
        }
        // If not live, skip this line
        if !is_live {
            line_num += 1
            continue
        }

        // If we're inside a define block, accumulate the line as body text
        if define_stack.len > 0 {
            // Append the line to the current define's body
            let top_idx = define_stack.len - 1
            var top = define_stack[top_idx]
            if top.value.len > 0 {
                top.value = top.value + "\n" + line
            } else {
                top.value = line
            }
            define_stack[top_idx] = top
            line_num += 1
            continue
        }

        // Try to parse as assignment
        let assignment = parse_assignment(stripped, line_number) else |e| match e {
            none => {
                // Not an assignment, try as include first (before .PHONY and rule)
                let include = parse_include(stripped, line_number) else |e4| match e4 {
                    none => {
                        // Not an include, try as .PHONY first (before rule, since .PHONY: looks like a rule)
                        let phony = parse_phony(stripped, line_number) else |e3| match e3 {
                            none => {
                                // Not .PHONY, check for .EXPORT_ALL_VARIABLES
                                if stripped == ".EXPORT_ALL_VARIABLES:" ||
                                    stripped == ".EXPORT_ALL_VARIABLES" {
                                    v.export_all = true
                                    line_num += 1
                                    continue
                                }
                                // Not .EXPORT_ALL_VARIABLES, try as rule
                                let rule = parse_rule(stripped, line_number) else |e2| match e2 {
                                    none => {
                                        // Unknown line: not blank, not a comment, not a recipe line,
                                        // not an assignment, not a rule, not a refusal.
                                        // This is a "missing separator" error.
                                        return Parse(ParseErr {
                                            file: file,
                                            line: line_number,
                                            message: "missing separator",
                                        })
                                    },
                                }
                                current_rule = rule
                                has_rule = true
                                line_num += 1
                                continue
                            },
                        }
                        (mut db.phonies).push(phony)
                        line_num += 1
                        continue
                    },
                }
                // Store the include for -p output
                (mut db.includes).push(include)
                // Process the include directive
                for name in include.names {
                    // Expand the name
                    let expanded = expand(v, name, include.line) else |e| match e {
                        Unterminated(l) => {
                            eprint("{file}:{l}: *** unterminated variable reference.  Stop.")
                            return parse
                        },
                        Cycle(l, n) => {
                            eprint(
                                "{file}:{l}: *** Recursive variable '{n}' references itself (eventually).  Stop.",
                            )
                            return parse
                        },
                    }
                    // Glob the expanded name
                    let globs = glob(expanded)
                    if globs.len == 0 {
                        // No matches
                        if !include.optional {
                            // Hard include: error
                            eprint("{file}:{include.line}: {expanded}: No such file or directory")
                            eprint("mk: *** No rule to make target '{expanded}'.  Stop.")
                            return parse
                        }
                        // Soft include: silent
                        continue
                    }
                    // Read and parse each file
                    for g in globs {
                        let sub_db = parse_makefile_file(
                            g,
                            mut v,
                            cli_names,
                            include_dirs,
                            env_wins,
                        ) else |e| match e {
                            parse => {
                                if !include.optional {
                                    eprint("{file}:{include.line}: {g}: No such file or directory")
                                    eprint("mk: *** No rule to make target '{g}'.  Stop.")
                                    return parse
                                }
                                // Soft include: silent
                                continue
                            },
                            Parse(p) => {
                                if !include.optional {
                                    eprint("{p.file}:{p.line}: *** {p.message}.  Stop.")
                                    return parse
                                }
                                // Soft include: silent
                                continue
                            },
                            io => {
                                if !include.optional {
                                    eprint("{file}:{include.line}: {g}: No such file or directory")
                                    eprint("mk: *** No rule to make target '{g}'.  Stop.")
                                    return parse
                                }
                                // Soft include: silent
                                continue
                            },
                        }
                        // Merge the sub-database into the main database
                        for a in sub_db.assignments {
                            (mut db.assignments).push(a)
                            if !map.has(cli_names, a.name) {
                                set_var(mut v, a.name, a.value, a.op, a.line)
                            }
                        }
                        for r in sub_db.rules {
                            (mut db.rules).push(r)
                        }
                        for p in sub_db.phonies {
                            (mut db.phonies).push(p)
                        }
                        for i in sub_db.includes {
                            (mut db.includes).push(i)
                        }
                        for r in sub_db.refusals {
                            (mut db.refusals).push(r)
                        }
                        // Update MAKEFILE_LIST
                        let current_list = var_value(v, "MAKEFILE_LIST")
                        if current_list.len > 0 {
                            set_var(mut v, "MAKEFILE_LIST", current_list + " " + g, "=", 0)
                        } else {
                            set_var(mut v, "MAKEFILE_LIST", g, "=", 0)
                        }
                    }
                }
                line_num += 1
                continue
            },
        }
        // Store the assignment for -p output
        (mut db.assignments).push(assignment)
        // Apply the assignment to the variable table, respecting CLI overrides
        if !map.has(cli_names, assignment.name) {
            // If env_wins is true, check if the variable is in the environment
            if env_wins {
                let env_val = env.get(assignment.name) else ""
                if env_val.len > 0 {
                    // Environment wins: use the environment value
                    set_var(mut v, assignment.name, env_val, ":=", assignment.line)
                    line_num += 1
                    continue
                }
            }
            set_var(mut v, assignment.name, assignment.value, assignment.op, assignment.line)
        }
        line_num += 1
    }

    // Save the last rule if any
    if has_rule {
        (mut db.rules).push(current_rule)
    }

    // Check for open conditionals (missing endif)
    if cond_stack.len > 0 {
        // The error line is the last line + 1
        let last_line = logical_lines[logical_lines.len - 1].line
        eprint("{file}:{last_line + 1}: *** missing 'endif'.  Stop.")
        return parse
    }

    // Check for open defines (missing endef)
    if define_stack.len > 0 {
        // The error line is the line of the define
        let define_line = define_stack[0].line
        eprint("{file}:{define_line}: *** missing 'endef', unterminated 'define'.  Stop.")
        return parse
    }

    return db
}

/// Read a Makefile from a file and parse it.
/// `include_dirs` is the list of -I directories to search for included files.
fn parse_makefile_file(
    path: str,
    mut v: Vars,
    cli_names: Map[str, int],
    include_dirs: List[str],
    env_wins: bool,
) -> Database ! {parse, Parse(ParseErr), io} {
    let text = fs.read_text(path) else |e| match e {
        io => return io,
        denied => return io,
        not_found => return io,
        utf8 => return parse,
    }
    parse_makefile(text, path, mut v, cli_names, include_dirs, env_wins)
}

/// Print the database in a stable format for -p.
/// Variables are sorted by name, with their expanded values.
/// Rules are in file order, with prerequisites and recipes.
/// .PHONY directives are printed after rules.
///
/// Format:
///   # Variables
///   NAME = EXPANDED_VALUE
///   ...
///   # Rules
///   TARGETS: PREREQS
///   \tRECIPE_LINE
///   ...
///   .PHONY: NAMES
fn print_database(db: Database, v: Vars, makefile: str) -> !int {
    // Collect unique variable names and sort them
    var names = List[str]()
    for a in db.assignments {
        // Check if the name is already in the list
        var found = false
        for n in names {
            if n == a.name {
                found = true
                break
            }
        }
        if !found {
            (mut names).push(a.name)
        }
    }
    // Simple insertion sort
    var i = 1
    while i < names.len {
        let key = names[i]
        var j = i - 1
        while j >= 0 && names[j] > key {
            names[j + 1] = names[j]
            j -= 1
        }
        names[j + 1] = key
        i += 1
    }
    // Print variables sorted by name with expanded values
    print("# Variables")
    for name in names {
        let val = var_value(v, name)
        let line = var_line_of(v, name)
        let flavour = var_flavour(v, name)
        // := values are already expanded; print them as-is.
        // = values need to be expanded.
        let expanded = if flavour == ":=" {
            val
        } else {
            expand(v, val, line) else |e| match e {
                Unterminated(l) => {
                    eprint("{makefile}:{l}: *** unterminated variable reference.  Stop.")
                    return 2
                },
                Cycle(l, n) => {
                    eprint(
                        "{makefile}:{l}: *** Recursive variable '{n}' references itself (eventually).  Stop.",
                    )
                    return 2
                },
            }
        }
        print("{name} = {expanded}")
    }
    // Print rules with their prerequisites and recipes
    print("# Rules")
    for r in db.rules {
        let targets = str.join(" ", r.targets)
        let prereqs = str.join(" ", r.prereqs)
        if prereqs.len > 0 {
            print("{targets}: {prereqs}")
        } else {
            print("{targets}:")
        }
        for recipe_line in r.recipe {
            print("\t{recipe_line}")
        }
    }
    // Print .PHONY directives
    for p in db.phonies {
        let names = str.join(" ", p.names)
        print(".PHONY: {names}")
    }
    return 0
}
